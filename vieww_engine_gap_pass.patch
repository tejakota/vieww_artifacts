+struct Writer {
+    out: Vec<u8>,
+    acc: u32,
+    n: u32,
+}
+
+impl Writer {
+    fn put(&mut self, code: u16, len: u8) {
+        for i in (0..len).rev() {
+            self.acc = (self.acc << 1) | u32::from((code >> i) & 1);
+            self.n += 1;
+            if self.n == 8 {
+                #[allow(clippy::cast_possible_truncation)]
+                let b = self.acc as u8;
+                self.out.push(b);
+                if b == 0xFF {
+                    self.out.push(0);
+                }
+                self.acc = 0;
+                self.n = 0;
+            }
+        }
+    }
+    fn flush(&mut self) {
+        while self.n != 0 {
+            self.put(1, 1);
+        }
+    }
+}
