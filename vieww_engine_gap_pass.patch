+        let l = streamline(&f, (3.0, 0.0), (-5.0, -5.0, 5.0, 5.0), 0.05, 300, &[], 0.0);
+        for p in &l {
+            assert!(((p.0 * p.0 + p.1 * p.1).sqrt() - 3.0).abs() < 1e-3);
+        }
+    }
+
+    #[test]
+    fn streamlines_stop_at_a_sink_and_at_the_border() {
