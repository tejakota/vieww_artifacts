+                    walk(&p, acc);
+                } else if p.extension().is_some_and(|e| e == "rs") {
+                    if let Ok(src) = std::fs::read_to_string(&p) {
+                        acc.0 += src.lines().count() as u64;
+                        acc.1 += src.lines().filter(|l| l.trim_start().starts_with("#[test]")).count() as u64;
+                    }
+                }
+            }
+        }
