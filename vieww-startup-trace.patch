 vieww_base/crates/vieww-hal/src/vulkan/mod.rs | 16 +++++++++++++++-
 .../crates/vieww-platform-winit/src/app.rs    | 19 +++++++++++++++++++
 .../crates/vieww-platform-winit/src/native.rs |  9 +++++++++
 3 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/vieww_base/crates/vieww-hal/src/vulkan/mod.rs b/vieww_base/crates/vieww-hal/src/vulkan/mod.rs
index e1fd420..83aba72 100644
--- a/vieww_base/crates/vieww-hal/src/vulkan/mod.rs
+++ b/vieww_base/crates/vieww-hal/src/vulkan/mod.rs
@@ -267,13 +267,27 @@ impl VulkanDevice {
             .ok()
             .map(|s| s.to_lowercase());
 
+        // `VIEWW_TRACE_FRAMES` — the platform layer's startup/frame trace —
+        // also names each device as it is asked whether it can serve: on a
+        // hybrid laptop, a GPU that is powered down can take its time
+        // answering a surface query, and a stalled startup should say which
+        // device it was waiting on. Read per call; this runs once per window.
+        let trace = std::env::var_os("VIEWW_TRACE_FRAMES").is_some();
         let mut best: Option<(u32, vk::PhysicalDevice, u32)> = None;
         for pd in physical_devices {
-            let Some(family) = accept(pd) else { continue };
             let props = unsafe { instance.get_physical_device_properties(pd) };
             let name = unsafe { CStr::from_ptr(props.device_name.as_ptr()) }
                 .to_string_lossy()
                 .to_lowercase();
+            if trace {
+                eprintln!("vulkan: asking {name} ({:?})", props.device_type);
+            }
+            let Some(family) = accept(pd) else {
+                if trace {
+                    eprintln!("vulkan: {name} cannot serve this request");
+                }
+                continue;
+            };
             if let Some(wanted) = wanted.as_deref() {
                 if name.contains(wanted) {
                     return Some((pd, family));
diff --git a/vieww_base/crates/vieww-platform-winit/src/app.rs b/vieww_base/crates/vieww-platform-winit/src/app.rs
index e7772a6..255f8ed 100644
--- a/vieww_base/crates/vieww-platform-winit/src/app.rs
+++ b/vieww_base/crates/vieww-platform-winit/src/app.rs
@@ -1928,6 +1928,12 @@ impl<F: FnOnce(&mut FrameDriver)> Runner<F> {
             // and panics if it does not. So the window is born invisible and
             // revealed by the caller, once the adapter is attached.
             .with_visible(false);
+        // **Startup is traced step by step.** A gate run on a GNOME/Wayland
+        // hybrid-GPU laptop hung here — `tests/wait_loop.rs`' idle scenario
+        // printed no window event at all in 20 s while its waker thread fired
+        // on time — and an untraced startup could not say whether the window,
+        // the GPU selection or the swapchain was the step that never returned.
+        trace_line(self.shared.now(), format_args!("startup: creating window"));
         let window = Arc::new(
             event_loop
                 .create_window(attributes)
@@ -1960,8 +1966,21 @@ impl<F: FnOnce(&mut FrameDriver)> Runner<F> {
         // `docs/RENDERER-MIGRATION.md`). One Vulkan device per window is
         // correct, just not `docs/AIMS.md` §B's *Cheaper* win the old vello
         // path had; a follow-up, not a defect.
+        trace_line(
+            self.shared.now(),
+            format_args!("startup: window created ({width}x{height}); opening the GPU"),
+        );
+        let opening = Instant::now();
         let (renderer, surface) = NativeRenderer::for_window(window.as_ref(), width, height)
             .map_err(PlatformError::Gpu)?;
+        trace_line(
+            self.shared.now(),
+            format_args!(
+                "startup: GPU ready in {:?}: {}",
+                opening.elapsed(),
+                renderer.adapter_name()
+            ),
+        );
 
         Ok(NewSurface {
             window,
diff --git a/vieww_base/crates/vieww-platform-winit/src/native.rs b/vieww_base/crates/vieww-platform-winit/src/native.rs
index 3a4a03d..caefe56 100644
--- a/vieww_base/crates/vieww-platform-winit/src/native.rs
+++ b/vieww_base/crates/vieww-platform-winit/src/native.rs
@@ -277,6 +277,15 @@ impl NativeRenderer {
     /// # Panics
     ///
     /// If `width` or `height` is zero.
+    /// The name of the GPU this renderer presents through, as the driver
+    /// reports it — for the startup trace and for logs, where "which of a
+    /// hybrid laptop's GPUs did it pick" is the first question.
+    #[must_use]
+    pub fn adapter_name(&self) -> String {
+        use vieww_hal::Device as _;
+        self.device.info().name
+    }
+
     pub fn for_window(
         window: &(impl raw_window_handle::HasWindowHandle + raw_window_handle::HasDisplayHandle),
         width: u32,
