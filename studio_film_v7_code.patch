-                buf[row + x] = row_buf[xs];
-            }
-        }
-    }
-
-    // The tear — one bright scanline near the split's edge.
-    let tear_y = (rh as f32 * (0.2 + 0.6 * rng.f01())) as usize;
-    if tear_y < rh {
