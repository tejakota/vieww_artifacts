+            let g = (10f64.powf(self.gain_db / 20.0) * if self.invert >= 0.5 { -1.0 } else { 1.0 })
+                as f32;
+            for ch in 0..b.output_channels() {
+                let n = b.frames();
+                let mut tmp = [0.0f32; 64];
+                let mut done = 0;
+                while done < n {
