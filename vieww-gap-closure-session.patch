+        ];
+        let file = build(&sine16(440.0, 22_050.0, 4_000), 22_050, 69, &inst, &[]);
+        let mut sf = SoundFont::parse(&file).unwrap();
+        let z = sf.instrument(0, 0).unwrap().unwrap().zones.remove(0);
+        assert!((z.amp.attack - 1.0).abs() < 0.01, "{}", z.amp.attack);
