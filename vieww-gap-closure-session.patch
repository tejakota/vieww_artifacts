+        let mut c = clip();
+        c.looping = true;
+        let ev = c.events(0.0, 12.0, 100.0);
+        assert_eq!(ons(&ev).len(), 9);
+        assert!((ons(&ev)[3].0 - 104.0).abs() < 1e-9);
+    }
+
