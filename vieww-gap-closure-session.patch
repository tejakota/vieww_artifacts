+/// Any [`Stereo`] effect.
+pub struct StereoNode<S: Stereo + Send>(pub S);
+
+impl<S: Stereo + Send> std::fmt::Debug for StereoNode<S> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("StereoNode")
