+/// A parameter as the plugin described it.
+#[derive(Debug, Clone, PartialEq)]
+pub struct HostParam {
+    /// Id.
+    pub id: u32,
+    /// Name.
+    pub name: String,
+    /// Minimum.
+    pub min: f64,
+    /// Maximum.
+    pub max: f64,
+    /// Default.
+    pub default: f64,
+    /// Stepped.
+    pub stepped: bool,
+    /// An enumeration.
+    pub is_enum: bool,
+    /// Automatable.
+    pub automatable: bool,
+}
