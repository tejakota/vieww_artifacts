+    Inherited::new(
+        view_metrics,
+        Inherited::new(
+            accessibility,
+            Theme::new(ThemeData::adaptive(platform.target(), dark))
+                .child(Overlay::new().child(GuestRoot { child: guest })),
+        ),
+    )
+    .into()
+}
