+
+impl<S: Stereo + Send> Node for StereoNode<S> {
+    fn inputs(&self) -> usize {
+        2
+    }
+    fn outputs(&self) -> usize {
+        2
+    }
+    fn process(&mut self, input: &[[f32; BLOCK]], out: &mut [[f32; BLOCK]], _: &Block) {
+        for f in 0..BLOCK {
+            let (l, r) = self.0.process_stereo(input[0][f], input[1][f]);
+            out[0][f] = l;
+            out[1][f] = r;
+        }
+    }
+}
