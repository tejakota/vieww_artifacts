+    pub getParameterData: unsafe extern "system" fn(this: *mut c_void, index: i32) -> *mut c_void,
+    pub addParameterData: unsafe extern "system" fn(
+        this: *mut c_void,
+        id: *const ParamID,
+        index: *mut i32,
