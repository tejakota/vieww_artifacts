+        tail: u32,
+        killed: bool,
+        expr: Expression,
+    }
+
+    impl Voice for Probe {
+        fn note_on(&mut self, pitch: f32, velocity: f32) {
+            self.on = true;
+            self.pitch = pitch;
+            self.vel = velocity;
+            self.tail = 10;
+            self.killed = false;
+        }
+        fn note_off(&mut self) {
+            self.on = false;
+        }
