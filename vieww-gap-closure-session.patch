+//! AAudio: Android's low-latency audio API (Android 8.0, API 26+).
+//!
+//! `libaaudio.so` is loaded at run time (so an APK built for older API
+//! levels still starts, and reports the backend unavailable). A stream is
+//! built for float samples in low-latency performance mode with a data
+//! callback, which AAudio runs on its real-time thread with an
+//! interleaved buffer to fill (or read). An error callback — a device
+//! disconnected, typically — marks the stream ended. Signatures and
+//! constants follow `<aaudio/AAudio.h>`.
+
+use std::ffi::{c_char, c_void, CStr};
+use std::ptr::null_mut;
+use std::sync::atomic::Ordering;
+use std::sync::Arc;
+
+use super::dl::Library;
+use super::{
+    Backend, BackendError, BlockInfo, CaptureFn, Counters, DeviceStream, RenderFn, StreamConfig,
+    StreamImpl,
+};
+
+type Result_ = i32;
+const AAUDIO_OK: Result_ = 0;
+const AAUDIO_DIRECTION_OUTPUT: i32 = 0;
+const AAUDIO_DIRECTION_INPUT: i32 = 1;
+const AAUDIO_FORMAT_PCM_FLOAT: i32 = 2;
+const AAUDIO_SHARING_MODE_SHARED: i32 = 1;
+const AAUDIO_PERFORMANCE_MODE_LOW_LATENCY: i32 = 12;
+const AAUDIO_CALLBACK_RESULT_CONTINUE: i32 = 0;
+
+type DataCb = unsafe extern "C" fn(*mut c_void, *mut c_void, *mut c_void, i32) -> i32;
+type ErrorCb = unsafe extern "C" fn(*mut c_void, *mut c_void, Result_);
+
+struct Api {
+    _lib: Library,
+    create_builder: unsafe extern "C" fn(*mut *mut c_void) -> Result_,
+    set_direction: unsafe extern "C" fn(*mut c_void, i32),
+    set_sample_rate: unsafe extern "C" fn(*mut c_void, i32),
+    set_channel_count: unsafe extern "C" fn(*mut c_void, i32),
+    set_format: unsafe extern "C" fn(*mut c_void, i32),
+    set_sharing_mode: unsafe extern "C" fn(*mut c_void, i32),
+    set_performance_mode: unsafe extern "C" fn(*mut c_void, i32),
+    set_frames_per_data_callback: unsafe extern "C" fn(*mut c_void, i32),
+    set_data_callback: unsafe extern "C" fn(*mut c_void, DataCb, *mut c_void),
+    set_error_callback: unsafe extern "C" fn(*mut c_void, ErrorCb, *mut c_void),
+    open_stream: unsafe extern "C" fn(*mut c_void, *mut *mut c_void) -> Result_,
+    builder_delete: unsafe extern "C" fn(*mut c_void) -> Result_,
+    request_start: unsafe extern "C" fn(*mut c_void) -> Result_,
+    request_stop: unsafe extern "C" fn(*mut c_void) -> Result_,
+    close: unsafe extern "C" fn(*mut c_void) -> Result_,
+    get_sample_rate: unsafe extern "C" fn(*mut c_void) -> i32,
+    get_channel_count: unsafe extern "C" fn(*mut c_void) -> i32,
+    get_frames_per_burst: unsafe extern "C" fn(*mut c_void) -> i32,
+    convert_result_to_text: unsafe extern "C" fn(Result_) -> *const c_char,
+}
+
+impl Api {
+    fn load() -> Result<Self, String> {
+        let lib = Library::open(&["libaaudio.so"])?;
+        // SAFETY: the types are <aaudio/AAudio.h>'s signatures.
+        unsafe {
+            Ok(Self {
+                create_builder: lib.get(c"AAudio_createStreamBuilder")?,
+                set_direction: lib.get(c"AAudioStreamBuilder_setDirection")?,
+                set_sample_rate: lib.get(c"AAudioStreamBuilder_setSampleRate")?,
+                set_channel_count: lib.get(c"AAudioStreamBuilder_setChannelCount")?,
+                set_format: lib.get(c"AAudioStreamBuilder_setFormat")?,
+                set_sharing_mode: lib.get(c"AAudioStreamBuilder_setSharingMode")?,
+                set_performance_mode: lib.get(c"AAudioStreamBuilder_setPerformanceMode")?,
+                set_frames_per_data_callback: lib
+                    .get(c"AAudioStreamBuilder_setFramesPerDataCallback")?,
+                set_data_callback: lib.get(c"AAudioStreamBuilder_setDataCallback")?,
+                set_error_callback: lib.get(c"AAudioStreamBuilder_setErrorCallback")?,
+                open_stream: lib.get(c"AAudioStreamBuilder_openStream")?,
+                builder_delete: lib.get(c"AAudioStreamBuilder_delete")?,
+                request_start: lib.get(c"AAudioStream_requestStart")?,
+                request_stop: lib.get(c"AAudioStream_requestStop")?,
+                close: lib.get(c"AAudioStream_close")?,
+                get_sample_rate: lib.get(c"AAudioStream_getSampleRate")?,
+                get_channel_count: lib.get(c"AAudioStream_getChannelCount")?,
+                get_frames_per_burst: lib.get(c"AAudioStream_getFramesPerBurst")?,
+                convert_result_to_text: lib.get(c"AAudio_convertResultToText")?,
+                _lib: lib,
+            })
+        }
+    }
+
+    fn text(&self, r: Result_) -> String {
+        // SAFETY: AAudio returns a static string.
+        let p = unsafe { (self.convert_result_to_text)(r) };
+        if p.is_null() {
+            format!("AAudio error {r}")
+        } else {
+            // SAFETY: a static NUL-terminated string.
+            unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()
+        }
+    }
+}
+
+enum Callback {
+    Render(RenderFn),
+    Capture(CaptureFn),
+}
+
+struct Shared {
+    callback: Callback,
+    channels: usize,
+    rate: u32,
+    counters: Arc<Counters>,
+    frames_done: u64,
+}
+
+unsafe extern "C" fn on_data(
+    _stream: *mut c_void,
+    user: *mut c_void,
+    data: *mut c_void,
+    frames: i32,
+) -> i32 {
+    // SAFETY: `user` is the boxed `Shared`, alive until the stream closes;
+    // AAudio calls one data callback at a time.
+    let s = unsafe { &mut *user.cast::<Shared>() };
+    let n = usize::try_from(frames.max(0)).unwrap_or(0);
+    let len = n * s.channels;
+    #[expect(clippy::cast_precision_loss, reason = "stream time")]
+    let info = BlockInfo {
+        frames: n,
+        channels: s.channels,
+        rate: s.rate,
+        time: s.frames_done as f64 / f64::from(s.rate),
+    };
+    match &mut s.callback {
+        Callback::Render(r) => {
+            // SAFETY: AAudio hands `frames` interleaved float frames.
+            let out = unsafe { std::slice::from_raw_parts_mut(data.cast::<f32>(), len) };
+            out.fill(0.0);
+            r(out, &info);
+        }
+        Callback::Capture(c) => {
+            // SAFETY: as above.
+            let input = unsafe { std::slice::from_raw_parts(data.cast::<f32>(), len) };
+            c(input, &info);
+        }
+    }
+    s.frames_done += n as u64;
+    s.counters.block(n);
+    AAUDIO_CALLBACK_RESULT_CONTINUE
+}
+
+unsafe extern "C" fn on_error(_stream: *mut c_void, user: *mut c_void, _error: Result_) {
+    // SAFETY: as in `on_data`; only an atomic is touched.
+    let s = unsafe { &*user.cast::<Shared>() };
+    s.counters.ended.store(true, Ordering::Release);
+}
+
+struct AaStream {
+    api: Arc<Api>,
+    stream: *mut c_void,
+    shared: *mut Shared,
+}
+
+// SAFETY: AAudio stream handles may be stopped and closed from any thread.
+unsafe impl Send for AaStream {}
+
+impl StreamImpl for AaStream {
+    fn stop(&mut self) {
+        if self.stream.is_null() {
+            return;
+        }
+        // SAFETY: stop then close; no callback runs after close.
+        unsafe {
+            (self.api.request_stop)(self.stream);
+            (self.api.close)(self.stream);
+            drop(Box::from_raw(self.shared));
+        }
+        self.stream = null_mut();
+    }
+}
+
+fn open(config: StreamConfig, callback: Callback) -> Result<DeviceStream, BackendError> {
+    let api = Arc::new(Api::load().map_err(BackendError::Unavailable)?);
+    let capture = matches!(callback, Callback::Capture(_));
+    let ch = config.channels.clamp(1, 8);
+    let counters = Arc::new(Counters::default());
+    let shared = Box::into_raw(Box::new(Shared {
+        callback,
+        channels: usize::from(ch),
+        rate: config.rate,
+        counters: counters.clone(),
+        frames_done: 0,
+    }));
+    // SAFETY: the AAudio builder protocol; every result checked.
+    unsafe {
+        let mut b = null_mut();
+        let r = (api.create_builder)(&raw mut b);
+        if r != AAUDIO_OK {
+            drop(Box::from_raw(shared));
+            return Err(BackendError::Unavailable(api.text(r)));
+        }
+        (api.set_direction)(
+            b,
+            if capture {
+                AAUDIO_DIRECTION_INPUT
+            } else {
+                AAUDIO_DIRECTION_OUTPUT
+            },
+        );
+        (api.set_sample_rate)(b, i32::try_from(config.rate).unwrap_or(48_000));
+        (api.set_channel_count)(b, i32::from(ch));
+        (api.set_format)(b, AAUDIO_FORMAT_PCM_FLOAT);
+        (api.set_sharing_mode)(b, AAUDIO_SHARING_MODE_SHARED);
+        (api.set_performance_mode)(b, AAUDIO_PERFORMANCE_MODE_LOW_LATENCY);
+        (api.set_frames_per_data_callback)(b, i32::try_from(config.block).unwrap_or(0));
+        (api.set_data_callback)(b, on_data, shared.cast());
+        (api.set_error_callback)(b, on_error, shared.cast());
+        let mut stream = null_mut();
+        let r = (api.open_stream)(b, &raw mut stream);
+        (api.builder_delete)(b);
+        if r != AAUDIO_OK {
+            drop(Box::from_raw(shared));
+            return Err(BackendError::Refused(api.text(r)));
+        }
+        // The device may grant another rate or channel count.
+        let rate = u32::try_from((api.get_sample_rate)(stream)).unwrap_or(config.rate);
+        let channels = u16::try_from((api.get_channel_count)(stream)).unwrap_or(ch);
+        (*shared).rate = rate;
+        (*shared).channels = usize::from(channels);
+        let burst = u32::try_from((api.get_frames_per_burst)(stream)).unwrap_or(config.block);
+        let r = (api.request_start)(stream);
+        if r != AAUDIO_OK {
+            (api.close)(stream);
+            drop(Box::from_raw(shared));
+            return Err(BackendError::Refused(api.text(r)));
+        }
+        Ok(DeviceStream::new(
+            "aaudio",
+            StreamConfig {
+                rate,
+                channels,
+                block: burst,
+            },
+            counters,
+            Box::new(AaStream {
+                api,
+                stream,
+                shared,
+            }),
+        ))
+    }
+}
+
+/// The AAudio backend.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct AAudio;
+
+impl Backend for AAudio {
+    fn name(&self) -> &'static str {
+        "aaudio"
+    }
+
+    fn open_output(
+        &self,
+        config: StreamConfig,
+        render: RenderFn,
+    ) -> Result<DeviceStream, BackendError> {
+        open(config, Callback::Render(render))
+    }
+
+    fn open_input(
+        &self,
+        config: StreamConfig,
+        capture: CaptureFn,
+    ) -> Result<DeviceStream, BackendError> {
+        open(config, Callback::Capture(capture))
+    }
+}
diff --git a/vieww_base/crates/vieww-audio/src/backend/alsa.rs b/vieww_base/crates/vieww-audio/src/backend/alsa.rs
new file mode 100644
index 0000000..8cc85a2
--- /dev/null
+++ b/vieww_base/crates/vieww-audio/src/backend/alsa.rs
@@ -0,0 +1,190 @@
+//! ALSA through the kernel directly — the backend that needs no server and
+//! no library at all (see [`device`](crate::device) for the ioctls).
+//!
+//! A stream thread renders a block, converts it to `S16_LE` with the SIMD
+//! kernels and writes it; the kernel's blocking write paces the thread.
+//! Capture is the mirror image. Hardware access is exclusive: on a desktop
+//! with a sound server running, the server holds the device and this
+//! backend reports it busy — which is why it comes last in the order.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::thread::JoinHandle;
+
+use super::{
+    Backend, BackendError, BlockInfo, CaptureFn, Counters, DeviceStream, RenderFn, StreamConfig,
+    StreamImpl,
+};
+use crate::device::{AlsaInput, AlsaOutput};
+
+/// The ALSA backend.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Alsa {
+    /// Card number.
+    pub card: u32,
+    /// Device number on the card.
+    pub device: u32,
+}
+
+struct AlsaStream {
+    stop: Arc<AtomicBool>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl StreamImpl for AlsaStream {
+    fn stop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(t) = self.thread.take() {
+            t.join().ok();
+        }
+    }
+}
+
+fn unavailable_or_refused(e: String) -> BackendError {
+    if e.contains("No such file") || e.contains("os error 2") {
+        BackendError::Unavailable(e)
+    } else {
+        BackendError::Refused(e)
+    }
+}
+
+impl Backend for Alsa {
+    fn name(&self) -> &'static str {
+        "alsa"
+    }
+
+    fn open_output(
+        &self,
+        config: StreamConfig,
+        mut render: RenderFn,
+    ) -> Result<DeviceStream, BackendError> {
+        let ch = config.channels.clamp(1, 32);
+        let mut out = AlsaOutput::open_channels(self.card, self.device, config.rate, u32::from(ch))
+            .map_err(unavailable_or_refused)?;
+        let counters = Arc::new(Counters::default());
+        let stop = Arc::new(AtomicBool::new(false));
+        let (c2, s2) = (counters.clone(), stop.clone());
+        let frames = config.block.max(64) as usize;
+        let rate = config.rate;
+        let thread = std::thread::Builder::new()
+            .name("vieww-alsa".into())
+            .spawn(move || {
+                let n = frames * usize::from(ch);
+                let mut f = vec![0.0f32; n];
+                let mut q = vec![0i16; n];
+                let mut done = 0u64;
+                while !s2.load(Ordering::Acquire) {
+                    f.fill(0.0);
+                    #[expect(clippy::cast_precision_loss, reason = "stream time")]
+                    render(
+                        &mut f,
+                        &BlockInfo {
+                            frames,
+                            channels: usize::from(ch),
+                            rate,
+                            time: done as f64 / f64::from(rate),
+                        },
+                    );
+                    crate::simd::f32_to_i16(&f, &mut q);
+                    if out.write(&q).is_err() {
+                        c2.ended.store(true, Ordering::Release);
+                        return;
+                    }
+                    done += frames as u64;
+                    c2.block(frames);
+                }
+                out.drain();
+            })
+            .map_err(|e| BackendError::Refused(e.to_string()))?;
+        Ok(DeviceStream::new(
+            "alsa",
+            StreamConfig {
+                channels: ch,
+                block: config.block.max(64),
+                ..config
+            },
+            counters,
+            Box::new(AlsaStream {
+                stop,
+                thread: Some(thread),
+            }),
+        ))
+    }
+
+    fn open_input(
+        &self,
+        config: StreamConfig,
+        mut capture: CaptureFn,
+    ) -> Result<DeviceStream, BackendError> {
+        let ch = config.channels.clamp(1, 32);
+        let mut input = AlsaInput::open(self.card, self.device, config.rate, u32::from(ch))
+            .map_err(unavailable_or_refused)?;
+        let counters = Arc::new(Counters::default());
+        let stop = Arc::new(AtomicBool::new(false));
+        let (c2, s2) = (counters.clone(), stop.clone());
+        let frames = config.block.max(64) as usize;
+        let rate = config.rate;
+        let thread = std::thread::Builder::new()
+            .name("vieww-alsa-in".into())
+            .spawn(move || {
+                let n = frames * usize::from(ch);
+                let mut q = vec![0i16; n];
+                let mut f = vec![0.0f32; n];
+                let mut done = 0u64;
+                while !s2.load(Ordering::Acquire) {
+                    if input.read(&mut q).is_err() {
+                        c2.ended.store(true, Ordering::Release);
+                        return;
+                    }
+                    crate::simd::i16_to_f32(&q, &mut f);
+                    #[expect(clippy::cast_precision_loss, reason = "stream time")]
+                    capture(
+                        &f,
+                        &BlockInfo {
+                            frames,
+                            channels: usize::from(ch),
+                            rate,
+                            time: done as f64 / f64::from(rate),
+                        },
+                    );
+                    done += frames as u64;
+                    c2.block(frames);
+                }
+            })
+            .map_err(|e| BackendError::Refused(e.to_string()))?;
+        Ok(DeviceStream::new(
+            "alsa",
+            StreamConfig {
+                channels: ch,
+                block: config.block.max(64),
+                ..config
+            },
+            counters,
+            Box::new(AlsaStream {
+                stop,
+                thread: Some(thread),
+            }),
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_missing_card_is_unavailable_not_a_crash() {
+        let a = Alsa {
+            card: 97,
+            device: 3,
+        };
+        let e = a
+            .open_output(StreamConfig::default(), Box::new(|_, _| {}))
+            .unwrap_err();
+        assert!(matches!(e, BackendError::Unavailable(_)), "{e}");
+        let e = a
+            .open_input(StreamConfig::default(), Box::new(|_, _| {}))
+            .unwrap_err();
+        assert!(matches!(e, BackendError::Unavailable(_)), "{e}");
+    }
+}
diff --git a/vieww_base/crates/vieww-audio/src/backend/coreaudio.rs b/vieww_base/crates/vieww-audio/src/backend/coreaudio.rs
new file mode 100644
index 0000000..43dd589
--- /dev/null
+++ b/vieww_base/crates/vieww-audio/src/backend/coreaudio.rs
@@ -0,0 +1,526 @@
+//! Core Audio: macOS's audio system, through Audio Units.
+//!
+//! Playback uses the `DefaultOutput` unit (it follows the user's chosen
+//! output device), capture the `HALOutput` unit with input enabled and the
+//! default input device selected. The stream format is set to packed,
+//! interleaved 32-bit float at the requested rate and channels — the unit
+//! converts to the hardware — and the render (or input) callback runs on
+//! Core Audio's real-time I/O thread. Playback renders straight into the
+//! unit's buffer; capture pulls with `AudioUnitRender` into a buffer
+//! preallocated for the unit's maximum slice.
+
+use std::ffi::c_void;
+use std::ptr::null_mut;
+use std::sync::Arc;
+
+use super::{
+    Backend, BackendError, BlockInfo, CaptureFn, Counters, DeviceStream, RenderFn, StreamConfig,
+    StreamImpl,
+};
+
+type OsStatus = i32;
+type AudioUnit = *mut c_void;
+
+const fn fourcc(s: &[u8; 4]) -> u32 {
+    u32::from_be_bytes(*s)
+}
+
+const K_AUDIO_UNIT_TYPE_OUTPUT: u32 = fourcc(b"auou");
+const K_AUDIO_UNIT_SUBTYPE_DEFAULT_OUTPUT: u32 = fourcc(b"def ");
+const K_AUDIO_UNIT_SUBTYPE_HAL_OUTPUT: u32 = fourcc(b"ahal");
+const K_AUDIO_UNIT_MANUFACTURER_APPLE: u32 = fourcc(b"appl");
+const K_AUDIO_FORMAT_LINEAR_PCM: u32 = fourcc(b"lpcm");
+const K_AUDIO_FORMAT_FLAG_IS_FLOAT: u32 = 1;
+const K_AUDIO_FORMAT_FLAG_IS_PACKED: u32 = 8;
+const K_AUDIO_UNIT_PROPERTY_STREAM_FORMAT: u32 = 8;
+const K_AUDIO_UNIT_PROPERTY_MAXIMUM_FRAMES_PER_SLICE: u32 = 14;
+const K_AUDIO_UNIT_PROPERTY_SET_RENDER_CALLBACK: u32 = 23;
+const K_AUDIO_OUTPUT_UNIT_PROPERTY_CURRENT_DEVICE: u32 = 2000;
+const K_AUDIO_OUTPUT_UNIT_PROPERTY_ENABLE_IO: u32 = 2003;
+const K_AUDIO_OUTPUT_UNIT_PROPERTY_SET_INPUT_CALLBACK: u32 = 2005;
+const K_AUDIO_UNIT_SCOPE_GLOBAL: u32 = 0;
+const K_AUDIO_UNIT_SCOPE_INPUT: u32 = 1;
+const K_AUDIO_UNIT_SCOPE_OUTPUT: u32 = 2;
+const K_AUDIO_OBJECT_SYSTEM_OBJECT: u32 = 1;
+const K_AUDIO_HARDWARE_PROPERTY_DEFAULT_INPUT_DEVICE: u32 = fourcc(b"dIn ");
+const K_AUDIO_OBJECT_PROPERTY_SCOPE_GLOBAL: u32 = fourcc(b"glob");
+const MAX_SLICE: u32 = 4_096;
+
+#[repr(C)]
+struct AudioComponentDescription {
+    component_type: u32,
+    component_sub_type: u32,
+    component_manufacturer: u32,
+    component_flags: u32,
+    component_flags_mask: u32,
+}
+
+#[repr(C)]
+struct AudioStreamBasicDescription {
+    sample_rate: f64,
+    format_id: u32,
+    format_flags: u32,
+    bytes_per_packet: u32,
+    frames_per_packet: u32,
+    bytes_per_frame: u32,
+    channels_per_frame: u32,
+    bits_per_channel: u32,
+    reserved: u32,
+}
+
+#[repr(C)]
+struct AudioBuffer {
+    number_channels: u32,
+    data_byte_size: u32,
+    data: *mut c_void,
+}
+
+#[repr(C)]
+struct AudioBufferList {
+    number_buffers: u32,
+    buffers: [AudioBuffer; 1],
+}
+
+#[repr(C)]
+struct AudioObjectPropertyAddress {
+    selector: u32,
+    scope: u32,
+    element: u32,
+}
+
+type RenderProc = unsafe extern "C" fn(
+    *mut c_void,
+    *mut u32,
+    *const c_void,
+    u32,
+    u32,
+    *mut AudioBufferList,
+) -> OsStatus;
+
+#[repr(C)]
+struct AuRenderCallbackStruct {
+    input_proc: RenderProc,
+    input_proc_ref_con: *mut c_void,
+}
+
+#[cfg_attr(target_os = "macos", link(name = "AudioToolbox", kind = "framework"))]
+unsafe extern "C" {
+    fn AudioComponentFindNext(
+        component: *mut c_void,
+        desc: *const AudioComponentDescription,
+    ) -> *mut c_void;
+    fn AudioComponentInstanceNew(component: *mut c_void, out: *mut AudioUnit) -> OsStatus;
+    fn AudioComponentInstanceDispose(unit: AudioUnit) -> OsStatus;
+    fn AudioUnitSetProperty(
+        unit: AudioUnit,
+        id: u32,
+        scope: u32,
+        element: u32,
+        data: *const c_void,
+        size: u32,
+    ) -> OsStatus;
+    fn AudioUnitInitialize(unit: AudioUnit) -> OsStatus;
+    fn AudioUnitUninitialize(unit: AudioUnit) -> OsStatus;
+    fn AudioOutputUnitStart(unit: AudioUnit) -> OsStatus;
+    fn AudioOutputUnitStop(unit: AudioUnit) -> OsStatus;
+    fn AudioUnitRender(
+        unit: AudioUnit,
+        flags: *mut u32,
+        timestamp: *const c_void,
+        bus: u32,
+        frames: u32,
+        data: *mut AudioBufferList,
+    ) -> OsStatus;
+}
+
+#[cfg_attr(target_os = "macos", link(name = "CoreAudio", kind = "framework"))]
+unsafe extern "C" {
+    fn AudioObjectGetPropertyData(
+        object: u32,
+        address: *const AudioObjectPropertyAddress,
+        qualifier_size: u32,
+        qualifier: *const c_void,
+        size: *mut u32,
+        data: *mut c_void,
+    ) -> OsStatus;
+}
+
+enum Callback {
+    Render(RenderFn),
+    Capture(CaptureFn),
+}
+
+struct Shared {
+    callback: Callback,
+    unit: AudioUnit,
+    channels: usize,
+    rate: u32,
+    counters: Arc<Counters>,
+    frames_done: u64,
+    scratch: Vec<f32>,
+}
+
+unsafe extern "C" fn render(
+    refcon: *mut c_void,
+    _flags: *mut u32,
+    _ts: *const c_void,
+    _bus: u32,
+    frames: u32,
+    data: *mut AudioBufferList,
+) -> OsStatus {
+    // SAFETY: `refcon` is the boxed `Shared`, alive until the unit is
+    // disposed; Core Audio calls one callback at a time.
+    let s = unsafe { &mut *refcon.cast::<Shared>() };
+    if data.is_null() {
+        return 0;
+    }
+    // SAFETY: an interleaved stream has one buffer of `frames` frames.
+    let b = unsafe { &mut (*data).buffers[0] };
+    let n = frames as usize;
+    let want = n * s.channels;
+    if b.data.is_null() || (b.data_byte_size as usize) < want * 4 {
+        return 0;
+    }
+    // SAFETY: as above.
+    let out = unsafe { std::slice::from_raw_parts_mut(b.data.cast::<f32>(), want) };
+    out.fill(0.0);
+    #[expect(clippy::cast_precision_loss, reason = "stream time")]
+    let info = BlockInfo {
+        frames: n,
+        channels: s.channels,
+        rate: s.rate,
+        time: s.frames_done as f64 / f64::from(s.rate),
+    };
+    if let Callback::Render(r) = &mut s.callback {
+        r(out, &info);
+    }
+    s.frames_done += n as u64;
+    s.counters.block(n);
+    0
+}
+
+unsafe extern "C" fn input(
+    refcon: *mut c_void,
+    flags: *mut u32,
+    ts: *const c_void,
+    bus: u32,
+    frames: u32,
+    _data: *mut AudioBufferList,
+) -> OsStatus {
+    // SAFETY: as in `render`.
+    let s = unsafe { &mut *refcon.cast::<Shared>() };
+    let n = (frames.min(MAX_SLICE)) as usize;
+    let bytes = n * s.channels * 4;
+    let mut list = AudioBufferList {
+        number_buffers: 1,
+        buffers: [AudioBuffer {
+            number_channels: u32::try_from(s.channels).unwrap_or(1),
+            data_byte_size: u32::try_from(bytes).unwrap_or(0),
+            data: s.scratch.as_mut_ptr().cast(),
+        }],
+    };
+    // SAFETY: pulling the captured frames into our preallocated buffer.
+    let st =
+        unsafe { AudioUnitRender(s.unit, flags, ts, bus, frames.min(MAX_SLICE), &raw mut list) };
+    if st != 0 {
+        s.counters
+            .xruns
+            .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        return st;
+    }
+    #[expect(clippy::cast_precision_loss, reason = "stream time")]
+    let info = BlockInfo {
+        frames: n,
+        channels: s.channels,
+        rate: s.rate,
+        time: s.frames_done as f64 / f64::from(s.rate),
+    };
+    if let Callback::Capture(c) = &mut s.callback {
+        c(&s.scratch[..n * s.channels], &info);
+    }
+    s.frames_done += n as u64;
+    s.counters.block(n);
+    0
+}
+
+struct CaStream {
+    unit: AudioUnit,
+    shared: *mut Shared,
+}
+
+// SAFETY: Audio Unit handles may be stopped and disposed from any thread.
+unsafe impl Send for CaStream {}
+
+impl StreamImpl for CaStream {
+    fn stop(&mut self) {
+        if self.unit.is_null() {
+            return;
+        }
+        // SAFETY: stop, uninitialise and dispose the unit we created; no
+        // callback runs after dispose, so the shared state can go.
+        unsafe {
+            AudioOutputUnitStop(self.unit);
+            AudioUnitUninitialize(self.unit);
+            AudioComponentInstanceDispose(self.unit);
+            drop(Box::from_raw(self.shared));
+        }
+        self.unit = null_mut();
+    }
+}
+
+fn status(st: OsStatus, what: &str) -> Result<(), String> {
+    if st == 0 {
+        Ok(())
+    } else {
+        Err(format!("{what} failed (OSStatus {st})"))
+    }
+}
+
+unsafe fn set<T>(
+    unit: AudioUnit,
+    id: u32,
+    scope: u32,
+    element: u32,
+    value: &T,
+    what: &str,
+) -> Result<(), String> {
+    // SAFETY: a live unit and a property value of the property's type.
+    status(
+        unsafe {
+            AudioUnitSetProperty(
+                unit,
+                id,
+                scope,
+                element,
+                std::ptr::from_ref(value).cast(),
+                u32::try_from(size_of::<T>()).unwrap_or(0),
+            )
+        },
+        what,
+    )
+}
+
+fn open(config: StreamConfig, callback: Callback) -> Result<DeviceStream, BackendError> {
+    let capture = matches!(callback, Callback::Capture(_));
+    let ch = config.channels.clamp(1, 32);
+    let desc = AudioComponentDescription {
+        component_type: K_AUDIO_UNIT_TYPE_OUTPUT,
+        component_sub_type: if capture {
+            K_AUDIO_UNIT_SUBTYPE_HAL_OUTPUT
+        } else {
+            K_AUDIO_UNIT_SUBTYPE_DEFAULT_OUTPUT
+        },
+        component_manufacturer: K_AUDIO_UNIT_MANUFACTURER_APPLE,
+        component_flags: 0,
+        component_flags_mask: 0,
+    };
+    // SAFETY: the Audio Unit setup sequence; every status is checked and
+    // the unit disposed on failure.
+    unsafe {
+        let comp = AudioComponentFindNext(null_mut(), &raw const desc);
+        if comp.is_null() {
+            return Err(BackendError::Unavailable("no output Audio Unit".into()));
+        }
+        let mut unit = null_mut();
+        status(
+            AudioComponentInstanceNew(comp, &raw mut unit),
+            "AudioComponentInstanceNew",
+        )
+        .map_err(BackendError::Unavailable)?;
+        let counters = Arc::new(Counters::default());
+        let shared = Box::into_raw(Box::new(Shared {
+            callback,
+            unit,
+            channels: usize::from(ch),
+            rate: config.rate,
+            counters: counters.clone(),
+            frames_done: 0,
+            scratch: vec![0.0; MAX_SLICE as usize * usize::from(ch)],
+        }));
+        let fmt = AudioStreamBasicDescription {
+            sample_rate: f64::from(config.rate),
+            format_id: K_AUDIO_FORMAT_LINEAR_PCM,
+            format_flags: K_AUDIO_FORMAT_FLAG_IS_FLOAT | K_AUDIO_FORMAT_FLAG_IS_PACKED,
+            bytes_per_packet: u32::from(ch) * 4,
+            frames_per_packet: 1,
+            bytes_per_frame: u32::from(ch) * 4,
+            channels_per_frame: u32::from(ch),
+            bits_per_channel: 32,
+            reserved: 0,
+        };
+        let setup = || -> Result<(), String> {
+            if capture {
+                let on: u32 = 1;
+                let off: u32 = 0;
+                set(
+                    unit,
+                    K_AUDIO_OUTPUT_UNIT_PROPERTY_ENABLE_IO,
+                    K_AUDIO_UNIT_SCOPE_INPUT,
+                    1,
+                    &on,
+                    "EnableIO(input)",
+                )?;
+                set(
+                    unit,
+                    K_AUDIO_OUTPUT_UNIT_PROPERTY_ENABLE_IO,
+                    K_AUDIO_UNIT_SCOPE_OUTPUT,
+                    0,
+                    &off,
+                    "EnableIO(output)",
+                )?;
+                let addr = AudioObjectPropertyAddress {
+                    selector: K_AUDIO_HARDWARE_PROPERTY_DEFAULT_INPUT_DEVICE,
+                    scope: K_AUDIO_OBJECT_PROPERTY_SCOPE_GLOBAL,
+                    element: 0,
+                };
+                let mut device: u32 = 0;
+                let mut size = 4u32;
+                status(
+                    AudioObjectGetPropertyData(
+                        K_AUDIO_OBJECT_SYSTEM_OBJECT,
+                        &raw const addr,
+                        0,
+                        std::ptr::null(),
+                        &raw mut size,
+                        (&raw mut device).cast(),
+                    ),
+                    "default input device",
+                )?;
+                if device == 0 {
+                    return Err("no default input device".into());
+                }
+                set(
+                    unit,
+                    K_AUDIO_OUTPUT_UNIT_PROPERTY_CURRENT_DEVICE,
+                    K_AUDIO_UNIT_SCOPE_GLOBAL,
+                    0,
+                    &device,
+                    "CurrentDevice",
+                )?;
+                set(
+                    unit,
+                    K_AUDIO_UNIT_PROPERTY_STREAM_FORMAT,
+                    K_AUDIO_UNIT_SCOPE_OUTPUT,
+                    1,
+                    &fmt,
+                    "StreamFormat",
+                )?;
+                set(
+                    unit,
+                    K_AUDIO_UNIT_PROPERTY_MAXIMUM_FRAMES_PER_SLICE,
+                    K_AUDIO_UNIT_SCOPE_GLOBAL,
+                    0,
+                    &MAX_SLICE,
+                    "MaximumFramesPerSlice",
+                )?;
+                let cb = AuRenderCallbackStruct {
+                    input_proc: input,
+                    input_proc_ref_con: shared.cast(),
+                };
+                set(
+                    unit,
+                    K_AUDIO_OUTPUT_UNIT_PROPERTY_SET_INPUT_CALLBACK,
+                    K_AUDIO_UNIT_SCOPE_GLOBAL,
+                    0,
+                    &cb,
+                    "SetInputCallback",
+                )?;
+            } else {
+                set(
+                    unit,
+                    K_AUDIO_UNIT_PROPERTY_STREAM_FORMAT,
+                    K_AUDIO_UNIT_SCOPE_INPUT,
+                    0,
+                    &fmt,
+                    "StreamFormat",
+                )?;
+                let cb = AuRenderCallbackStruct {
+                    input_proc: render,
+                    input_proc_ref_con: shared.cast(),
+                };
+                set(
+                    unit,
+                    K_AUDIO_UNIT_PROPERTY_SET_RENDER_CALLBACK,
+                    K_AUDIO_UNIT_SCOPE_INPUT,
+                    0,
+                    &cb,
+                    "SetRenderCallback",
+                )?;
+            }
+            status(AudioUnitInitialize(unit), "AudioUnitInitialize")?;
+            status(AudioOutputUnitStart(unit), "AudioOutputUnitStart")
+        };
+        if let Err(e) = setup() {
+            AudioComponentInstanceDispose(unit);
+            drop(Box::from_raw(shared));
+            return Err(if e.contains("default input") {
+                BackendError::Unavailable(e)
+            } else {
+                BackendError::Refused(e)
+            });
+        }
+        Ok(DeviceStream::new(
+            "coreaudio",
+            StreamConfig {
+                rate: config.rate,
+                channels: ch,
+                block: config.block,
+            },
+            counters,
+            Box::new(CaStream { unit, shared }),
+        ))
+    }
+}
+
+/// The Core Audio backend.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct CoreAudio;
+
+impl Backend for CoreAudio {
+    fn name(&self) -> &'static str {
+        "coreaudio"
+    }
+
+    fn open_output(
+        &self,
+        config: StreamConfig,
+        render: RenderFn,
+    ) -> Result<DeviceStream, BackendError> {
+        open(config, Callback::Render(render))
+    }
+
+    fn open_input(
+        &self,
+        config: StreamConfig,
+        capture: CaptureFn,
+    ) -> Result<DeviceStream, BackendError> {
+        open(config, Callback::Capture(capture))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn four_char_codes_and_layouts() {
+        assert_eq!(K_AUDIO_UNIT_TYPE_OUTPUT, 0x6175_6f75);
+        assert_eq!(K_AUDIO_FORMAT_LINEAR_PCM, 0x6c70_636d);
+        assert_eq!(size_of::<AudioStreamBasicDescription>(), 40);
+        assert_eq!(size_of::<AudioBufferList>(), 24);
+        assert_eq!(size_of::<AudioComponentDescription>(), 20);
+    }
+
+    #[test]
+    #[cfg(target_os = "macos")]
+    fn plays_on_the_default_output_or_refuses_cleanly() {
+        match CoreAudio.open_output(StreamConfig::default(), Box::new(|b, _| b.fill(0.0))) {
+            Ok(s) => assert!(
+                s.wait_for(5, std::time::Duration::from_secs(10)),
+                "{:?}",
+                s.stats()
+            ),
+            Err(e) => assert!(!e.to_string().is_empty()),
+        }
+    }
+}
diff --git a/vieww_base/crates/vieww-audio/src/backend/dl.rs b/vieww_base/crates/vieww-audio/src/backend/dl.rs
new file mode 100644
index 0000000..5acf518
--- /dev/null
+++ b/vieww_base/crates/vieww-audio/src/backend/dl.rs
@@ -0,0 +1,108 @@
+//! Loading a platform library at run time (`dlopen`, `LoadLibraryW`).
+
+#[cfg(unix)]
+use std::ffi::c_int;
+#[cfg(unix)]
+use std::ffi::CString;
+use std::ffi::{c_char, c_void, CStr};
+
+#[cfg(windows)]
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn LoadLibraryW(name: *const u16) -> *mut c_void;
+    fn GetProcAddress(module: *mut c_void, name: *const c_char) -> *mut c_void;
+    fn FreeLibrary(module: *mut c_void) -> i32;
+}
+
+#[cfg(unix)]
+unsafe extern "C" {
+    fn dlopen(filename: *const c_char, flag: c_int) -> *mut c_void;
+    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;
+    fn dlclose(handle: *mut c_void) -> c_int;
+    fn dlerror() -> *const c_char;
+}
+
+#[cfg(unix)]
+const RTLD_NOW: c_int = 2;
+
+/// A loaded shared library.
+#[derive(Debug)]
+pub(crate) struct Library(*mut c_void);
+
+// SAFETY: a library handle may be used from any thread (dlsym/dlclose are
+// thread-safe).
+unsafe impl Send for Library {}
+// SAFETY: as above.
+unsafe impl Sync for Library {}
+
+impl Library {
+    /// The first of `names` that loads.
+    pub(crate) fn open(names: &[&str]) -> Result<Self, String> {
+        let mut last = String::new();
+        for n in names {
+            #[cfg(unix)]
+            {
+                let c = CString::new(*n).map_err(|e| e.to_string())?;
+                // SAFETY: a valid C string; loading a system library.
+                let h = unsafe { dlopen(c.as_ptr(), RTLD_NOW) };
+                if !h.is_null() {
+                    return Ok(Self(h));
+                }
+                // SAFETY: dlerror returns a thread-local string or null.
+                last = unsafe {
+                    let e = dlerror();
+                    if e.is_null() {
+                        format!("{n}: not found")
+                    } else {
+                        CStr::from_ptr(e).to_string_lossy().into_owned()
+                    }
+                };
+            }
+            #[cfg(windows)]
+            {
+                let wide: Vec<u16> = n.encode_utf16().chain(Some(0)).collect();
+                // SAFETY: a valid wide string; loading a system library.
+                let h = unsafe { LoadLibraryW(wide.as_ptr()) };
+                if !h.is_null() {
+                    return Ok(Self(h));
+                }
+                last = format!("{n}: {}", std::io::Error::last_os_error());
+            }
+        }
+        Err(last)
+    }
+
+    /// A symbol as a function pointer of type `T`.
+    ///
+    /// # Safety
+    /// `T` must be the symbol's true C type (a function pointer).
+    pub(crate) unsafe fn get<T: Copy>(&self, name: &CStr) -> Result<T, String> {
+        // SAFETY: a live handle and C string.
+        #[cfg(unix)]
+        let p = unsafe { dlsym(self.0, name.as_ptr()) };
+        // SAFETY: as above.
+        #[cfg(windows)]
+        let p = unsafe { GetProcAddress(self.0, name.as_ptr()) };
+        if p.is_null() {
+            return Err(format!("missing symbol {}", name.to_string_lossy()));
+        }
+        debug_assert_eq!(size_of::<T>(), size_of::<*mut c_void>());
+        // SAFETY: the caller guarantees `T` is the symbol's pointer type.
+        Ok(unsafe { std::mem::transmute_copy::<*mut c_void, T>(&p) })
+    }
+}
+
+impl Drop for Library {
+    fn drop(&mut self) {
+        // SAFETY: a handle from dlopen/LoadLibraryW, closed once.
+        #[cfg(unix)]
+        unsafe {
+            dlclose(self.0);
+        }
+        // SAFETY: as above.
+        #[cfg(windows)]
+        unsafe {
+            FreeLibrary(self.0);
+        }
+    }
+}
diff --git a/vieww_base/crates/vieww-audio/src/backend/jack.rs b/vieww_base/crates/vieww-audio/src/backend/jack.rs
new file mode 100644
index 0000000..099cac5
--- /dev/null
+++ b/vieww_base/crates/vieww-audio/src/backend/jack.rs
@@ -0,0 +1,474 @@
+//! JACK: the low-latency audio server of Linux studios (and of macOS and
+//! Windows setups that use it), and the API PipeWire also serves.
+//!
+//! `libjack` is loaded at run time. A stream is a JACK client with one
+//! port per channel; JACK calls the process callback on its real-time
+//! thread with planar port buffers, the render callback fills an
+//! interleaved scratch block (preallocated, rendered in chunks if the
+//! server's period ever exceeds it — nothing allocates on that thread),
+//! and the block is split into the ports. The server sets the rate and
+//! period: [`DeviceStream::config`] reports them. New ports are connected
+//! to the server's physical ports unless [`Jack::autoconnect`] is off.
+
+use std::ffi::{c_char, c_int, c_void, CStr, CString};
+use std::ptr::{null, null_mut};
+use std::sync::atomic::Ordering;
+use std::sync::Arc;
+
+use super::dl::Library;
+use super::{
+    Backend, BackendError, BlockInfo, CaptureFn, Counters, DeviceStream, RenderFn, StreamConfig,
+    StreamImpl,
+};
+
+const PORT_IS_INPUT: u64 = 0x1;
+const PORT_IS_OUTPUT: u64 = 0x2;
+const PORT_IS_PHYSICAL: u64 = 0x4;
+const NO_START_SERVER: c_int = 0x01;
+const AUDIO_TYPE: &CStr = c"32 bit float mono audio";
+const CHUNK: usize = 8_192;
+
+type ProcessCb = unsafe extern "C" fn(nframes: u32, arg: *mut c_void) -> c_int;
+type XrunCb = unsafe extern "C" fn(arg: *mut c_void) -> c_int;
+type ShutdownCb = unsafe extern "C" fn(arg: *mut c_void);
+
+struct Api {
+    _lib: Library,
+    client_open: unsafe extern "C" fn(*const c_char, c_int, *mut c_int, ...) -> *mut c_void,
+    client_close: unsafe extern "C" fn(*mut c_void) -> c_int,
+    get_sample_rate: unsafe extern "C" fn(*mut c_void) -> u32,
+    get_buffer_size: unsafe extern "C" fn(*mut c_void) -> u32,
+    port_register:
+        unsafe extern "C" fn(*mut c_void, *const c_char, *const c_char, u64, u64) -> *mut c_void,
+    port_get_buffer: unsafe extern "C" fn(*mut c_void, u32) -> *mut f32,
+    port_name: unsafe extern "C" fn(*mut c_void) -> *const c_char,
+    set_process_callback: unsafe extern "C" fn(*mut c_void, ProcessCb, *mut c_void) -> c_int,
+    set_xrun_callback: unsafe extern "C" fn(*mut c_void, XrunCb, *mut c_void) -> c_int,
+    on_shutdown: unsafe extern "C" fn(*mut c_void, ShutdownCb, *mut c_void),
+    activate: unsafe extern "C" fn(*mut c_void) -> c_int,
+    deactivate: unsafe extern "C" fn(*mut c_void) -> c_int,
+    get_ports:
+        unsafe extern "C" fn(*mut c_void, *const c_char, *const c_char, u64) -> *mut *const c_char,
+    connect: unsafe extern "C" fn(*mut c_void, *const c_char, *const c_char) -> c_int,
+    free: unsafe extern "C" fn(*mut c_void),
+}
+
+impl Api {
+    fn load() -> Result<Self, String> {
+        let lib = Library::open(&[
+            "libjack.so.0",
+            "libjack.so",
+            "libjack.0.dylib",
+            "/usr/local/lib/libjack.0.dylib",
+            "/opt/homebrew/lib/libjack.0.dylib",
+            "libjack64.dll",
+            "libjack.dll",
+        ])?;
+        // SAFETY: the types are libjack's documented signatures.
+        unsafe {
+            Ok(Self {
+                client_open: lib.get(c"jack_client_open")?,
+                client_close: lib.get(c"jack_client_close")?,
+                get_sample_rate: lib.get(c"jack_get_sample_rate")?,
+                get_buffer_size: lib.get(c"jack_get_buffer_size")?,
+                port_register: lib.get(c"jack_port_register")?,
+                port_get_buffer: lib.get(c"jack_port_get_buffer")?,
+                port_name: lib.get(c"jack_port_name")?,
+                set_process_callback: lib.get(c"jack_set_process_callback")?,
+                set_xrun_callback: lib.get(c"jack_set_xrun_callback")?,
+                on_shutdown: lib.get(c"jack_on_shutdown")?,
+                activate: lib.get(c"jack_activate")?,
+                deactivate: lib.get(c"jack_deactivate")?,
+                get_ports: lib.get(c"jack_get_ports")?,
+                connect: lib.get(c"jack_connect")?,
+                free: lib.get(c"jack_free")?,
+                _lib: lib,
+            })
+        }
+    }
+}
+
+/// The JACK backend.
+#[derive(Debug, Clone)]
+pub struct Jack {
+    /// Client name shown in the server's graph.
+    pub client_name: String,
+    /// Connect new ports to the physical ports.
+    pub autoconnect: bool,
+}
+
+impl Default for Jack {
+    fn default() -> Self {
+        Self {
+            client_name: "vieww".into(),
+            autoconnect: true,
+        }
+    }
+}
+
+enum Callback {
+    Render(RenderFn),
+    Capture(CaptureFn),
+}
+
+struct Shared {
+    api: Arc<Api>,
+    ports: Vec<*mut c_void>,
+    callback: Callback,
+    scratch: Vec<f32>,
+    counters: Arc<Counters>,
+    rate: u32,
+    frames_done: u64,
+}
+
+unsafe extern "C" fn process(nframes: u32, arg: *mut c_void) -> c_int {
+    // SAFETY: `arg` is the `Shared` boxed in `open`, alive until the client
+    // is closed (after which JACK makes no further calls).
+    let s = unsafe { &mut *arg.cast::<Shared>() };
+    let n = nframes as usize;
+    let ch = s.ports.len();
+    let mut bufs = [null_mut::<f32>(); 64];
+    for (b, &p) in bufs.iter_mut().zip(&s.ports) {
+        // SAFETY: a registered port; valid for this cycle.
+        *b = unsafe { (s.api.port_get_buffer)(p, nframes) };
+    }
+    if bufs[..ch].iter().any(|b| b.is_null()) {
+        return 0;
+    }
+    let mut done = 0;
+    while done < n {
+        let k = (n - done).min(CHUNK);
+        let block = &mut s.scratch[..k * ch];
+        #[expect(clippy::cast_precision_loss, reason = "stream time")]
+        let info = BlockInfo {
+            frames: k,
+            channels: ch,
+            rate: s.rate,
+            time: (s.frames_done + done as u64) as f64 / f64::from(s.rate),
+        };
+        match &mut s.callback {
+            Callback::Render(r) => {
+                block.fill(0.0);
+                r(block, &info);
+                for (c, b) in bufs[..ch].iter().enumerate() {
+                    // SAFETY: the port buffer holds `nframes` samples.
+                    let dst = unsafe { std::slice::from_raw_parts_mut(b.add(done), k) };
+                    for (i, d) in dst.iter_mut().enumerate() {
+                        *d = block[i * ch + c];
+                    }
+                }
+            }
+            Callback::Capture(cap) => {
+                for (c, b) in bufs[..ch].iter().enumerate() {
+                    // SAFETY: as above.
+                    let src = unsafe { std::slice::from_raw_parts(b.add(done), k) };
+                    for (i, v) in src.iter().enumerate() {
+                        block[i * ch + c] = *v;
+                    }
+                }
+                cap(block, &info);
+            }
+        }
+        done += k;
+    }
+    s.frames_done += n as u64;
+    s.counters.block(n);
+    0
+}
+
+unsafe extern "C" fn xrun(arg: *mut c_void) -> c_int {
+    // SAFETY: as in `process` (only the atomic counters are touched).
+    let s = unsafe { &*arg.cast::<Shared>() };
+    s.counters.xruns.fetch_add(1, Ordering::Relaxed);
+    0
+}
+
+unsafe extern "C" fn shutdown(arg: *mut c_void) {
+    // SAFETY: as in `xrun`.
+    let s = unsafe { &*arg.cast::<Shared>() };
+    s.counters.ended.store(true, Ordering::Release);
+}
+
+struct JackStream {
+    api: Arc<Api>,
+    client: *mut c_void,
+    shared: *mut Shared,
+}
+
+// SAFETY: the client handle is usable from any thread; `shared` is only
+// freed in `stop`, after the client is closed.
+unsafe impl Send for JackStream {}
+
+impl StreamImpl for JackStream {
+    fn stop(&mut self) {
+        if self.client.is_null() {
+            return;
+        }
+        // SAFETY: a live client; after close, JACK calls nothing more, so
+        // the shared state can be freed.
+        unsafe {
+            (self.api.deactivate)(self.client);
+            (self.api.client_close)(self.client);
+            drop(Box::from_raw(self.shared));
+        }
+        self.client = null_mut();
+    }
+}
+
+fn cstr(p: *const c_char) -> String {
+    if p.is_null() {
+        String::new()
+    } else {
+        // SAFETY: JACK port names are NUL-terminated.
+        unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()
+    }
+}
+
+impl Jack {
+    fn open(&self, config: StreamConfig, callback: Callback) -> Result<DeviceStream, BackendError> {
+        let api = Arc::new(Api::load().map_err(BackendError::Unavailable)?);
+        let name = CString::new(self.client_name.as_str())
+            .map_err(|e| BackendError::Refused(e.to_string()))?;
+        let mut status = 0;
+        // SAFETY: a valid name and status pointer; no variadic arguments
+        // follow (no JackServerName option).
+        let client = unsafe { (api.client_open)(name.as_ptr(), NO_START_SERVER, &raw mut status) };
+        if client.is_null() {
+            return Err(BackendError::Unavailable(format!(
+                "no JACK server running (status {status:#x})"
+            )));
+        }
+        let input = matches!(callback, Callback::Capture(_));
+        let ch = usize::from(config.channels.clamp(1, 64));
+        let flag = if input { PORT_IS_INPUT } else { PORT_IS_OUTPUT };
+        let mut ports = Vec::with_capacity(ch);
+        for c in 0..ch {
+            let pname = CString::new(format!("{}_{}", if input { "in" } else { "out" }, c + 1))
+                .unwrap_or_default();
+            // SAFETY: a live client and valid strings.
+            let p = unsafe {
+                (api.port_register)(client, pname.as_ptr(), AUDIO_TYPE.as_ptr(), flag, 0)
+            };
+            if p.is_null() {
+                // SAFETY: closing the client we opened.
+                unsafe { (api.client_close)(client) };
+                return Err(BackendError::Refused("could not register a port".into()));
+            }
+            ports.push(p);
+        }
+        // SAFETY: a live client.
+        let (rate, period) =
+            unsafe { ((api.get_sample_rate)(client), (api.get_buffer_size)(client)) };
+        let counters = Arc::new(Counters::default());
+        let shared = Box::into_raw(Box::new(Shared {
+            api: api.clone(),
+            ports: ports.clone(),
+            callback,
+            scratch: vec![0.0; CHUNK * ch],
+            counters: counters.clone(),
+            rate,
+            frames_done: 0,
+        }));
+        // SAFETY: callbacks registered before activation, with the shared
+        // state as their argument.
+        let ok = unsafe {
+            (api.set_process_callback)(client, process, shared.cast()) == 0
+                && (api.set_xrun_callback)(client, xrun, shared.cast()) == 0
+        };
+        // SAFETY: as above.
+        unsafe { (api.on_shutdown)(client, shutdown, shared.cast()) };
+        // SAFETY: a configured client.
+        if !ok || unsafe { (api.activate)(client) } != 0 {
+            // SAFETY: never activated: close, then free.
+            unsafe {
+                (api.client_close)(client);
+                drop(Box::from_raw(shared));
+            }
+            return Err(BackendError::Refused(
+                "the server refused activation".into(),
+            ));
+        }
+        if self.autoconnect {
+            // Physical playback ports are inputs; capture ports outputs.
+            let want = PORT_IS_PHYSICAL | if input { PORT_IS_OUTPUT } else { PORT_IS_INPUT };
+            // SAFETY: a live client; the list is freed with jack_free.
+            unsafe {
+                let list = (api.get_ports)(client, null(), AUDIO_TYPE.as_ptr(), want);
+                if !list.is_null() {
+                    for (i, &p) in ports.iter().enumerate() {
+                        let other = *list.add(i);
+                        if other.is_null() {
+                            break;
+                        }
+                        let mine = (api.port_name)(p);
+                        if input {
+                            (api.connect)(client, other, mine);
+                        } else {
+                            (api.connect)(client, mine, other);
+                        }
+                    }
+                    (api.free)(list.cast());
+                }
+            }
+        }
+        let granted = StreamConfig {
+            rate,
+            channels: u16::try_from(ch).unwrap_or(2),
+            block: period,
+        };
+        Ok(DeviceStream::new(
+            "jack",
+            granted,
+            counters,
+            Box::new(JackStream {
+                api,
+                client,
+                shared,
+            }),
+        ))
+    }
+
+    /// The server's port names (for diagnostics and routing UIs).
+    ///
+    /// # Errors
+    /// No JACK, or no server.
+    pub fn ports(&self) -> Result<Vec<String>, BackendError> {
+        let api = Api::load().map_err(BackendError::Unavailable)?;
+        let name = CString::new(format!("{}-probe", self.client_name)).unwrap_or_default();
+        let mut status = 0;
+        // SAFETY: as in `open`.
+        let client = unsafe { (api.client_open)(name.as_ptr(), NO_START_SERVER, &raw mut status) };
+        if client.is_null() {
+            return Err(BackendError::Unavailable("no JACK server running".into()));
+        }
+        let mut out = Vec::new();
+        // SAFETY: a live client; the list is freed with jack_free.
+        unsafe {
+            let list = (api.get_ports)(client, null(), null(), 0);
+            if !list.is_null() {
+                let mut i = 0;
+                while !(*list.add(i)).is_null() {
+                    out.push(cstr(*list.add(i)));
+                    i += 1;
+                }
+                (api.free)(list.cast());
+            }
+            (api.client_close)(client);
+        }
+        Ok(out)
+    }
+}
+
+impl Backend for Jack {
+    fn name(&self) -> &'static str {
+        "jack"
+    }
+
+    fn open_output(
+        &self,
+        config: StreamConfig,
+        render: RenderFn,
+    ) -> Result<DeviceStream, BackendError> {
+        self.open(config, Callback::Render(render))
+    }
+
+    fn open_input(
+        &self,
+        config: StreamConfig,
+        capture: CaptureFn,
+    ) -> Result<DeviceStream, BackendError> {
+        self.open(config, Callback::Capture(capture))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex;
+    use std::time::Duration;
+
+    // These run against a real server when one is reachable (the CI job
+    // starts `jackd -d dummy`); otherwise they check the refusal.
+    #[test]
+    fn renders_through_a_running_server_or_refuses_cleanly() {
+        let seen = Arc::new(Mutex::new((0usize, 0usize, 0.0f64)));
+        let s2 = seen.clone();
+        let jack = Jack {
+            client_name: "vieww-test-out".into(),
+            autoconnect: true,
+        };
+        let r = jack.open_output(
+            StreamConfig::default(),
+            Box::new(move |buf, info| {
+                for (i, v) in buf.iter_mut().enumerate() {
+                    *v = ((i % 64) as f32 / 64.0) - 0.5;
+                }
+                if let Ok(mut g) = s2.try_lock() {
+                    *g = (info.frames, info.channels, info.time);
+                }
+            }),
+        );
+        match r {
+            Ok(stream) => {
+                assert_eq!(stream.backend(), "jack");
+                let c = stream.config();
+                assert!(c.rate >= 8_000 && c.block > 0 && c.channels == 2);
+                assert!(
+                    stream.wait_for(10, Duration::from_secs(10)),
+                    "callbacks run: {:?}",
+                    stream.stats()
+                );
+                let (frames, channels, time) = *seen.lock().unwrap();
+                assert_eq!((frames, channels), (c.block as usize, 2));
+                assert!(time > 0.0);
+                let ports = jack.ports().unwrap();
+                assert!(
+                    ports.iter().any(|p| p == "vieww-test-out:out_1"),
+                    "{ports:?}"
+                );
+                let st = stream.stats();
+                assert_eq!(st.frames, st.callbacks * u64::from(c.block));
+            }
+            Err(e) => {
+                assert!(
+                    !super::super::expected("jack"),
+                    "jack was expected to be running: {e}"
+                );
+                assert!(matches!(e, BackendError::Unavailable(_)), "{e}");
+            }
+        }
+    }
+
+    #[test]
+    fn captures_from_a_running_server_or_refuses_cleanly() {
+        let got = Arc::new(Mutex::new(0usize));
+        let g2 = got.clone();
+        let jack = Jack {
+            client_name: "vieww-test-in".into(),
+            autoconnect: true,
+        };
+        match jack.open_input(
+            StreamConfig {
+                channels: 1,
+                ..StreamConfig::default()
+            },
+            Box::new(move |buf, info| {
+                assert_eq!(buf.len(), info.frames);
+                *g2.lock().unwrap() += buf.len();
+            }),
+        ) {
+            Ok(stream) => {
+                assert!(stream.wait_for(5, Duration::from_secs(10)));
+                drop(stream);
+                assert!(*got.lock().unwrap() > 0);
+            }
+            Err(e) => {
+                assert!(
+                    !super::super::expected("jack"),
+                    "jack was expected to be running: {e}"
+                );
+                assert!(matches!(e, BackendError::Unavailable(_)), "{e}");
+            }
+        }
+    }
+}
diff --git a/vieww_base/crates/vieww-audio/src/backend/mod.rs b/vieww_base/crates/vieww-audio/src/backend/mod.rs
new file mode 100644
index 0000000..b8a2adc
--- /dev/null
+++ b/vieww_base/crates/vieww-audio/src/backend/mod.rs
@@ -0,0 +1,368 @@
+//! Audio devices: one interface over every platform's audio system.
+//!
+//! An audio system is reached through the library the platform ships — a
+//! C ABI loaded at run time (JACK, PipeWire, PulseAudio, AAudio), a COM
+//! interface (WASAPI), a framework (Core Audio) or the kernel itself
+//! (ALSA) — never a binding crate, so this crate keeps its single
+//! dependency, and a machine without a given system gets an honest
+//! [`BackendError::Unavailable`] instead of a link failure.
+//!
+//! Every backend has the same shape. [`Backend::open_output`] takes a
+//! render callback — handed interleaved `f32` frames to fill, on the audio
+//! system's own thread where it has one — and returns a [`DeviceStream`]
+//! that reports the configuration the system actually granted (a JACK
+//! server's rate is the server's, not the caller's), counts callbacks,
+//! frames and xruns, and stops when dropped. [`Backend::open_input`] is
+//! the same for capture.
+//!
+//! [`backends`] lists what this platform offers in preference order, and
+//! [`open_output`] / [`open_input`] take the first that works:
+//!
+//! | Platform | Order |
+//! |---|---|
+//! | Linux | PipeWire, JACK, PulseAudio, ALSA |
+//! | macOS | Core Audio, JACK |
+//! | Windows | WASAPI, JACK |
+//! | Android | AAudio |
+//! | Web | Web Audio |
+
+#[cfg(any(unix, windows))]
+mod dl;
+
+#[cfg(any(target_os = "android", all(unix, vieww_check_all)))]
+pub mod aaudio;
+#[cfg(all(target_os = "linux", not(target_os = "android")))]
+pub mod alsa;
+#[cfg(any(target_os = "macos", vieww_check_all))]
+pub mod coreaudio;
+#[cfg(any(target_os = "linux", target_os = "macos", windows))]
+pub mod jack;
+#[cfg(all(target_os = "linux", not(target_os = "android")))]
+pub mod pipewire;
+#[cfg(all(target_os = "linux", not(target_os = "android")))]
+pub mod pulse;
+#[cfg(any(windows, vieww_check_all))]
+pub mod wasapi;
+#[cfg(any(target_arch = "wasm32", vieww_check_all))]
+pub mod web;
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::Arc;
+
+/// What to ask an audio system for.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct StreamConfig {
+    /// Sample rate (a request: see [`DeviceStream::config`]).
+    pub rate: u32,
+    /// Channels.
+    pub channels: u16,
+    /// Frames per callback, as a latency target.
+    pub block: u32,
+}
+
+impl Default for StreamConfig {
+    fn default() -> Self {
+        Self {
+            rate: 48_000,
+            channels: 2,
+            block: 256,
+        }
+    }
+}
+
+/// Facts about the block a callback is handed.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct BlockInfo {
+    /// Frames in the block.
+    pub frames: usize,
+    /// Channels (interleaved).
+    pub channels: usize,
+    /// Sample rate.
+    pub rate: u32,
+    /// Stream time of the block's first frame, in seconds.
+    pub time: f64,
+}
+
+/// A render callback: fill the interleaved block (it arrives zeroed).
+pub type RenderFn = Box<dyn FnMut(&mut [f32], &BlockInfo) + Send + 'static>;
+/// A capture callback: read the interleaved block.
+pub type CaptureFn = Box<dyn FnMut(&[f32], &BlockInfo) + Send + 'static>;
+
+/// Why a stream did not open.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum BackendError {
+    /// The audio system is not on this machine, or not running.
+    Unavailable(String),
+    /// It is there but refused the stream.
+    Refused(String),
+}
+
+impl std::fmt::Display for BackendError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Unavailable(e) => write!(f, "audio system unavailable: {e}"),
+            Self::Refused(e) => write!(f, "audio system refused the stream: {e}"),
+        }
+    }
+}
+
+impl std::error::Error for BackendError {}
+
+/// Counters a stream keeps (shared with its audio thread).
+#[derive(Debug, Default)]
+pub struct Counters {
+    /// Callbacks run.
+    pub callbacks: AtomicU64,
+    /// Frames rendered or captured.
+    pub frames: AtomicU64,
+    /// Over- and underruns the audio system reported.
+    pub xruns: AtomicU64,
+    /// Set when the stream ended on its own (server shut down, device lost).
+    pub ended: AtomicBool,
+}
+
+/// A snapshot of [`Counters`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub struct StreamStats {
+    /// Callbacks run.
+    pub callbacks: u64,
+    /// Frames rendered or captured.
+    pub frames: u64,
+    /// Xruns.
+    pub xruns: u64,
+    /// Ended on its own.
+    pub ended: bool,
+}
+
+impl Counters {
+    /// Count one callback of `frames`.
+    pub fn block(&self, frames: usize) {
+        self.callbacks.fetch_add(1, Ordering::Relaxed);
+        self.frames.fetch_add(frames as u64, Ordering::Relaxed);
+    }
+
+    fn snapshot(&self) -> StreamStats {
+        StreamStats {
+            callbacks: self.callbacks.load(Ordering::Relaxed),
+            frames: self.frames.load(Ordering::Relaxed),
+            xruns: self.xruns.load(Ordering::Relaxed),
+            ended: self.ended.load(Ordering::Relaxed),
+        }
+    }
+}
+
+/// What a backend's stream implementation provides.
+pub trait StreamImpl: Send {
+    /// Stop (idempotent).
+    fn stop(&mut self);
+}
+
+/// A running stream. Dropping it stops it.
+pub struct DeviceStream {
+    backend: &'static str,
+    config: StreamConfig,
+    counters: Arc<Counters>,
+    inner: Box<dyn StreamImpl>,
+}
+
+impl std::fmt::Debug for DeviceStream {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("DeviceStream")
+            .field("backend", &self.backend)
+            .field("config", &self.config)
+            .field("stats", &self.stats())
+            .finish_non_exhaustive()
+    }
+}
+
+impl DeviceStream {
+    /// Wrap a backend's stream.
+    #[must_use]
+    pub fn new(
+        backend: &'static str,
+        config: StreamConfig,
+        counters: Arc<Counters>,
+        inner: Box<dyn StreamImpl>,
+    ) -> Self {
+        Self {
+            backend,
+            config,
+            counters,
+            inner,
+        }
+    }
+
+    /// The backend's name.
+    #[must_use]
+    pub const fn backend(&self) -> &'static str {
+        self.backend
+    }
+
+    /// The configuration actually granted.
+    #[must_use]
+    pub const fn config(&self) -> StreamConfig {
+        self.config
+    }
+
+    /// The counters.
+    #[must_use]
+    pub fn stats(&self) -> StreamStats {
+        self.counters.snapshot()
+    }
+
+    /// Wait until at least `callbacks` callbacks have run, up to `timeout`.
+    #[must_use]
+    pub fn wait_for(&self, callbacks: u64, timeout: std::time::Duration) -> bool {
+        let t0 = std::time::Instant::now();
+        while self.stats().callbacks < callbacks {
+            if t0.elapsed() > timeout || self.stats().ended {
+                return false;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(2));
+        }
+        true
+    }
+
+    /// Stop now (also done on drop).
+    pub fn stop(&mut self) {
+        self.inner.stop();
+    }
+}
+
+impl Drop for DeviceStream {
+    fn drop(&mut self) {
+        self.inner.stop();
+    }
+}
+
+/// An audio system.
+pub trait Backend: Send + Sync {
+    /// Its name (`"jack"`, `"wasapi"` …).
+    fn name(&self) -> &'static str;
+
+    /// Open a playback stream.
+    ///
+    /// # Errors
+    /// The system is unavailable or refuses.
+    fn open_output(
+        &self,
+        config: StreamConfig,
+        render: RenderFn,
+    ) -> Result<DeviceStream, BackendError>;
+
+    /// Open a capture stream.
+    ///
+    /// # Errors
+    /// As [`open_output`](Self::open_output).
+    fn open_input(
+        &self,
+        config: StreamConfig,
+        capture: CaptureFn,
+    ) -> Result<DeviceStream, BackendError>;
+}
+
+/// The backends this platform offers, in preference order.
+#[must_use]
+pub fn backends() -> Vec<Box<dyn Backend>> {
+    #[allow(unused_mut, reason = "empty on some platforms")]
+    let mut v: Vec<Box<dyn Backend>> = Vec::new();
+    #[cfg(all(target_os = "linux", not(target_os = "android")))]
+    {
+        v.push(Box::new(pipewire::PipeWire));
+        v.push(Box::new(jack::Jack::default()));
+        v.push(Box::new(pulse::Pulse));
+        v.push(Box::new(alsa::Alsa::default()));
+    }
+    #[cfg(target_os = "macos")]
+    {
+        v.push(Box::new(coreaudio::CoreAudio));
+        v.push(Box::new(jack::Jack::default()));
+    }
+    #[cfg(windows)]
+    {
+        v.push(Box::new(wasapi::Wasapi));
+        v.push(Box::new(jack::Jack::default()));
+    }
+    #[cfg(target_os = "android")]
+    v.push(Box::new(aaudio::AAudio));
+    #[cfg(target_arch = "wasm32")]
+    v.push(Box::new(web::WebAudio));
+    v
+}
+
+/// A backend by name.
+#[must_use]
+pub fn backend(name: &str) -> Option<Box<dyn Backend>> {
+    backends().into_iter().find(|b| b.name() == name)
+}
+
+/// Open playback on the first backend that accepts it. The render
+/// callback is built per attempt by `make` (a refused attempt drops it).
+///
+/// # Errors
+/// Every backend failed (the errors, in order).
+pub fn open_output(
+    config: StreamConfig,
+    mut make: impl FnMut() -> RenderFn,
+) -> Result<DeviceStream, Vec<(&'static str, BackendError)>> {
+    let mut errors = Vec::new();
+    for b in backends() {
+        match b.open_output(config, make()) {
+            Ok(s) => return Ok(s),
+            Err(e) => errors.push((b.name(), e)),
+        }
+    }
+    Err(errors)
+}
+
+/// Open capture on the first backend that accepts it.
+///
+/// # Errors
+/// Every backend failed (the errors, in order).
+pub fn open_input(
+    config: StreamConfig,
+    mut make: impl FnMut() -> CaptureFn,
+) -> Result<DeviceStream, Vec<(&'static str, BackendError)>> {
+    let mut errors = Vec::new();
+    for b in backends() {
+        match b.open_input(config, make()) {
+            Ok(s) => return Ok(s),
+            Err(e) => errors.push((b.name(), e)),
+        }
+    }
+    Err(errors)
+}
+
+/// Tests: whether the environment promises this backend is reachable
+/// (`VIEWW_EXPECT_BACKENDS=jack,pulse`), so "unavailable" must fail.
+#[cfg(test)]
+pub(crate) fn expected(name: &str) -> bool {
+    std::env::var("VIEWW_EXPECT_BACKENDS").is_ok_and(|v| v.split(',').any(|n| n.trim() == name))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_platform_lists_its_backends() {
+        let names: Vec<&str> = backends().iter().map(|b| b.name()).collect();
+        #[cfg(all(target_os = "linux", not(target_os = "android")))]
+        assert_eq!(names, ["pipewire", "jack", "pulse", "alsa"]);
+        assert!(backend("no-such-system").is_none());
+        let _ = names;
+    }
+
+    #[test]
+    fn opening_with_nothing_available_reports_every_attempt() {
+        // With no servers reachable every backend says why; with some
+        // running (the CI machine with JACK, say) the first one wins.
+        match open_output(StreamConfig::default(), || Box::new(|_, _| {})) {
+            Ok(s) => assert!(!s.backend().is_empty()),
+            Err(errors) => {
+                assert_eq!(errors.len(), backends().len());
+                assert!(errors.iter().all(|(_, e)| !e.to_string().is_empty()));
+            }
+        }
+    }
+}
diff --git a/vieww_base/crates/vieww-audio/src/backend/pipewire.rs b/vieww_base/crates/vieww-audio/src/backend/pipewire.rs
new file mode 100644
index 0000000..4bd1261
--- /dev/null
+++ b/vieww_base/crates/vieww-audio/src/backend/pipewire.rs
@@ -0,0 +1,646 @@
+//! PipeWire, natively: the audio (and video) server of current Linux
+//! desktops.
+//!
+//! `libpipewire-0.3` is loaded at run time and a `pw_stream` runs on a
+//! `pw_thread_loop`. The format offered is raw interleaved `F32` at the
+//! requested rate and channel count, as an SPA POD object encoded here —
+//! SPA's builders are header-only inline functions, so there is nothing to
+//! call; the encoding is tested byte-for-byte against what
+//! `spa_format_audio_raw_build` produces. The `process` callback runs on
+//! PipeWire's real-time thread and renders straight into the dequeued
+//! buffer, sized by the server's request (the graph's quantum), so nothing
+//! is copied or allocated there. `node.latency` asks for
+//! [`StreamConfig::block`] frames per quantum.
+//!
+//! Opening waits for the stream to reach `PAUSED` or `STREAMING` (or an
+//! error): a machine without a running daemon gets
+//! [`BackendError::Unavailable`] promptly instead of a silent stream.
+
+use std::ffi::{c_char, c_int, c_void, CStr, CString};
+use std::ptr::null_mut;
+use std::sync::atomic::{AtomicI32, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use super::dl::Library;
+use super::{
+    Backend, BackendError, BlockInfo, CaptureFn, Counters, DeviceStream, RenderFn, StreamConfig,
+    StreamImpl,
+};
+
+// SPA constants (spa/utils/type.h, spa/param/*.h), printed from the headers.
+const SPA_TYPE_ID: u32 = 3;
+const SPA_TYPE_INT: u32 = 4;
+const SPA_TYPE_ARRAY: u32 = 13;
+const SPA_TYPE_OBJECT: u32 = 15;
+const SPA_TYPE_OBJECT_FORMAT: u32 = 0x40003;
+const SPA_PARAM_ENUM_FORMAT: u32 = 3;
+const SPA_FORMAT_MEDIA_TYPE: u32 = 1;
+const SPA_FORMAT_MEDIA_SUBTYPE: u32 = 2;
+const SPA_FORMAT_AUDIO_FORMAT: u32 = 0x10001;
+const SPA_FORMAT_AUDIO_RATE: u32 = 0x10003;
+const SPA_FORMAT_AUDIO_CHANNELS: u32 = 0x10004;
+const SPA_FORMAT_AUDIO_POSITION: u32 = 0x10005;
+const SPA_MEDIA_TYPE_AUDIO: u32 = 1;
+const SPA_MEDIA_SUBTYPE_RAW: u32 = 1;
+const SPA_AUDIO_FORMAT_F32: u32 = 0x11b;
+/// FL FR FC LFE RL RR SL SR (spa/param/audio/raw.h channel ids).
+const POSITIONS: [u32; 8] = [3, 4, 5, 6, 8, 9, 10, 11];
+const PW_ID_ANY: u32 = 0xffff_ffff;
+const PW_DIRECTION_INPUT: c_int = 0;
+const PW_DIRECTION_OUTPUT: c_int = 1;
+const FLAG_AUTOCONNECT: u32 = 1 << 0;
+const FLAG_MAP_BUFFERS: u32 = 1 << 2;
+const FLAG_RT_PROCESS: u32 = 1 << 4;
+const STATE_ERROR: c_int = -1;
+const STATE_PAUSED: c_int = 2;
+const STATE_STREAMING: c_int = 3;
+
+/// An SPA POD encoder for the one object audio streams need.
+#[derive(Debug, Default)]
+struct Pod(Vec<u8>);
+
+impl Pod {
+    fn u32(&mut self, v: u32) {
+        self.0.extend_from_slice(&v.to_ne_bytes());
+    }
+
+    fn pad(&mut self) {
+        while !self.0.len().is_multiple_of(8) {
+            self.0.push(0);
+        }
+    }
+
+    fn prop_id(&mut self, key: u32, value: u32) {
+        self.u32(key);
+        self.u32(0);
+        self.u32(4);
+        self.u32(SPA_TYPE_ID);
+        self.u32(value);
+        self.pad();
+    }
+
+    fn prop_int(&mut self, key: u32, value: i32) {
+        self.u32(key);
+        self.u32(0);
+        self.u32(4);
+        self.u32(SPA_TYPE_INT);
+        self.0.extend_from_slice(&value.to_ne_bytes());
+        self.pad();
+    }
+
+    fn prop_id_array(&mut self, key: u32, values: &[u32]) {
+        self.u32(key);
+        self.u32(0);
+        // Array body: the child pod header (size 4, Id), then the values.
+        self.u32(8 + 4 * u32::try_from(values.len()).unwrap_or(0));
+        self.u32(SPA_TYPE_ARRAY);
+        self.u32(4);
+        self.u32(SPA_TYPE_ID);
+        for v in values {
+            self.u32(*v);
+        }
+        self.pad();
+    }
+
+    /// The `EnumFormat` object for raw interleaved `F32` audio.
+    fn audio_format(rate: u32, channels: u32) -> Vec<u8> {
+        let mut body = Self::default();
+        body.u32(SPA_TYPE_OBJECT_FORMAT);
+        body.u32(SPA_PARAM_ENUM_FORMAT);
+        body.prop_id(SPA_FORMAT_MEDIA_TYPE, SPA_MEDIA_TYPE_AUDIO);
+        body.prop_id(SPA_FORMAT_MEDIA_SUBTYPE, SPA_MEDIA_SUBTYPE_RAW);
+        body.prop_id(SPA_FORMAT_AUDIO_FORMAT, SPA_AUDIO_FORMAT_F32);
+        body.prop_int(SPA_FORMAT_AUDIO_RATE, i32::try_from(rate).unwrap_or(48_000));
+        body.prop_int(
+            SPA_FORMAT_AUDIO_CHANNELS,
+            i32::try_from(channels).unwrap_or(2),
+        );
+        if (1..=8).contains(&channels) && channels != 1 {
+            body.prop_id_array(SPA_FORMAT_AUDIO_POSITION, &POSITIONS[..channels as usize]);
+        }
+        let mut pod = Self::default();
+        pod.u32(u32::try_from(body.0.len()).unwrap_or(0));
+        pod.u32(SPA_TYPE_OBJECT);
+        pod.0.extend_from_slice(&body.0);
+        pod.0
+    }
+}
+
+#[repr(C)]
+struct StreamEvents {
+    version: u32,
+    destroy: Option<unsafe extern "C" fn(*mut c_void)>,
+    state_changed: Option<unsafe extern "C" fn(*mut c_void, c_int, c_int, *const c_char)>,
+    control_info: Option<unsafe extern "C" fn(*mut c_void, u32, *const c_void)>,
+    io_changed: Option<unsafe extern "C" fn(*mut c_void, u32, *mut c_void, u32)>,
+    param_changed: Option<unsafe extern "C" fn(*mut c_void, u32, *const c_void)>,
+    add_buffer: Option<unsafe extern "C" fn(*mut c_void, *mut c_void)>,
+    remove_buffer: Option<unsafe extern "C" fn(*mut c_void, *mut c_void)>,
+    process: Option<unsafe extern "C" fn(*mut c_void)>,
+    drained: Option<unsafe extern "C" fn(*mut c_void)>,
+    command: Option<unsafe extern "C" fn(*mut c_void, *const c_void)>,
+    trigger_done: Option<unsafe extern "C" fn(*mut c_void)>,
+}
+
+#[repr(C)]
+struct PwBuffer {
+    buffer: *mut SpaBuffer,
+    user_data: *mut c_void,
+    size: u64,
+    requested: u64,
+}
+
+#[repr(C)]
+struct SpaBuffer {
+    n_metas: u32,
+    n_datas: u32,
+    metas: *mut c_void,
+    datas: *mut SpaData,
+}
+
+#[repr(C)]
+struct SpaData {
+    type_: u32,
+    flags: u32,
+    fd: i64,
+    mapoffset: u32,
+    maxsize: u32,
+    data: *mut c_void,
+    chunk: *mut SpaChunk,
+}
+
+#[repr(C)]
+struct SpaChunk {
+    offset: u32,
+    size: u32,
+    stride: i32,
+    flags: i32,
+}
+
+struct Api {
+    _lib: Library,
+    init: unsafe extern "C" fn(*mut c_int, *mut *mut *mut c_char),
+    thread_loop_new: unsafe extern "C" fn(*const c_char, *const c_void) -> *mut c_void,
+    thread_loop_get_loop: unsafe extern "C" fn(*mut c_void) -> *mut c_void,
+    thread_loop_start: unsafe extern "C" fn(*mut c_void) -> c_int,
+    thread_loop_stop: unsafe extern "C" fn(*mut c_void),
+    thread_loop_lock: unsafe extern "C" fn(*mut c_void),
+    thread_loop_unlock: unsafe extern "C" fn(*mut c_void),
+    thread_loop_destroy: unsafe extern "C" fn(*mut c_void),
+    properties_new: unsafe extern "C" fn(*const c_char, ...) -> *mut c_void,
+    stream_new_simple: unsafe extern "C" fn(
+        *mut c_void,
+        *const c_char,
+        *mut c_void,
+        *const StreamEvents,
+        *mut c_void,
+    ) -> *mut c_void,
+    stream_connect:
+        unsafe extern "C" fn(*mut c_void, c_int, u32, u32, *mut *const c_void, u32) -> c_int,
+    stream_get_state: unsafe extern "C" fn(*mut c_void, *mut *const c_char) -> c_int,
+    stream_dequeue_buffer: unsafe extern "C" fn(*mut c_void) -> *mut PwBuffer,
+    stream_queue_buffer: unsafe extern "C" fn(*mut c_void, *mut PwBuffer) -> c_int,
+    stream_destroy: unsafe extern "C" fn(*mut c_void),
+}
+
+impl Api {
+    fn load() -> Result<Self, String> {
+        let lib = Library::open(&["libpipewire-0.3.so.0", "libpipewire-0.3.so"])?;
+        // SAFETY: the types are libpipewire's documented signatures.
+        unsafe {
+            Ok(Self {
+                init: lib.get(c"pw_init")?,
+                thread_loop_new: lib.get(c"pw_thread_loop_new")?,
+                thread_loop_get_loop: lib.get(c"pw_thread_loop_get_loop")?,
+                thread_loop_start: lib.get(c"pw_thread_loop_start")?,
+                thread_loop_stop: lib.get(c"pw_thread_loop_stop")?,
+                thread_loop_lock: lib.get(c"pw_thread_loop_lock")?,
+                thread_loop_unlock: lib.get(c"pw_thread_loop_unlock")?,
+                thread_loop_destroy: lib.get(c"pw_thread_loop_destroy")?,
+                properties_new: lib.get(c"pw_properties_new")?,
+                stream_new_simple: lib.get(c"pw_stream_new_simple")?,
+                stream_connect: lib.get(c"pw_stream_connect")?,
+                stream_get_state: lib.get(c"pw_stream_get_state")?,
+                stream_dequeue_buffer: lib.get(c"pw_stream_dequeue_buffer")?,
+                stream_queue_buffer: lib.get(c"pw_stream_queue_buffer")?,
+                stream_destroy: lib.get(c"pw_stream_destroy")?,
+                _lib: lib,
+            })
+        }
+    }
+}
+
+enum Callback {
+    Render(RenderFn),
+    Capture(CaptureFn),
+}
+
+struct Shared {
+    api: Arc<Api>,
+    stream: *mut c_void,
+    callback: Callback,
+    channels: usize,
+    rate: u32,
+    counters: Arc<Counters>,
+    frames_done: u64,
+    state: AtomicI32,
+}
+
+unsafe extern "C" fn on_state(data: *mut c_void, _old: c_int, state: c_int, _err: *const c_char) {
+    // SAFETY: `data` is the boxed `Shared` (alive until the stream is
+    // destroyed); only atomics are touched.
+    let s = unsafe { &*data.cast::<Shared>() };
+    s.state.store(state, Ordering::Release);
+    if state == STATE_ERROR {
+        s.counters.ended.store(true, Ordering::Release);
+    }
+}
+
+unsafe extern "C" fn on_process(data: *mut c_void) {
+    // SAFETY: as in `on_state`; PipeWire calls `process` from one thread
+    // at a time, so the exclusive borrow is sound.
+    let s = unsafe { &mut *data.cast::<Shared>() };
+    // SAFETY: a live stream, from its process callback.
+    let b = unsafe { (s.api.stream_dequeue_buffer)(s.stream) };
+    if b.is_null() {
+        return;
+    }
+    // SAFETY: a dequeued buffer is valid until queued again.
+    unsafe {
+        let buf = (*b).buffer;
+        if buf.is_null() || (*buf).n_datas == 0 {
+            (s.api.stream_queue_buffer)(s.stream, b);
+            return;
+        }
+        let d = &mut *(*buf).datas;
+        if d.data.is_null() || d.chunk.is_null() {
+            (s.api.stream_queue_buffer)(s.stream, b);
+            return;
+        }
+        let stride = s.channels * 4;
+        let ch = s.channels;
+        #[expect(clippy::cast_precision_loss, reason = "stream time")]
+        let time = s.frames_done as f64 / f64::from(s.rate);
+        let frames = match &mut s.callback {
+            Callback::Render(r) => {
+                let mut n = d.maxsize as usize / stride;
+                if (*b).requested > 0 {
+                    n = n.min(usize::try_from((*b).requested).unwrap_or(n));
+                }
+                let out = std::slice::from_raw_parts_mut(d.data.cast::<f32>(), n * ch);
+                out.fill(0.0);
+                r(
+                    out,
+                    &BlockInfo {
+                        frames: n,
+                        channels: ch,
+                        rate: s.rate,
+                        time,
+                    },
+                );
+                let c = &mut *d.chunk;
+                c.offset = 0;
+                c.stride = i32::try_from(stride).unwrap_or(8);
+                c.size = u32::try_from(n * stride).unwrap_or(0);
+                (*b).size = n as u64;
+                n
+            }
+            Callback::Capture(cap) => {
+                let c = &*d.chunk;
+                let off = (c.offset % d.maxsize.max(1)) as usize;
+                let size = (c.size as usize).min(d.maxsize as usize - off);
+                let n = size / stride;
+                let input =
+                    std::slice::from_raw_parts(d.data.cast::<u8>().add(off).cast::<f32>(), n * ch);
+                cap(
+                    input,
+                    &BlockInfo {
+                        frames: n,
+                        channels: ch,
+                        rate: s.rate,
+                        time,
+                    },
+                );
+                n
+            }
+        };
+        (s.api.stream_queue_buffer)(s.stream, b);
+        s.frames_done += frames as u64;
+        s.counters.block(frames);
+    }
+}
+
+static EVENTS: StreamEvents = StreamEvents {
+    version: 2,
+    destroy: None,
+    state_changed: Some(on_state),
+    control_info: None,
+    io_changed: None,
+    param_changed: None,
+    add_buffer: None,
+    remove_buffer: None,
+    process: Some(on_process),
+    drained: None,
+    command: None,
+    trigger_done: None,
+};
+
+struct PwStream {
+    api: Arc<Api>,
+    lp: *mut c_void,
+    stream: *mut c_void,
+    shared: *mut Shared,
+}
+
+// SAFETY: the loop and stream are only touched under the loop lock, and
+// `shared` is freed after the stream is destroyed.
+unsafe impl Send for PwStream {}
+
+impl StreamImpl for PwStream {
+    fn stop(&mut self) {
+        if self.lp.is_null() {
+            return;
+        }
+        // SAFETY: the teardown order the thread-loop documentation gives:
+        // destroy the stream under the lock, stop the loop without it.
+        unsafe {
+            (self.api.thread_loop_lock)(self.lp);
+            if !self.stream.is_null() {
+                (self.api.stream_destroy)(self.stream);
+            }
+            (self.api.thread_loop_unlock)(self.lp);
+            (self.api.thread_loop_stop)(self.lp);
+            (self.api.thread_loop_destroy)(self.lp);
+            drop(Box::from_raw(self.shared));
+        }
+        self.lp = null_mut();
+    }
+}
+
+/// The PipeWire backend.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct PipeWire;
+
+fn daemon_socket_present() -> bool {
+    if std::env::var_os("PIPEWIRE_REMOTE").is_some() {
+        return true;
+    }
+    let Some(dir) =
+        std::env::var_os("PIPEWIRE_RUNTIME_DIR").or_else(|| std::env::var_os("XDG_RUNTIME_DIR"))
+    else {
+        return false;
+    };
+    std::path::Path::new(&dir).join("pipewire-0").exists()
+}
+
+fn open(config: StreamConfig, callback: Callback) -> Result<DeviceStream, BackendError> {
+    if !daemon_socket_present() {
+        return Err(BackendError::Unavailable(
+            "no PipeWire daemon socket".into(),
+        ));
+    }
+    let api = Arc::new(Api::load().map_err(BackendError::Unavailable)?);
+    let capture = matches!(callback, Callback::Capture(_));
+    let ch = u32::from(config.channels.clamp(1, 64));
+    let latency =
+        CString::new(format!("{}/{}", config.block.max(16), config.rate)).unwrap_or_default();
+    let counters = Arc::new(Counters::default());
+    let shared = Box::into_raw(Box::new(Shared {
+        api: api.clone(),
+        stream: null_mut(),
+        callback,
+        channels: ch as usize,
+        rate: config.rate,
+        counters: counters.clone(),
+        frames_done: 0,
+        state: AtomicI32::new(0),
+    }));
+    let pod = Pod::audio_format(config.rate, ch);
+    // SAFETY: the pw_* calls follow the thread-loop protocol (create and
+    // connect under the lock); strings and the POD outlive the calls.
+    unsafe {
+        (api.init)(null_mut(), null_mut());
+        let lp = (api.thread_loop_new)(c"vieww-pipewire".as_ptr(), std::ptr::null());
+        if lp.is_null() {
+            drop(Box::from_raw(shared));
+            return Err(BackendError::Unavailable(
+                "pw_thread_loop_new failed".into(),
+            ));
+        }
+        let props = (api.properties_new)(
+            c"media.type".as_ptr(),
+            c"Audio".as_ptr(),
+            c"media.category".as_ptr(),
+            if capture {
+                c"Capture".as_ptr()
+            } else {
+                c"Playback".as_ptr()
+            },
+            c"media.role".as_ptr(),
+            c"Music".as_ptr(),
+            c"node.latency".as_ptr(),
+            latency.as_ptr(),
+            std::ptr::null::<c_char>(),
+        );
+        (api.thread_loop_lock)(lp);
+        let stream = (api.stream_new_simple)(
+            (api.thread_loop_get_loop)(lp),
+            c"vieww".as_ptr(),
+            props,
+            &raw const EVENTS,
+            shared.cast(),
+        );
+        if stream.is_null() {
+            (api.thread_loop_unlock)(lp);
+            (api.thread_loop_destroy)(lp);
+            drop(Box::from_raw(shared));
+            return Err(BackendError::Unavailable(
+                "pw_stream_new_simple failed".into(),
+            ));
+        }
+        (*shared).stream = stream;
+        let mut params = [pod.as_ptr().cast::<c_void>()];
+        let r = (api.stream_connect)(
+            stream,
+            if capture {
+                PW_DIRECTION_INPUT
+            } else {
+                PW_DIRECTION_OUTPUT
+            },
+            PW_ID_ANY,
+            FLAG_AUTOCONNECT | FLAG_MAP_BUFFERS | FLAG_RT_PROCESS,
+            params.as_mut_ptr(),
+            1,
+        );
+        let started = r >= 0 && (api.thread_loop_start)(lp) >= 0;
+        (api.thread_loop_unlock)(lp);
+        let mut handle = PwStream {
+            api: api.clone(),
+            lp,
+            stream,
+            shared,
+        };
+        if !started {
+            handle.stop();
+            return Err(BackendError::Refused(format!(
+                "pw_stream_connect failed ({r})"
+            )));
+        }
+        // Wait for the connection to settle.
+        let t0 = Instant::now();
+        loop {
+            let st = (*shared).state.load(Ordering::Acquire);
+            if st == STATE_PAUSED || st == STATE_STREAMING {
+                break;
+            }
+            if st == STATE_ERROR || t0.elapsed() > Duration::from_secs(3) {
+                (api.thread_loop_lock)(lp);
+                let mut err = std::ptr::null();
+                (api.stream_get_state)(stream, &raw mut err);
+                let msg = if err.is_null() {
+                    "the stream did not connect".to_owned()
+                } else {
+                    CStr::from_ptr(err).to_string_lossy().into_owned()
+                };
+                (api.thread_loop_unlock)(lp);
+                handle.stop();
+                return Err(BackendError::Unavailable(msg));
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        Ok(DeviceStream::new(
+            "pipewire",
+            StreamConfig {
+                rate: config.rate,
+                channels: u16::try_from(ch).unwrap_or(2),
+                block: config.block.max(16),
+            },
+            counters,
+            Box::new(handle),
+        ))
+    }
+}
+
+impl Backend for PipeWire {
+    fn name(&self) -> &'static str {
+        "pipewire"
+    }
+
+    fn open_output(
+        &self,
+        config: StreamConfig,
+        render: RenderFn,
+    ) -> Result<DeviceStream, BackendError> {
+        open(config, Callback::Render(render))
+    }
+
+    fn open_input(
+        &self,
+        config: StreamConfig,
+        capture: CaptureFn,
+    ) -> Result<DeviceStream, BackendError> {
+        open(config, Callback::Capture(capture))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// `spa_format_audio_raw_build(EnumFormat, {F32, 48000, 2, [FL, FR]})`
+    /// as printed by a C program compiled against the SPA headers.
+    const REFERENCE: &str = "a00000000f000000 0300040003000000 0100000000000000 0400000003000000 \
+        0100000000000000 0200000000000000 0400000003000000 0100000000000000 0100010000000000 \
+        0400000003000000 1b01000000000000 0300010000000000 0400000004000000 80bb000000000000 \
+        0400010000000000 0400000004000000 0200000000000000 0500010000000000 100000000d000000 \
+        0400000003000000 0300000004000000";
+
+    #[test]
+    #[cfg(target_endian = "little")]
+    fn the_format_pod_matches_spa_byte_for_byte() {
+        let want: Vec<u8> = REFERENCE
+            .split_whitespace()
+            .flat_map(|w| {
+                (0..w.len())
+                    .step_by(2)
+                    .map(move |i| u8::from_str_radix(&w[i..i + 2], 16).unwrap())
+            })
+            .collect();
+        assert_eq!(Pod::audio_format(48_000, 2), want);
+        // Mono has no position array; the size field follows.
+        let mono = Pod::audio_format(44_100, 1);
+        assert_eq!(
+            u32::from_ne_bytes(mono[0..4].try_into().unwrap()) as usize,
+            mono.len() - 8
+        );
+        assert_eq!(mono.len() % 8, 0);
+    }
+
+    #[test]
+    fn the_buffer_structs_have_the_header_layouts() {
+        assert_eq!(size_of::<StreamEvents>(), 96);
+        // The C struct is 40 bytes (a later `time` field); PipeWire owns
+        // it and this side only reads the first four fields through a
+        // pointer, so declaring those is exact.
+        assert_eq!(size_of::<PwBuffer>(), 32);
+        assert_eq!(size_of::<SpaBuffer>(), 24);
+        assert_eq!(size_of::<SpaData>(), 40);
+        assert_eq!(std::mem::offset_of!(SpaData, data), 24);
+        assert_eq!(std::mem::offset_of!(SpaData, chunk), 32);
+        assert_eq!(size_of::<SpaChunk>(), 16);
+    }
+
+    #[test]
+    fn plays_through_a_running_daemon_or_refuses_cleanly() {
+        match PipeWire.open_output(
+            StreamConfig::default(),
+            Box::new(|buf, info| {
+                assert_eq!(buf.len(), info.frames * info.channels);
+                for v in buf.iter_mut() {
+                    *v = 0.01;
+                }
+            }),
+        ) {
+            Ok(stream) => {
+                assert_eq!(stream.backend(), "pipewire");
+                assert!(
+                    stream.wait_for(10, Duration::from_secs(10)),
+                    "{:?}",
+                    stream.stats()
+                );
+            }
+            Err(e) => {
+                assert!(
+                    !super::super::expected("pipewire"),
+                    "pipewire was expected to be running: {e}"
+                );
+                assert!(matches!(e, BackendError::Unavailable(_)), "{e}");
+            }
+        }
+    }
+
+    #[test]
+    fn captures_through_a_running_daemon_or_refuses_cleanly() {
+        match PipeWire.open_input(
+            StreamConfig {
+                channels: 1,
+                ..StreamConfig::default()
+            },
+            Box::new(|buf, info| assert_eq!(buf.len(), info.frames * info.channels)),
+        ) {
+            Ok(stream) => assert!(
+                stream.wait_for(5, Duration::from_secs(10)),
+                "{:?}",
+                stream.stats()
+            ),
+            Err(e) => {
+                assert!(
+                    !super::super::expected("pipewire"),
+                    "pipewire was expected to be running: {e}"
+                );
+                assert!(matches!(e, BackendError::Unavailable(_)), "{e}");
+            }
+        }
+    }
+}
