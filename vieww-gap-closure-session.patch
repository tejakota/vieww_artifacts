+        unsafe extern "system" fn(this: *mut c_void, id: ParamID, value: ParamValue) -> ParamValue,
+    pub getParamNormalized: unsafe extern "system" fn(this: *mut c_void, id: ParamID) -> ParamValue,
+    pub setParamNormalized:
