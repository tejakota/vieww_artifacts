+//! Synthesis — the instrument half of the crate.
+//!
+//! The crate root's [`Tone`](crate::Tone) is a *pulse*: a UI click, a chime.
+//! This module is for *notes*: things held, released, played in chords and
+//! shaped while they sound. It is what Serum, Vital, a DX7, a Prophet VS and
+//! Web Audio's oscillator and periodic-wave nodes provide, built on the same
+//! rule as everything else here — every generator is a state machine stepped
+//! one sample at a time at a fixed rate, with no clock, no allocation in the
+//! step, and no randomness that is not seeded. Render the same patch twice
+//! and the buffers are equal.
+//!
+//! | Module | What it is | Reference point |
+//! |---|---|---|
+//! | [`envelope`] | ADSR, DAHDSR, any-stage envelopes with curves, loops and velocity | every synth |
+//! | [`osc`] | band-limited (PolyBLEP/BLAMP) oscillators, pulse width, hard and soft sync | analog-modelled VAs |
+//! | [`noise`] | white, pink, brown, blue/violet, filtered and crackle noise | `WhiteNoise`/`PinkNoise` UGens |
+//! | [`wavetable`] | mip-mapped band-limited tables, frame morphing, periodic waves from Fourier coefficients | Serum, Vital, `PeriodicWave` |
+//! | [`additive`] | partials with their own ratios, amplitudes and envelopes | Kawai K5, Harmor |
+//! | [`vector`] | four-source joystick morphing with a path | Prophet VS, Wavestation |
+//! | [`fm`] | six-operator phase/frequency modulation, the 32 DX7 algorithms, feedback | Yamaha DX7, FM8 |
+//! | [`voice`] | polyphony, voice stealing, unison, legato/glide, MPE | every poly synth |
+//!
+//! Granular, physical-modelling and sample-based synthesis live in
+//! [`granular`], [`physical`] and [`sampler`].
+
+pub mod additive;
+pub mod envelope;
+pub mod fm;
+pub mod granular;
+pub mod noise;
+pub mod osc;
+pub mod physical;
+pub mod sampler;
+pub mod vector;
+pub mod voice;
+pub mod wavetable;
+
+use crate::Samples;
+
+/// Anything that produces one sample per call at a fixed rate.
+///
+/// The trait every source in [`synth`](self) implements, so a vector
+/// synth's four corners, a granulator's source or a modulation input can be
+/// any of them.
+pub trait Generator {
+    /// The next sample.
+    fn next_sample(&mut self) -> f32;
+
+    /// Fill `out` with the next `out.len()` samples.
+    fn fill(&mut self, out: &mut [f32]) {
+        for s in out {
+            *s = self.next_sample();
+        }
+    }
+
+    /// Render `frames` samples into a mono buffer at `rate`.
+    fn render(&mut self, frames: usize, rate: u32) -> Samples {
+        let mut data = vec![0.0; frames];
+        self.fill(&mut data);
+        Samples::mono(data, rate)
+    }
+}
+
+impl<G: Generator + ?Sized> Generator for Box<G> {
+    fn next_sample(&mut self) -> f32 {
+        (**self).next_sample()
+    }
+}
+
+/// A constant — the simplest generator, and a useful corner for a vector
+/// synth or a DC offset into a modulation slot.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Constant(pub f32);
+
+impl Generator for Constant {
+    fn next_sample(&mut self) -> f32 {
+        self.0
+    }
+}
+
+/// A generator from a closure.
+pub struct FnGenerator<F: FnMut() -> f32>(pub F);
+
+impl<F: FnMut() -> f32> std::fmt::Debug for FnGenerator<F> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("FnGenerator")
+    }
+}
+
+impl<F: FnMut() -> f32> Generator for FnGenerator<F> {
+    fn next_sample(&mut self) -> f32 {
+        (self.0)()
+    }
+}
+
+/// Seconds to samples at `rate`, rounded, never negative.
+#[expect(
+    clippy::cast_possible_truncation,
+    clippy::cast_sign_loss,
+    reason = "clamped non-negative and far below usize::MAX"
+)]
+pub(crate) fn secs_to_samples(seconds: f32, rate: f32) -> usize {
+    (seconds.max(0.0) * rate).round() as usize
+}
+
+/// Equal-power pan of a mono value: `p` in `-1..=1`.
+#[must_use]
+pub fn equal_power(p: f32) -> (f32, f32) {
+    let a = (p.clamp(-1.0, 1.0) + 1.0) * std::f32::consts::FRAC_PI_4;
+    (a.cos(), a.sin())
+}
+
+#[cfg(test)]
+pub(crate) mod testing {
+    //! Spectral helpers the synthesis tests share.
+    use crate::fft::{next_pow2, Plan};
+
+    /// Magnitude spectrum (Hann-windowed, normalised so a full-scale sine
+    /// at a bin centre reads ~0.5 there) of `x`, with the bin width in Hz.
+    pub(crate) fn spectrum(x: &[f32], rate: f32) -> (Vec<f64>, f64) {
+        let n = next_pow2(x.len()) / if x.len().is_power_of_two() { 1 } else { 2 };
+        let n = n.max(2);
+        let plan = Plan::new(n);
+        #[expect(clippy::cast_precision_loss, reason = "test sizes")]
+        let mut buf: Vec<crate::fft::Complex> = (0..n)
+            .map(|i| {
+                let w = 0.5 - 0.5 * (std::f64::consts::TAU * i as f64 / n as f64).cos();
+                crate::fft::Complex::new(f64::from(x[i]) * w, 0.0)
+            })
+            .collect();
+        plan.forward(&mut buf);
+        #[expect(clippy::cast_precision_loss, reason = "test sizes")]
+        let norm = 2.0 / (n as f64 * 0.5);
+        let mags = buf[..n / 2].iter().map(|z| z.norm() * norm / 2.0).collect();
+        #[expect(clippy::cast_precision_loss, reason = "test sizes")]
+        (mags, f64::from(rate) / n as f64)
+    }
+
+    /// Peak magnitude within ±`width` bins of `hz`.
+    pub(crate) fn level_near(mags: &[f64], bin_hz: f64, hz: f64, width: usize) -> f64 {
+        #[expect(
+            clippy::cast_possible_truncation,
+            clippy::cast_sign_loss,
+            reason = "test"
+        )]
+        let c = (hz / bin_hz).round() as usize;
+        let lo = c.saturating_sub(width);
+        let hi = (c + width).min(mags.len() - 1);
+        mags[lo..=hi].iter().copied().fold(0.0, f64::max)
+    }
+
+    /// RMS of a slice.
+    pub(crate) fn rms(x: &[f32]) -> f64 {
+        #[expect(clippy::cast_precision_loss, reason = "test")]
+        let n = x.len().max(1) as f64;
+        (x.iter().map(|v| f64::from(*v).powi(2)).sum::<f64>() / n).sqrt()
+    }
+}
diff --git a/vieww_base/crates/vieww-audio/src/synth/noise.rs b/vieww_base/crates/vieww-audio/src/synth/noise.rs
new file mode 100644
index 0000000..2e203a3
--- /dev/null
+++ b/vieww_base/crates/vieww-audio/src/synth/noise.rs
@@ -0,0 +1,242 @@
+//! Noise — the raw material of percussion, breath, wind and texture.
+//!
+//! Every colour is a seeded [`Rng`](crate::rng::Rng) shaped by a filter, so
+//! a hi-hat rendered twice is the same hi-hat. The colours are named by their
+//! spectral slope:
+//!
+//! | Colour | Slope | How |
+//! |---|---|---|
+//! | [`White`](Colour::White) | flat | uniform deviates |
+//! | [`Pink`](Colour::Pink) | −3 dB/oct | Paul Kellet's refined seven-pole filter |
+//! | [`Brown`](Colour::Brown) | −6 dB/oct | leaky integrator of white |
+//! | [`Blue`](Colour::Blue) | +3 dB/oct | first difference of pink |
+//! | [`Violet`](Colour::Violet) | +6 dB/oct | first difference of white |
+//! | [`Velvet`](Colour::Velvet) | flat, sparse | ±1 impulses at a density — reverb tails, crackle |
+//!
+//! [`Noise::gain`] normalises each colour to roughly the same RMS so
+//! switching colour does not also switch loudness.
+
+use crate::rng::Rng;
+
+/// A noise colour.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Colour {
+    /// Flat spectrum.
+    White,
+    /// −3 dB/octave.
+    Pink,
+    /// −6 dB/octave (Brownian / red).
+    Brown,
+    /// +3 dB/octave.
+    Blue,
+    /// +6 dB/octave.
+    Violet,
+    /// Sparse random ±1 impulses, `density` per second.
+    Velvet {
+        /// Impulses per second.
+        density: f32,
+    },
+}
+
+/// A seeded noise generator.
+#[derive(Debug, Clone)]
+pub struct Noise {
+    colour: Colour,
+    rng: Rng,
+    rate: f32,
+    b: [f32; 7],
+    brown: f32,
+    prev: f32,
+    gain: f32,
+}
+
+impl Noise {
+    /// A noise source of `colour`, seeded, at `rate`.
+    #[must_use]
+    pub fn new(colour: Colour, seed: u64, rate: f32) -> Self {
+        let gain = match colour {
+            Colour::White => 1.0,
+            Colour::Pink => 0.33,
+            Colour::Brown => 3.5,
+            Colour::Blue => 0.7,
+            Colour::Violet => 0.5,
+            Colour::Velvet { .. } => 1.0,
+        };
+        Self {
+            colour,
+            rng: Rng::new(seed),
+            rate,
+            b: [0.0; 7],
+            brown: 0.0,
+            prev: 0.0,
+            gain,
+        }
+    }
+
+    /// The normalising gain applied to this colour.
+    #[must_use]
+    pub const fn gain(&self) -> f32 {
+        self.gain
+    }
+
+    fn pink(&mut self, white: f32) -> f32 {
+        let b = &mut self.b;
+        b[0] = 0.99886 * b[0] + white * 0.055_518;
+        b[1] = 0.99332 * b[1] + white * 0.075_075_9;
+        b[2] = 0.96900 * b[2] + white * 0.153_852;
+        b[3] = 0.86650 * b[3] + white * 0.310_485_6;
+        b[4] = 0.55000 * b[4] + white * 0.532_952_2;
+        b[5] = -0.7616 * b[5] - white * 0.016_898_0;
+        let out = b[0] + b[1] + b[2] + b[3] + b[4] + b[5] + b[6] + white * 0.5362;
+        b[6] = white * 0.115_926;
+        out
+    }
+
+    /// The next sample.
+    pub fn tick(&mut self) -> f32 {
+        let w = self.rng.bipolar();
+        let v = match self.colour {
+            Colour::White => w,
+            Colour::Pink => self.pink(w),
+            Colour::Brown => {
+                self.brown = (self.brown + 0.02 * w) * 0.998;
+                self.brown
+            }
+            Colour::Blue => {
+                let p = self.pink(w);
+                let d = p - self.prev;
+                self.prev = p;
+                d
+            }
+            Colour::Violet => {
+                let d = w - self.prev;
+                self.prev = w;
+                d
+            }
+            Colour::Velvet { density } => {
+                let p = (density / self.rate).clamp(0.0, 1.0);
+                #[expect(clippy::cast_possible_truncation, reason = "probability")]
+                let roll = self.rng.next_f64() as f32;
+                if roll < p {
+                    if self.rng.next_u64() & 1 == 0 {
+                        1.0
+                    } else {
+                        -1.0
+                    }
+                } else {
+                    0.0
+                }
+            }
+        };
+        v * self.gain
+    }
+}
+
+impl super::Generator for Noise {
+    fn next_sample(&mut self) -> f32 {
+        self.tick()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::synth::testing::rms;
+    use crate::synth::Generator;
+
+    const RATE: f32 = 48_000.0;
+
+    /// Average power in an octave band, from many averaged FFT frames.
+    fn band_power(colour: Colour, lo: f64, hi: f64) -> f64 {
+        use crate::fft::{Complex, Plan};
+        let n = 4096;
+        let plan = Plan::new(n);
+        let mut src = Noise::new(colour, 11, RATE);
+        let mut acc = vec![0.0; n / 2];
+        for _ in 0..64 {
+            let mut buf: Vec<Complex> = (0..n)
+                .map(|_| Complex::new(f64::from(src.tick()), 0.0))
+                .collect();
+            plan.forward(&mut buf);
+            for (a, z) in acc.iter_mut().zip(&buf) {
+                *a += z.norm().powi(2);
+            }
+        }
+        #[expect(clippy::cast_precision_loss, reason = "test")]
+        let bin = f64::from(RATE) / n as f64;
+        let mut p = 0.0;
+        let mut count = 0.0;
+        for (k, a) in acc.iter().enumerate() {
+            #[expect(clippy::cast_precision_loss, reason = "test")]
+            let hz = k as f64 * bin;
+            if hz >= lo && hz < hi {
+                p += a;
+                count += 1.0;
+            }
+        }
+        p / count
+    }
+
+    /// dB change in per-bin power from one octave to the next.
+    fn slope(colour: Colour) -> f64 {
+        let a = band_power(colour, 500.0, 1000.0);
+        let b = band_power(colour, 2000.0, 4000.0);
+        10.0 * (b / a).log10() / 2.0
+    }
+
+    #[test]
+    fn white_is_flat() {
+        assert!(slope(Colour::White).abs() < 0.5, "{}", slope(Colour::White));
+    }
+
+    #[test]
+    fn pink_falls_three_db_per_octave() {
+        let s = slope(Colour::Pink);
+        assert!((s + 3.0).abs() < 0.7, "{s}");
+    }
+
+    #[test]
+    fn brown_falls_six_db_per_octave() {
+        let s = slope(Colour::Brown);
+        assert!((s + 6.0).abs() < 1.0, "{s}");
+    }
+
+    #[test]
+    fn violet_rises_six_and_blue_three() {
+        let v = slope(Colour::Violet);
+        assert!((v - 6.0).abs() < 1.0, "{v}");
+        let b = slope(Colour::Blue);
+        assert!((b - 3.0).abs() < 1.2, "{b}");
+    }
+
+    #[test]
+    fn colours_are_loudness_matched() {
+        for c in [
+            Colour::White,
+            Colour::Pink,
+            Colour::Brown,
+            Colour::Blue,
+            Colour::Violet,
+        ] {
+            let x = Noise::new(c, 3, RATE).render(96_000, 48_000).data;
+            let r = rms(&x);
+            assert!((0.25..0.9).contains(&r), "{c:?} rms {r}");
+        }
+    }
+
+    #[test]
+    fn velvet_density_is_respected() {
+        let x = Noise::new(Colour::Velvet { density: 2000.0 }, 5, RATE)
+            .render(48_000, 48_000)
+            .data;
+        let n = x.iter().filter(|v| **v != 0.0).count();
+        assert!((1800..2200).contains(&n), "{n} impulses");
+    }
+
+    #[test]
+    fn seeded_noise_is_reproducible() {
+        let a = Noise::new(Colour::Pink, 9, RATE).render(1000, 48_000);
+        let b = Noise::new(Colour::Pink, 9, RATE).render(1000, 48_000);
+        assert_eq!(a, b);
+    }
+}
diff --git a/vieww_base/crates/vieww-audio/src/synth/osc.rs b/vieww_base/crates/vieww-audio/src/synth/osc.rs
new file mode 100644
index 0000000..7b07319
--- /dev/null
+++ b/vieww_base/crates/vieww-audio/src/synth/osc.rs
@@ -0,0 +1,480 @@
+//! Band-limited oscillators, pulse-width modulation, and oscillator sync.
+//!
+//! The crate root's [`Waveform`](crate::Waveform) is *naive*: a saw is a
+//! straight line that jumps, and a jump contains every frequency at once.
+//! Above a few hundred hertz the harmonics the jump implies pass the Nyquist
+//! rate and fold back down as inharmonic tones — aliasing, the metallic
+//! whine of a cheap synth. That is fine for a 5 ms click and wrong for a
+//! held note.
+//!
+//! [`Oscillator`] removes it with PolyBLEP (a polynomial band-limited step
+//! subtracted at every jump) for saw, square and pulse, and PolyBLAMP (the
+//! integrated version, for every *kink*) for the triangle. Both are two-sample
+//! corrections: cheap, stateless across cycles, and good to roughly −60 dB of
+//! alias suppression across the musical range — the technique Välimäki and
+//! Huovilainen describe and every virtual-analog synth since has used.
+//!
+//! [`Sync`] pairs two oscillators: a *master* whose every cycle restarts the
+//! *slave* (hard sync — the tearing lead sound), or reverses it (soft sync).
+//! The restart is a jump of its own, and it is corrected with the same
+//! PolyBLEP, placed at the sub-sample instant the master wrapped.
+
+/// An oscillator shape.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Shape {
+    /// A sine — no harmonics, nothing to band-limit.
+    Sine,
+    /// Falling saw from +1 to −1, every harmonic at `1/n`.
+    Saw,
+    /// Square — a pulse at 50% duty, odd harmonics.
+    Square,
+    /// Pulse at the given duty cycle in `0.01..=0.99`.
+    Pulse(f32),
+    /// Triangle, odd harmonics at `1/n²`.
+    Triangle,
+}
+
+/// A PolyBLEP/BLAMP band-limited oscillator.
+#[derive(Debug, Clone)]
+pub struct Oscillator {
+    shape: Shape,
+    rate: f64,
+    phase: f64,
+    inc: f64,
+    direction: f64,
+}
+
+/// The two-sample polynomial band-limited step residual for a *falling*
+/// unit-height (2.0 peak-to-peak) discontinuity at phase 0.
+fn blep(t: f64, dt: f64) -> f64 {
+    if dt <= 0.0 {
+        return 0.0;
+    }
+    if t < dt {
+        let x = t / dt;
+        2.0 * x - x * x - 1.0
+    } else if t > 1.0 - dt {
+        let x = (t - 1.0) / dt;
+        x * x + 2.0 * x + 1.0
+    } else {
+        0.0
+    }
+}
+
+/// The integrated residual — for a slope discontinuity at phase 0.
+fn blamp(t: f64, dt: f64) -> f64 {
+    if dt <= 0.0 {
+        return 0.0;
+    }
+    if t < dt {
+        let x = t / dt - 1.0;
+        -x * x * x / 3.0
+    } else if t > 1.0 - dt {
+        let x = (t - 1.0) / dt + 1.0;
+        x * x * x / 3.0
+    } else {
+        0.0
+    }
+}
+
+impl Oscillator {
+    /// An oscillator at `hz`, rendering at `rate`.
+    #[must_use]
+    pub fn new(shape: Shape, hz: f32, rate: f32) -> Self {
+        let mut o = Self {
+            shape,
+            rate: f64::from(rate),
+            phase: 0.0,
+            inc: 0.0,
+            direction: 1.0,
+        };
+        o.set_frequency(hz);
+        o
+    }
+
+    /// Change pitch without resetting phase (so glides are continuous).
+    pub fn set_frequency(&mut self, hz: f32) {
+        self.inc = (f64::from(hz) / self.rate).clamp(0.0, 0.5);
+    }
+
+    /// The current frequency in Hz.
+    #[must_use]
+    #[expect(clippy::cast_possible_truncation, reason = "audio frequencies fit f32")]
+    pub fn frequency(&self) -> f32 {
+        (self.inc * self.rate) as f32
+    }
+
+    /// Change shape (pulse width modulation is `set_shape(Shape::Pulse(w))`).
+    pub const fn set_shape(&mut self, shape: Shape) {
+        self.shape = shape;
+    }
+
+    /// Set the phase in turns, `0..1`.
+    pub fn set_phase(&mut self, turns: f64) {
+        self.phase = turns.rem_euclid(1.0);
+    }
+
+    /// The phase in turns.
+    #[must_use]
+    pub const fn phase(&self) -> f64 {
+        self.phase
+    }
+
+    /// The per-sample phase increment.
+    #[must_use]
+    pub const fn increment(&self) -> f64 {
+        self.inc
+    }
+
+    /// The naive (un-band-limited) value at phase `t`.
+    fn naive(&self, t: f64) -> f64 {
+        match self.shape {
+            Shape::Sine => (std::f64::consts::TAU * t).sin(),
+            Shape::Saw => 1.0 - 2.0 * t,
+            Shape::Square => {
+                if t < 0.5 {
+                    1.0
+                } else {
+                    -1.0
+                }
+            }
+            Shape::Pulse(w) => {
+                if t < f64::from(w.clamp(0.01, 0.99)) {
+                    1.0
+                } else {
+                    -1.0
+                }
+            }
+            Shape::Triangle => 4.0 * (t - 0.5).abs() - 1.0,
+        }
+    }
+
+    /// The band-limited value at the current phase.
+    fn value(&self) -> f64 {
+        let t = self.phase;
+        let dt = self.inc;
+        let v = self.naive(t);
+        match self.shape {
+            Shape::Sine => v,
+            // The saw rises back from −1 to +1 at t=0: an upward step of 2.
+            Shape::Saw => v + blep(t, dt),
+            Shape::Square => v + blep(t, dt) - blep((t + 0.5).rem_euclid(1.0), dt),
+            Shape::Pulse(w) => {
+                let w = f64::from(w.clamp(0.01, 0.99));
+                v + blep(t, dt) - blep((t + 1.0 - w).rem_euclid(1.0), dt)
+            }
+            // Triangle: the slope changes by +8 per cycle at its minimum
+            // (t = 0.5) and by −8 at its maximum (t = 0). A BLAMP residual
+            // for a slope change Δ is Δ·dt/2 × `blamp`.
+            Shape::Triangle => v + 4.0 * dt * (blamp((t + 0.5).rem_euclid(1.0), dt) - blamp(t, dt)),
+        }
+    }
+
+    /// Advance one sample, returning the value.
+    #[expect(clippy::cast_possible_truncation, reason = "output is f32 audio")]
+    pub fn tick(&mut self) -> f32 {
+        let v = self.value();
+        self.advance();
+        v as f32
+    }
+
+    /// Advance one sample with a phase offset (phase modulation, in turns).
+    #[expect(clippy::cast_possible_truncation, reason = "output is f32 audio")]
+    pub fn next_pm(&mut self, offset_turns: f64) -> f32 {
+        let saved = self.phase;
+        self.phase = (self.phase + offset_turns).rem_euclid(1.0);
+        let v = self.value();
+        self.phase = saved;
+        self.advance();
+        v as f32
+    }
+
+    fn advance(&mut self) {
+        self.phase += self.inc * self.direction;
+        self.phase = self.phase.rem_euclid(1.0);
+    }
+}
+
+impl super::Generator for Oscillator {
+    fn next_sample(&mut self) -> f32 {
+        self.tick()
+    }
+}
+
+/// How a master restarts its slave.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SyncMode {
+    /// Reset the slave's phase to 0 on every master cycle.
+    Hard,
+    /// Reverse the slave's direction on every master cycle.
+    Soft,
+}
+
+/// Two oscillators in sync: the slave is heard; the master only clocks it.
+///
+/// Output is one sample late, because a PolyBLEP for a jump between two
+/// samples has to correct the sample *before* the jump too.
+#[derive(Debug, Clone)]
+pub struct Sync {
+    /// The heard oscillator — its pitch is the *timbre* knob.
+    pub slave: Oscillator,
+    master_phase: f64,
+    master_inc: f64,
+    mode: SyncMode,
+    pending: f64,
+}
+
+impl Sync {
+    /// A synced pair: `master_hz` sets the pitch heard, `slave` the timbre.
+    #[must_use]
+    pub fn new(slave: Oscillator, master_hz: f32, mode: SyncMode) -> Self {
+        let master_inc = (f64::from(master_hz) / slave.rate).clamp(0.0, 0.5);
+        Self {
+            slave,
+            master_phase: 0.0,
+            master_inc,
+            mode,
+            pending: 0.0,
+        }
+    }
+
+    /// Change the master pitch.
+    pub fn set_master_frequency(&mut self, hz: f32) {
+        self.master_inc = (f64::from(hz) / self.slave.rate).clamp(0.0, 0.5);
+    }
+
+    /// The next sample.
+    #[expect(clippy::cast_possible_truncation, reason = "output is f32 audio")]
+    pub fn tick(&mut self) -> f32 {
+        self.master_phase += self.master_inc;
+        let wrapped = self.master_phase >= 1.0;
+        let mut current;
+        let mut correction_prev = 0.0;
+        if wrapped {
+            self.master_phase -= 1.0;
+            // `d`: how far past the wrap (in samples) this sample sits.
+            let d = if self.master_inc > 0.0 {
+                (self.master_phase / self.master_inc).clamp(0.0, 1.0)
+            } else {
+                0.0
+            };
+            match self.mode {
+                SyncMode::Hard => {
+                    let slave_inc = self.slave.inc;
+                    let before_phase = (self.slave.phase + slave_inc * (1.0 - d)).rem_euclid(1.0);
+                    let before = self.slave.naive(before_phase);
+                    let after = self.slave.naive(0.0);
+                    let jump = after - before;
+                    self.slave.phase = (slave_inc * d).rem_euclid(1.0);
+                    current = self.slave.value();
+                    // PolyBLEP split across the two samples around the jump.
+                    correction_prev = jump / 2.0 * d * d;
+                    current -= jump / 2.0 * (1.0 - d) * (1.0 - d);
+                    self.slave.phase = (self.slave.phase + slave_inc).rem_euclid(1.0);
+                }
+                SyncMode::Soft => {
+                    self.slave.direction = -self.slave.direction;
+                    current = self.slave.value();
+                    self.slave.advance();
+                }
+            }
+        } else {
+            current = self.slave.value();
+            self.slave.advance();
+        }
+        let out = self.pending + correction_prev;
+        self.pending = current;
+        out as f32
+    }
+}
+
+impl super::Generator for Sync {
+    fn next_sample(&mut self) -> f32 {
+        self.tick()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::synth::testing::{level_near, rms, spectrum};
+
+    const RATE: f32 = 48_000.0;
+
+    fn render(osc: &mut impl FnMut() -> f32, n: usize) -> Vec<f32> {
+        (0..n).map(|_| osc()).collect()
+    }
+
+    /// Energy between harmonics — alias components land off the harmonic
+    /// grid, so this is a direct alias measure.
+    fn inharmonic_energy(x: &[f32], f0: f64) -> f64 {
+        let (mags, bin) = spectrum(x, RATE);
+        let mut e = 0.0;
+        for (k, m) in mags.iter().enumerate() {
+            #[expect(clippy::cast_precision_loss, reason = "test")]
+            let hz = k as f64 * bin;
+            let nearest = (hz / f0).round() * f0;
+            if (hz - nearest).abs() > 4.0 * bin && hz > 100.0 {
+                e += m * m;
+            }
+        }
+        e
+    }
+
+    fn naive(shape: Shape, hz: f32, n: usize) -> Vec<f32> {
+        let o = Oscillator::new(shape, hz, RATE);
+        let mut t = 0.0f64;
+        (0..n)
+            .map(|_| {
+                #[expect(clippy::cast_possible_truncation, reason = "test")]
+                let v = o.naive(t) as f32;
+                t = (t + o.inc).rem_euclid(1.0);
+                v
+            })
+            .collect()
+    }
+
+    #[test]
+    fn band_limited_saw_aliases_far_less_than_naive() {
+        let f = 3_517.0;
+        let mut o = Oscillator::new(Shape::Saw, f, RATE);
+        let bl = render(&mut || o.tick(), 16_384);
+        let nv = naive(Shape::Saw, f, 16_384);
+        let ratio = inharmonic_energy(&bl, f64::from(f)) / inharmonic_energy(&nv, f64::from(f));
+        assert!(ratio < 0.1, "alias energy ratio {ratio}");
+    }
+
+    #[test]
+    fn band_limited_square_and_pulse_alias_less() {
+        for shape in [Shape::Square, Shape::Pulse(0.3)] {
+            let f = 2_903.0;
+            let mut o = Oscillator::new(shape, f, RATE);
+            let bl = render(&mut || o.tick(), 16_384);
+            let nv = naive(shape, f, 16_384);
+            let ratio = inharmonic_energy(&bl, f64::from(f)) / inharmonic_energy(&nv, f64::from(f));
+            assert!(ratio < 0.15, "{shape:?}: {ratio}");
+        }
+    }
+
+    #[test]
+    fn band_limited_triangle_aliases_less() {
+        let f = 5_011.0;
+        let mut o = Oscillator::new(Shape::Triangle, f, RATE);
+        let bl = render(&mut || o.tick(), 16_384);
+        let nv = naive(Shape::Triangle, f, 16_384);
+        let ratio = inharmonic_energy(&bl, f64::from(f)) / inharmonic_energy(&nv, f64::from(f));
+        assert!(ratio < 0.5, "triangle alias ratio {ratio}");
+    }
+
+    #[test]
+    fn saw_harmonics_fall_as_one_over_n() {
+        let f = 375.0; // exact bins at 48k / 16384 * k? close enough with window
+        let mut o = Oscillator::new(Shape::Saw, f, RATE);
+        let x = render(&mut || o.tick(), 16_384);
+        let (mags, bin) = spectrum(&x, RATE);
+        let h1 = level_near(&mags, bin, 375.0, 2);
+        let h2 = level_near(&mags, bin, 750.0, 2);
+        let h3 = level_near(&mags, bin, 1125.0, 2);
+        assert!((h1 / h2 - 2.0).abs() < 0.2, "{h1} {h2}");
+        assert!((h1 / h3 - 3.0).abs() < 0.3, "{h1} {h3}");
+    }
+
+    #[test]
+    fn square_has_only_odd_harmonics() {
+        let f = 375.0;
+        let mut o = Oscillator::new(Shape::Square, f, RATE);
+        let x = render(&mut || o.tick(), 16_384);
+        let (mags, bin) = spectrum(&x, RATE);
+        let h1 = level_near(&mags, bin, 375.0, 2);
+        let h2 = level_near(&mags, bin, 750.0, 2);
+        let h3 = level_near(&mags, bin, 1125.0, 2);
+        assert!(h2 < h1 * 0.01, "even harmonic present: {h2}");
+        assert!((h1 / h3 - 3.0).abs() < 0.3);
+    }
+
+    #[test]
+    fn outputs_stay_in_range_and_centered() {
+        for shape in [
+            Shape::Sine,
+            Shape::Saw,
+            Shape::Square,
+            Shape::Pulse(0.5),
+            Shape::Triangle,
+        ] {
+            let mut o = Oscillator::new(shape, 440.0, RATE);
+            let x = render(&mut || o.tick(), 48_000);
+            assert!(x.iter().all(|v| v.abs() <= 1.2), "{shape:?}");
+            let mean: f64 = x.iter().map(|v| f64::from(*v)).sum::<f64>() / 48_000.0;
+            assert!(mean.abs() < 0.01, "{shape:?} DC {mean}");
+            assert!(rms(&x) > 0.4, "{shape:?}");
+        }
+    }
+
+    #[test]
+    fn hard_sync_follows_the_master_pitch() {
+        let slave = Oscillator::new(Shape::Saw, 1_234.0, RATE);
+        let mut s = Sync::new(slave, 300.0, SyncMode::Hard);
+        let x = render(&mut || s.tick(), 32_768);
+        // Hard sync makes the output periodic at the master frequency.
+        let (mags, bin) = spectrum(&x, RATE);
+        let on_grid = level_near(&mags, bin, 1200.0, 2);
+        let off_grid = level_near(&mags, bin, 1234.0 + 60.0, 1);
+        assert!(on_grid > 10.0 * off_grid, "{on_grid} vs {off_grid}");
+        let per = (f64::from(RATE) / 300.0).round() as usize;
+        let diff: f64 = (1000..3000)
+            .map(|i| f64::from((x[i] - x[i + per]).abs()))
+            .sum::<f64>()
+            / 2000.0;
+        assert!(diff < 0.05, "not periodic at the master: {diff}");
+    }
+
+    #[test]
+    fn hard_sync_is_band_limited_better_than_naive_reset() {
+        // Compare with a naive reset of a naive saw.
+        let f_m = 2_311.0;
+        let f_s = 5_333.0;
+        let slave = Oscillator::new(Shape::Saw, f_s, RATE);
+        let mut s = Sync::new(slave, f_m, SyncMode::Hard);
+        let bl = render(&mut || s.tick(), 16_384);
+        let mut mp = 0.0f64;
+        let mut sp = 0.0f64;
+        let mi = f64::from(f_m / RATE);
+        let si = f64::from(f_s / RATE);
+        #[expect(clippy::cast_possible_truncation, reason = "test")]
+        let nv: Vec<f32> = (0..16_384)
+            .map(|_| {
+                let v = (1.0 - 2.0 * sp) as f32;
+                mp += mi;
+                sp = (sp + si).rem_euclid(1.0);
+                if mp >= 1.0 {
+                    mp -= 1.0;
+                    sp = 0.0;
+                }
+                v
+            })
+            .collect();
+        let ratio = inharmonic_energy(&bl, f64::from(f_m)) / inharmonic_energy(&nv, f64::from(f_m));
+        assert!(ratio < 0.5, "sync alias ratio {ratio}");
+    }
+
+    #[test]
+    fn soft_sync_runs_and_is_bounded() {
+        let slave = Oscillator::new(Shape::Triangle, 700.0, RATE);
+        let mut s = Sync::new(slave, 220.0, SyncMode::Soft);
+        let x = render(&mut || s.tick(), 4_800);
+        assert!(x.iter().all(|v| v.is_finite() && v.abs() <= 1.2));
+        assert!(rms(&x) > 0.2);
+    }
+
+    #[test]
+    fn frequency_changes_keep_phase() {
+        let mut o = Oscillator::new(Shape::Sine, 440.0, RATE);
+        for _ in 0..100 {
+            o.tick();
+        }
+        let p = o.phase();
+        o.set_frequency(880.0);
+        assert!((o.phase() - p).abs() < 1e-12);
+        assert!((o.frequency() - 880.0).abs() < 0.01);
+    }
+}
