     fn process_stereo(&mut self, l: f32, r: f32) -> (f32, f32) {
         self.process_stereo_keyed(l, r, None)
     }
+
+    fn process_stereo_with_key(&mut self, l: f32, r: f32, key: (f32, f32)) -> (f32, f32) {
