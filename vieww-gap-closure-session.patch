+unsafe extern "system" fn get_bus_count<P: Plugin>(_: *mut c_void, ty: i32, dir: i32) -> i32 {
+    match ty {
+        t if t == kAudio => i32::from(channels::<P>(dir) > 0),
+        t if t == kEvent => i32::from(dir == kInput && P::info().note_input),
+        _ => 0,
+    }
