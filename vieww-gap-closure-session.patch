@@ -0,0 +1,416 @@
+//! Deterministic particle emission and simulation for effects, UI accents and
+//! scene previews. Rendering particles as camera-facing quads is exposed as
+//! data, so callers can choose the existing paint/image route or spatial mesh
+//! route without a hidden backend dependency.
+
+use std::time::Duration;
+
+use vieww_foundation::{Color, ColorSpace};
+
+use crate::{Camera3, Material3, Mesh3, MeshInstance3, Scene3, Transform3, Vec2, Vec3, Vertex3};
+
+/// Hard storage ceiling even if public emitter configuration is corrupted.
+pub const MAX_PARTICLES_PER_EMITTER: usize = 262_144;
+/// Hard per-update creation budget to prevent a catch-up spike from monopolizing a frame.
+pub const MAX_PARTICLE_SPAWNS_PER_UPDATE: usize = 16_384;
+
+/// One particle's simulation state. `age / lifetime` is its normalized age.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Particle {
+    pub position: Vec3,
+    pub velocity: Vec3,
+    pub age: f32,
+    pub lifetime: f32,
+    pub start_size: f32,
+    pub end_size: f32,
+    pub start_color: Color,
+    pub end_color: Color,
+}
+impl Particle {
+    #[must_use]
+    pub fn is_valid(self) -> bool {
+        self.position.is_finite()
+            && self.velocity.is_finite()
+            && self.age.is_finite()
+            && self.age >= 0.0
+            && self.lifetime.is_finite()
+            && self.lifetime > 0.0
+            && self.start_size.is_finite()
+            && self.start_size >= 0.0
+            && self.end_size.is_finite()
+            && self.end_size >= 0.0
+    }
+    #[must_use]
+    pub fn normalized_age(self) -> f32 {
+        if !self.age.is_finite() || !self.lifetime.is_finite() || self.lifetime <= 0.0 {
+            1.0
+        } else {
+            (self.age / self.lifetime).clamp(0.0, 1.0)
+        }
+    }
+    #[must_use]
+    pub fn size(self) -> f32 {
+        if !self.start_size.is_finite() || !self.end_size.is_finite() {
+            return 0.0;
+        }
+        (self.start_size + (self.end_size - self.start_size) * self.normalized_age()).max(0.0)
+    }
+    #[must_use]
+    pub fn color(self) -> Color {
+        lerp_color(self.start_color, self.end_color, self.normalized_age())
+    }
+    #[must_use]
+    pub fn is_alive(self) -> bool {
+        self.is_valid() && self.age < self.lifetime
+    }
+}
+
+/// Data required to billboard a particle in the active camera's plane.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct BillboardParticle {
+    pub center: Vec3,
+    pub right: Vec3,
+    pub up: Vec3,
+    pub half_size: f32,
+    pub color: Color,
+}
+impl BillboardParticle {
+    #[must_use]
+    pub fn corners(self) -> [Vec3; 4] {
+        let right = self.right * self.half_size;
+        let up = self.up * self.half_size;
+        [
+            self.center - right - up,
+            self.center + right - up,
+            self.center + right + up,
+            self.center - right + up,
+        ]
+    }
+}
+
+/// Seeded emitter with cone spread and bounded per-frame spawning.
+#[derive(Debug, Clone)]
+pub struct ParticleEmitter {
+    pub origin: Vec3,
+    pub direction: Vec3,
+    pub spread_radians: f32,
+    pub rate_per_second: f32,
+    pub lifetime_seconds: (f32, f32),
+    pub speed: (f32, f32),
+    pub size: (f32, f32),
+    pub start_color: Color,
+    pub end_color: Color,
+    pub gravity: Vec3,
+    pub max_particles: usize,
+    pub seed: u64,
+    spawn_remainder: f32,
+    particles: Vec<Particle>,
+}
+impl Default for ParticleEmitter {
+    fn default() -> Self {
+        Self {
+            origin: Vec3::ZERO,
+            direction: Vec3::Y,
+            spread_radians: 0.25,
+            rate_per_second: 24.0,
+            lifetime_seconds: (0.5, 1.5),
+            speed: (0.5, 2.0),
+            size: (0.02, 0.12),
+            start_color: Color::rgba(255, 210, 100, 255),
+            end_color: Color::rgba(255, 50, 20, 0),
+            gravity: Vec3::new(0.0, -1.0, 0.0),
+            max_particles: 4096,
+            seed: 0x5649_4557_5750_4152,
+            spawn_remainder: 0.0,
+            particles: Vec::new(),
+        }
+    }
+}
+impl ParticleEmitter {
+    #[must_use]
+    pub fn new(seed: u64) -> Self {
+        Self {
+            seed,
+            ..Self::default()
+        }
+    }
+    #[must_use]
+    pub fn particles(&self) -> &[Particle] {
+        &self.particles
+    }
+    pub fn particles_mut(&mut self) -> &mut [Particle] {
+        &mut self.particles
+    }
+    pub fn clear(&mut self) {
+        self.particles.clear();
+        self.spawn_remainder = 0.0;
+    }
+
+    /// Advance with caller-supplied time. Returns the number of particles born.
+    pub fn update(&mut self, delta: Duration) -> usize {
+        let dt = delta.as_secs_f32();
+        if !dt.is_finite() || dt <= 0.0 || !self.configuration_is_valid() {
+            return 0;
+        }
+        let particle_limit = self.max_particles.min(MAX_PARTICLES_PER_EMITTER);
+        self.particles.retain(|particle| particle.is_valid());
+        self.particles.truncate(particle_limit);
+        for particle in &mut self.particles {
+            particle.velocity = particle.velocity + self.gravity * dt;
+            particle.position = particle.position + particle.velocity * dt;
+            particle.age += dt;
+        }
+        self.particles.retain(|particle| particle.is_alive());
+        if !self.rate_per_second.is_finite() || self.rate_per_second <= 0.0 {
+            self.spawn_remainder = 0.0;
+            return 0;
+        }
+        self.spawn_remainder += (self.rate_per_second * dt).min(particle_limit as f32);
+        let requested = self.spawn_remainder.floor() as usize;
+        self.spawn_remainder -= requested as f32;
+        let capacity = particle_limit.saturating_sub(self.particles.len());
+        let spawn_count = requested.min(capacity).min(MAX_PARTICLE_SPAWNS_PER_UPDATE);
+        for _ in 0..spawn_count {
+            self.spawn_one();
+        }
+        spawn_count
+    }
+
+    fn configuration_is_valid(&self) -> bool {
+        self.origin.is_finite()
+            && self.direction.is_finite()
+            && self.spread_radians.is_finite()
+            && (0.0..=std::f32::consts::PI).contains(&self.spread_radians)
+            && self.rate_per_second.is_finite()
+            && self.rate_per_second >= 0.0
+            && self.lifetime_seconds.0.is_finite()
+            && self.lifetime_seconds.1.is_finite()
+            && self.lifetime_seconds.0 > 0.0
+            && self.lifetime_seconds.1 > 0.0
+            && self.speed.0.is_finite()
+            && self.speed.1.is_finite()
+            && self.size.0.is_finite()
+            && self.size.1.is_finite()
+            && self.size.0 >= 0.0
+            && self.size.1 >= 0.0
+            && self.gravity.is_finite()
+    }
+
+    fn spawn_one(&mut self) {
+        let mut direction = self.direction.normalized();
+        if direction == Vec3::ZERO {
+            direction = Vec3::Y;
+        }
+        let axis = if direction.dot(Vec3::Y).abs() > 0.98 {
+            Vec3::X
+        } else {
+            Vec3::Y
+        };
+        let tangent = direction.cross(axis).normalized();
+        let bitangent = direction.cross(tangent).normalized();
+        let angle = self.random_unit() * std::f32::consts::TAU;
+        let cosine = (1.0
+            - self.random_unit()
+                * (1.0 - self.spread_radians.clamp(0.0, std::f32::consts::PI).cos()))
+        .clamp(-1.0, 1.0);
+        let sine = (1.0 - cosine * cosine).max(0.0).sqrt();
+        let sampled = (direction * cosine
+            + tangent * (sine * angle.cos())
+            + bitangent * (sine * angle.sin()))
+        .normalized();
+        let speed = random_range(&mut self.seed, self.speed);
+        let lifetime = random_range(&mut self.seed, self.lifetime_seconds).max(0.001);
+        let size = random_range(&mut self.seed, self.size).max(0.0);
+        self.particles.push(Particle {
+            position: self.origin,
+            velocity: sampled * speed,
+            age: 0.0,
+            lifetime,
+            start_size: size,
+            end_size: 0.0,
+            start_color: self.start_color,
+            end_color: self.end_color,
+        });
+    }
+
+    fn random_unit(&mut self) -> f32 {
+        random_unit(&mut self.seed)
+    }
+
+    /// Return current particle data as camera-aligned quads for a renderer.
+    #[must_use]
+    pub fn billboards(&self, camera: Camera3) -> Vec<BillboardParticle> {
+        let right = camera.right();
+        let up = camera.true_up();
+        self.particles
+            .iter()
+            .copied()
+            .filter(|particle| particle.is_alive())
+            .map(|particle| BillboardParticle {
+                center: particle.position,
+                right,
+                up,
+                half_size: particle.size() * 0.5,
+                color: particle.color(),
+            })
+            .collect()
+    }
+
+    /// Append current particles to a scene as unlit, camera-facing quads. Each
+    /// instance owns its material tint; this is a deliberately simple path for
+    /// UI-scale effects rather than a GPU instancing implementation.
+    pub fn append_billboards(&self, scene: &mut Scene3, camera: Camera3) {
+        for billboard in self.billboards(camera) {
+            if billboard.half_size <= 0.0 {
+                continue;
+            }
+            let corners = billboard.corners();
+            let normal = -camera.forward();
+            let vertices = vec![
+                Vertex3::new(corners[0], normal, Vec2::new(0.0, 1.0)),
+                Vertex3::new(corners[1], normal, Vec2::new(1.0, 1.0)),
+                Vertex3::new(corners[2], normal, Vec2::new(1.0, 0.0)),
+                Vertex3::new(corners[3], normal, Vec2::new(0.0, 0.0)),
+            ];
+            let mesh = Mesh3 {
+                vertices,
+                indices: vec![0, 1, 2, 0, 2, 3],
+            };
+            let material = Material3::new(billboard.color).unlit().double_sided(true);
+            scene.add(MeshInstance3::new(mesh, material).with_transform(Transform3::IDENTITY));
+        }
+    }
+}
+
+fn random_range(seed: &mut u64, range: (f32, f32)) -> f32 {
+    let min = range.0.min(range.1);
+    let max = range.0.max(range.1);
+    min + (max - min) * random_unit(seed)
+}
+fn random_unit(seed: &mut u64) -> f32 {
+    // Xorshift64*: small, deterministic and explicitly non-cryptographic.
+    let mut x = if *seed == 0 {
+        0x9e37_79b9_7f4a_7c15
+    } else {
+        *seed
+    };
+    x ^= x >> 12;
+    x ^= x << 25;
+    x ^= x >> 27;
+    *seed = x;
+    let value = x.wrapping_mul(0x2545_f491_4f6c_dd1d);
+    ((value >> 40) as u32) as f32 / ((1_u32 << 24) as f32)
+}
+fn lerp_color(a: Color, b: Color, t: f32) -> Color {
+    // `Color::lerp` intentionally returns sRGB for UI tween compatibility. A
+    // particle interpolation instead preserves the start color's declared
+    // primaries and first converts the end point into that space; otherwise a
+    // P3 start color would silently become sRGB halfway through its lifetime.
+    let b = b.converted_to(a.space);
+    let t = if t.is_finite() {
+        t.clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    let channel = |from: u8, to: u8| {
+        (f32::from(from) + (f32::from(to) - f32::from(from)) * t)
+            .round()
+            .clamp(0.0, 255.0) as u8
+    };
+    let (r, g, b, alpha) = (
+        channel(a.r, b.r),
+        channel(a.g, b.g),
+        channel(a.b, b.b),
+        channel(a.a, b.a),
+    );
+    match a.space {
+        ColorSpace::Srgb => Color::rgba(r, g, b, alpha),
+        ColorSpace::DisplayP3 => Color::p3a(r, g, b, alpha),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn seeded_emitters_produce_the_same_particles() {
+        let mut a = ParticleEmitter::new(7);
+        let mut b = ParticleEmitter::new(7);
+        a.rate_per_second = 20.0;
+        b.rate_per_second = 20.0;
+        assert_eq!(a.update(Duration::from_millis(250)), 5);
+        assert_eq!(b.update(Duration::from_millis(250)), 5);
+        assert_eq!(a.particles(), b.particles());
+    }
+
+    #[test]
+    fn invalid_emitter_configuration_does_not_emit_nan_particles() {
+        let mut emitter = ParticleEmitter::new(5);
+        emitter.gravity.x = f32::NAN;
+        assert_eq!(emitter.update(Duration::from_secs(1)), 0);
+        assert!(emitter.particles().is_empty());
+    }
+
+    #[test]
+    fn particles_expire_and_report_lifecycle_values() {
+        let mut emitter = ParticleEmitter::new(3);
+        emitter.rate_per_second = 2.0;
+        emitter.lifetime_seconds = (0.1, 0.1);
+        emitter.update(Duration::from_millis(500));
+        assert_eq!(emitter.particles().len(), 1);
+        emitter.update(Duration::from_millis(200));
+        assert!(emitter.particles().is_empty());
+    }
+
+    #[test]
+    fn excessive_configuration_is_bounded_per_update_and_in_storage() {
+        let mut emitter = ParticleEmitter::new(11);
+        emitter.max_particles = usize::MAX;
+        emitter.rate_per_second = 1.0e12;
+        let spawned = emitter.update(Duration::from_secs(100));
+        assert!(spawned <= MAX_PARTICLE_SPAWNS_PER_UPDATE);
+        assert!(emitter.particles().len() <= MAX_PARTICLE_SPAWNS_PER_UPDATE);
+    }
+
+    #[test]
+    fn invalid_mutated_particles_do_not_reach_billboards() {
+        let mut emitter = ParticleEmitter::new(13);
+        emitter.rate_per_second = 1.0;
+        emitter.update(Duration::from_secs(1));
+        assert_eq!(emitter.particles().len(), 1);
+        emitter.particles_mut()[0].position.x = f32::NAN;
+        assert!(emitter
+            .billboards(
+                Camera3::look_at(
+                    Vec3::new(0.0, 0.0, 3.0),
+                    Vec3::ZERO,
+                    Vec3::Y,
+                    crate::Projection3::perspective(1.0, 0.1, 100.0).unwrap()
+                )
+                .unwrap()
+            )
+            .is_empty());
+    }
+
+    #[test]
+    fn color_interpolation_keeps_the_start_color_space_when_endpoints_differ() {
+        let p3 = Color::p3(0, 255, 0);
+        let middle = lerp_color(p3, Color::rgba(255, 0, 0, 255), 0.5);
+        assert_eq!(middle.space, ColorSpace::DisplayP3);
+        assert_ne!(middle, Color::rgba(127, 127, 0, 255));
+
+        let srgb = lerp_color(Color::RED, p3, 0.5);
+        assert_eq!(srgb.space, ColorSpace::Srgb);
+        assert_ne!(srgb, Color::RED);
+        assert_ne!(srgb, p3);
+    }
+
+    #[test]
+    fn same_space_particle_color_interpolation_matches_channel_lerp() {
+        let start = Color::p3a(10, 20, 30, 40);
+        let end = Color::p3a(110, 120, 130, 140);
+        let middle = lerp_color(start, end, 0.5);
+        assert_eq!(middle, Color::p3a(60, 70, 80, 90));
+    }
+}
diff --git a/vieww_base/crates/vieww-spatial/src/physics.rs b/vieww_base/crates/vieww-spatial/src/physics.rs
new file mode 100644
index 0000000..fcd93f5
--- /dev/null
+++ b/vieww_base/crates/vieww-spatial/src/physics.rs
@@ -0,0 +1,534 @@
+//! Small deterministic rigid-body stepping for UI scenes, interactive previews
+//! and simple games. It is intentionally a compact built-in solver rather than
+//! a binding to a third-party physics engine.
+
+use crate::Vec3;
+
+/// Collider primitives currently supported by the built-in broad/narrow phase.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum ColliderShape {
+    Sphere {
+        radius: f32,
+    },
+    /// Axis-aligned in world space; rotation is intentionally ignored.
+    Box {
+        half_extents: Vec3,
+    },
+}
+impl ColliderShape {
+    fn valid(self) -> bool {
+        match self {
+            Self::Sphere { radius } => radius.is_finite() && radius > 0.0,
+            Self::Box { half_extents } => {
+                half_extents.is_finite()
+                    && half_extents.x > 0.0
+                    && half_extents.y > 0.0
+                    && half_extents.z > 0.0
+            }
+        }
+    }
+}
+
+/// One body. `inverse_mass == 0` makes a static body without a second type.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct RigidBody {
+    pub position: Vec3,
+    pub velocity: Vec3,
+    pub force: Vec3,
+    pub shape: ColliderShape,
+    pub inverse_mass: f32,
+    pub restitution: f32,
+    pub friction: f32,
+    pub linear_damping: f32,
+    pub enabled: bool,
+}
+impl RigidBody {
+    pub fn dynamic(shape: ColliderShape, position: Vec3, mass: f32) -> Result<Self, PhysicsError> {
+        if !position.is_finite() || !shape.valid() || !mass.is_finite() || mass <= 0.0 {
+            return Err(PhysicsError::InvalidBody);
+        }
+        let inverse_mass = 1.0 / mass;
+        if !inverse_mass.is_finite() || inverse_mass <= 0.0 {
+            return Err(PhysicsError::InvalidBody);
+        }
+        Ok(Self {
+            position,
+            velocity: Vec3::ZERO,
+            force: Vec3::ZERO,
+            shape,
+            inverse_mass,
+            restitution: 0.05,
+            friction: 0.6,
+            linear_damping: 0.02,
+            enabled: true,
+        })
+    }
+    pub fn fixed(shape: ColliderShape, position: Vec3) -> Result<Self, PhysicsError> {
+        if !position.is_finite() || !shape.valid() {
+            return Err(PhysicsError::InvalidBody);
+        }
+        Ok(Self {
+            position,
+            velocity: Vec3::ZERO,
+            force: Vec3::ZERO,
+            shape,
+            inverse_mass: 0.0,
+            restitution: 0.05,
+            friction: 0.6,
+            linear_damping: 0.02,
+            enabled: true,
+        })
+    }
+    #[must_use]
+    pub fn is_static(self) -> bool {
+        self.inverse_mass <= 0.0
+    }
+    pub fn apply_force(&mut self, force: Vec3) -> Result<(), PhysicsError> {
+        if !force.is_finite() {
+            return Err(PhysicsError::InvalidBody);
+        }
+        if !self.is_static() {
+            let accumulated = self.force + force;
+            if !accumulated.is_finite() {
+                return Err(PhysicsError::InvalidBody);
+            }
+            self.force = accumulated;
+        }
+        Ok(())
+    }
+}
+
+/// Diagnostics from world construction/stepping.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PhysicsError {
+    InvalidBody,
+    InvalidStep,
+}
+impl std::fmt::Display for PhysicsError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self { Self::InvalidBody => "body has invalid shape, mass, coefficient or state", Self::InvalidStep => "physics delta must be finite and non-negative, and fixed step must be in (0, 0.25] seconds" })
+    }
+}
+impl std::error::Error for PhysicsError {}
+
+fn body_is_valid(body: RigidBody) -> bool {
+    body.position.is_finite()
+        && body.velocity.is_finite()
+        && body.force.is_finite()
+        && body.shape.valid()
+        && body.inverse_mass.is_finite()
+        && body.inverse_mass >= 0.0
+        && body.restitution.is_finite()
+        && (0.0..=1.0).contains(&body.restitution)
+        && body.friction.is_finite()
+        && body.friction >= 0.0
+        && body.linear_damping.is_finite()
+        && (0.0..=1.0).contains(&body.linear_damping)
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Contact {
+    a: usize,
+    b: usize,
+    normal: Vec3,
+    penetration: f32,
+}
+
+/// Maximum accepted physics substep. Smaller fixed steps are recommended for
+/// stable simulation of fast-moving bodies and contact-rich scenes.
+pub const MAX_FIXED_STEP_SECONDS: f32 = 0.25;
+/// Hard safety ceiling on stepping/solver work for caller-controlled config.
+pub const MAX_SUBSTEPS: u32 = 64;
+
+/// Fixed-step, semi-implicit Euler world with bounded catch-up work.
+#[derive(Debug, Clone)]
+pub struct PhysicsWorld {
+    pub gravity: Vec3,
+    pub fixed_delta_seconds: f32,
+    pub max_substeps: u32,
+    pub solver_iterations: u32,
+    accumulator: f32,
+    bodies: Vec<RigidBody>,
+}
+impl Default for PhysicsWorld {
+    fn default() -> Self {
+        Self {
+            gravity: Vec3::new(0.0, -9.81, 0.0),
+            fixed_delta_seconds: 1.0 / 60.0,
+            max_substeps: 8,
+            solver_iterations: 5,
+            accumulator: 0.0,
+            bodies: Vec::new(),
+        }
+    }
+}
+impl PhysicsWorld {
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn add_body(&mut self, body: RigidBody) -> Result<usize, PhysicsError> {
+        if !body_is_valid(body) {
+            return Err(PhysicsError::InvalidBody);
+        }
+        let index = self.bodies.len();
+        self.bodies.push(body);
+        Ok(index)
+    }
+    #[must_use]
+    pub fn bodies(&self) -> &[RigidBody] {
+        &self.bodies
+    }
+    pub fn bodies_mut(&mut self) -> &mut [RigidBody] {
+        &mut self.bodies
+    }
+    pub fn clear(&mut self) {
+        self.bodies.clear();
+        self.accumulator = 0.0;
+    }
+
+    /// Advance by elapsed wall time. Excess backlog is intentionally discarded
+    /// after a bounded number of substeps so an application cannot enter a
+    /// spiral of death. A substep above 250 ms is rejected as numerically unsafe.
+    pub fn step(&mut self, delta_seconds: f32) -> Result<u32, PhysicsError> {
+        if !delta_seconds.is_finite()
+            || delta_seconds < 0.0
+            || !self.fixed_delta_seconds.is_finite()
+            || self.fixed_delta_seconds <= 0.0
+            || self.fixed_delta_seconds > MAX_FIXED_STEP_SECONDS
+        {
+            return Err(PhysicsError::InvalidStep);
+        }
+        if !self.gravity.is_finite() || self.bodies.iter().any(|body| !body_is_valid(*body)) {
+            return Err(PhysicsError::InvalidBody);
+        }
+        // Keep work bounded even if a public configuration field is corrupted.
+        // The whole call is transactional: overflow in integration/contact math
+        // restores the prior state instead of leaving NaNs in the public world.
+        let previous_bodies = self.bodies.clone();
+        let previous_accumulator = self.accumulator;
+        let max_substeps = self.max_substeps.clamp(1, MAX_SUBSTEPS);
+        let max_accumulator = f64::from(self.fixed_delta_seconds) * f64::from(max_substeps);
+        self.accumulator =
+            (f64::from(self.accumulator) + f64::from(delta_seconds)).min(max_accumulator) as f32;
+        let mut steps = 0;
+        while self.accumulator >= self.fixed_delta_seconds && steps < max_substeps {
+            self.integrate(self.fixed_delta_seconds);
+            if self.bodies.iter().any(|body| !body_is_valid(*body)) {
+                self.bodies = previous_bodies;
+                self.accumulator = previous_accumulator;
+                return Err(PhysicsError::InvalidBody);
+            }
+            self.accumulator -= self.fixed_delta_seconds;
+            steps += 1;
+        }
+        Ok(steps)
+    }
+
+    fn integrate(&mut self, dt: f32) {
+        for body in &mut self.bodies {
+            if !body.enabled || body.is_static() {
+                body.force = Vec3::ZERO;
+                continue;
+            }
+            let acceleration = self.gravity + body.force * body.inverse_mass;
+            body.velocity = body.velocity + acceleration * dt;
+            body.velocity =
+                body.velocity * (1.0 - body.linear_damping.clamp(0.0, 1.0) * dt).max(0.0);
+            body.position = body.position + body.velocity * dt;
+            body.force = Vec3::ZERO;
+        }
+        for _ in 0..self.solver_iterations.clamp(1, MAX_SUBSTEPS) {
+            let mut contacts = Vec::new();
+            for (a, body_a) in self.bodies.iter().copied().enumerate() {
+                if !body_a.enabled {
+                    continue;
+                }
+                for (b, body_b) in self.bodies.iter().copied().enumerate().skip(a + 1) {
+                    if !body_b.enabled || (body_a.is_static() && body_b.is_static()) {
+                        continue;
+                    }
+                    if let Some(contact) = collide(a, body_a, b, body_b) {
+                        contacts.push(contact);
+                    }
+                }
+            }
+            if contacts.is_empty() {
+                break;
+            }
+            for contact in contacts {
+                self.solve_contact(contact);
+            }
+        }
+    }
+
+    fn solve_contact(&mut self, contact: Contact) {
+        let (left, right) = self.bodies.split_at_mut(contact.b);
+        let a = &mut left[contact.a];
+        let b = &mut right[0];
+        let inv_a = if a.is_static() { 0.0 } else { a.inverse_mass };
+        let inv_b = if b.is_static() { 0.0 } else { b.inverse_mass };
+        let inv_sum = inv_a + inv_b;
+        if inv_sum <= 0.0 {
+            return;
+        }
+        let correction = contact.normal * ((contact.penetration - 0.001).max(0.0) * 0.65 / inv_sum);
+        if inv_a > 0.0 {
+            a.position = a.position - correction * inv_a;
+        }
+        if inv_b > 0.0 {
+            b.position = b.position + correction * inv_b;
+        }
+        let relative = b.velocity - a.velocity;
+        let normal_velocity = relative.dot(contact.normal);
+        if normal_velocity > 0.0 {
+            return;
+        }
+        let restitution = a.restitution.min(b.restitution).clamp(0.0, 1.0);
+        let impulse_magnitude = -(1.0 + restitution) * normal_velocity / inv_sum;
+        let impulse = contact.normal * impulse_magnitude;
+        if inv_a > 0.0 {
+            a.velocity = a.velocity - impulse * inv_a;
+        }
+        if inv_b > 0.0 {
+            b.velocity = b.velocity + impulse * inv_b;
+        }
+        let relative_after = b.velocity - a.velocity;
+        let tangent_raw = relative_after - contact.normal * relative_after.dot(contact.normal);
+        let tangent = tangent_raw.normalized();
+        if tangent != Vec3::ZERO {
+            let jt = -relative_after.dot(tangent) / inv_sum;
+            let friction = (a.friction * b.friction).max(0.0).sqrt();
+            let tangent_impulse =
+                tangent * jt.clamp(-impulse_magnitude * friction, impulse_magnitude * friction);
+            if inv_a > 0.0 {
+                a.velocity = a.velocity - tangent_impulse * inv_a;
+            }
+            if inv_b > 0.0 {
+                b.velocity = b.velocity + tangent_impulse * inv_b;
+            }
+        }
+    }
+}
+
+fn collide(a_index: usize, a: RigidBody, b_index: usize, b: RigidBody) -> Option<Contact> {
+    let (normal, penetration) = match (a.shape, b.shape) {
+        (ColliderShape::Sphere { radius: ra }, ColliderShape::Sphere { radius: rb }) => {
+            let delta = b.position - a.position;
+            let distance = delta.length();
+            let penetration = ra + rb - distance;
+            if penetration <= 0.0 {
+                return None;
+            }
+            (
+                if distance > 1.0e-7 {
+                    delta / distance
+                } else {
+                    Vec3::X
+                },
+                penetration,
+            )
+        }
+        (ColliderShape::Box { half_extents: ea }, ColliderShape::Box { half_extents: eb }) => {
+            let delta = b.position - a.position;
+            let overlap = Vec3::new(
+                ea.x + eb.x - delta.x.abs(),
+                ea.y + eb.y - delta.y.abs(),
+                ea.z + eb.z - delta.z.abs(),
+            );
+            if overlap.x <= 0.0 || overlap.y <= 0.0 || overlap.z <= 0.0 {
+                return None;
+            }
+            if overlap.x <= overlap.y && overlap.x <= overlap.z {
+                (
+                    Vec3::new(if delta.x < 0.0 { -1.0 } else { 1.0 }, 0.0, 0.0),
+                    overlap.x,
+                )
+            } else if overlap.y <= overlap.z {
+                (
+                    Vec3::new(0.0, if delta.y < 0.0 { -1.0 } else { 1.0 }, 0.0),
+                    overlap.y,
+                )
+            } else {
+                (
+                    Vec3::new(0.0, 0.0, if delta.z < 0.0 { -1.0 } else { 1.0 }),
+                    overlap.z,
+                )
+            }
+        }
+        (ColliderShape::Sphere { radius }, ColliderShape::Box { half_extents }) => {
+            let local = a.position - b.position;
+            let closest = local.clamp(-half_extents, half_extents);
+            let delta_from_sphere_to_box = closest - local;
+            let distance = delta_from_sphere_to_box.length();
+            if distance > 1.0e-7 {
+                let penetration = radius - distance;
+                if penetration <= 0.0 {
+                    return None;
+                }
+                (delta_from_sphere_to_box / distance, penetration)
+            } else {
+                // The sphere center is inside the box. Choose the nearest face
+                // and point the contact normal inward so the solver moves the
+                // sphere out through that face rather than deeper into the box.
+                let margins = half_extents - Vec3::new(local.x.abs(), local.y.abs(), local.z.abs());
+                let (normal, margin) = if margins.x <= margins.y && margins.x <= margins.z {
+                    (
+                        Vec3::new(if local.x >= 0.0 { -1.0 } else { 1.0 }, 0.0, 0.0),
+                        margins.x,
+                    )
+                } else if margins.y <= margins.z {
+                    (
+                        Vec3::new(0.0, if local.y >= 0.0 { -1.0 } else { 1.0 }, 0.0),
+                        margins.y,
+                    )
+                } else {
+                    (
+                        Vec3::new(0.0, 0.0, if local.z >= 0.0 { -1.0 } else { 1.0 }),
+                        margins.z,
+                    )
+                };
+                (normal, radius + margin.max(0.0))
+            }
+        }
+        (ColliderShape::Box { .. }, ColliderShape::Sphere { .. }) => {
+            let reverse = collide(b_index, b, a_index, a)?;
+            (-reverse.normal, reverse.penetration)
+        }
+    };
+    Some(Contact {
+        a: a_index,
+        b: b_index,
+        normal,
+        penetration,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fixed_step_is_repeatable_and_bounded() {
+        let mut world = PhysicsWorld::new();
+        world
+            .add_body(
+                RigidBody::dynamic(ColliderShape::Sphere { radius: 0.25 }, Vec3::ZERO, 1.0)
+                    .unwrap(),
+            )
+            .unwrap();
+        assert_eq!(world.step(1.0 / 60.0).unwrap(), 1);
+        assert!(world.bodies()[0].position.y < 0.0);
+        assert!(world.step(10.0).unwrap() <= world.max_substeps);
+    }
+
+    #[test]
+    fn fixed_floor_resolves_sphere_penetration() {
+        let mut world = PhysicsWorld::new();
+        world.gravity = Vec3::ZERO;
+        world
+            .add_body(
+                RigidBody::fixed(
+                    ColliderShape::Box {
+                        half_extents: Vec3::new(4.0, 0.5, 4.0),
+                    },
+                    Vec3::new(0.0, -0.5, 0.0),
+                )
+                .unwrap(),
+            )
+            .unwrap();
+        world
+            .add_body(
+                RigidBody::dynamic(
+                    ColliderShape::Sphere { radius: 0.5 },
+                    Vec3::new(0.0, 0.2, 0.0),
+                    1.0,
+                )
+                .unwrap(),
+            )
+            .unwrap();
+        world.step(1.0 / 60.0).unwrap();
+        assert!(world.bodies()[1].position.y >= 0.48);
+    }
+
+    #[test]
+    fn invalid_mass_is_not_silently_treated_as_a_static_body() {
+        assert!(matches!(
+            RigidBody::dynamic(ColliderShape::Sphere { radius: 1.0 }, Vec3::ZERO, -1.0),
+            Err(PhysicsError::InvalidBody)
+        ));
+    }
+
+    #[test]
+    fn invalid_public_world_state_is_rejected_before_integration() {
+        let mut world = PhysicsWorld::new();
+        world.gravity.x = f32::NAN;
+        assert_eq!(world.step(1.0 / 60.0), Err(PhysicsError::InvalidBody));
+        world.gravity = Vec3::ZERO;
+        world.fixed_delta_seconds = f32::MAX;
+        assert_eq!(world.step(1.0 / 60.0), Err(PhysicsError::InvalidStep));
+    }
+
+    #[test]
+    fn body_coefficients_and_forces_are_validated() {
+        let mut body =
+            RigidBody::dynamic(ColliderShape::Sphere { radius: 1.0 }, Vec3::ZERO, 1.0).unwrap();
+        body.friction = f32::NAN;
+        let mut world = PhysicsWorld::new();
+        assert_eq!(world.add_body(body), Err(PhysicsError::InvalidBody));
+        let mut body =
+            RigidBody::dynamic(ColliderShape::Sphere { radius: 1.0 }, Vec3::ZERO, 1.0).unwrap();
+        assert_eq!(
+            body.apply_force(Vec3::new(f32::NAN, 0.0, 0.0)),
+            Err(PhysicsError::InvalidBody)
+        );
+        body.apply_force(Vec3::new(0.0, 1.0, 0.0)).unwrap();
+        assert_eq!(body.force, Vec3::Y);
+    }
+
+    #[test]
+    fn sphere_inside_box_is_corrected_toward_a_nearest_face() {
+        let mut world = PhysicsWorld::new();
+        world.gravity = Vec3::ZERO;
+        world.solver_iterations = 8;
+        world
+            .add_body(
+                RigidBody::fixed(
+                    ColliderShape::Box {
+                        half_extents: Vec3::new(2.0, 2.0, 2.0),
+                    },
+                    Vec3::ZERO,
+                )
+                .unwrap(),
+            )
+            .unwrap();
+        world
+            .add_body(
+                RigidBody::dynamic(ColliderShape::Sphere { radius: 0.5 }, Vec3::ZERO, 1.0).unwrap(),
+            )
+            .unwrap();
+        world.step(1.0 / 60.0).unwrap();
+        assert!(world.bodies()[1].position.length() > 0.0);
+    }
+
+    #[test]
+    fn overflow_during_integration_rolls_back_the_entire_step() {
+        let mut world = PhysicsWorld::new();
+        world.gravity = Vec3::ZERO;
+        world.fixed_delta_seconds = MAX_FIXED_STEP_SECONDS;
+        let mut body = RigidBody::dynamic(
+            ColliderShape::Sphere { radius: 1.0 },
+            Vec3::new(f32::MAX, 0.0, 0.0),
+            1.0,
+        )
+        .unwrap();
+        body.velocity = Vec3::new(f32::MAX, 0.0, 0.0);
+        world.add_body(body).unwrap();
+        let before = world.bodies().to_vec();
+        assert_eq!(
+            world.step(MAX_FIXED_STEP_SECONDS),
+            Err(PhysicsError::InvalidBody)
+        );
+        assert_eq!(world.bodies(), before.as_slice());
+    }
+}
diff --git a/vieww_base/crates/vieww-spatial/src/raster.rs b/vieww_base/crates/vieww-spatial/src/raster.rs
new file mode 100644
index 0000000..8be3f31
--- /dev/null
+++ b/vieww_base/crates/vieww-spatial/src/raster.rs
@@ -0,0 +1,1017 @@
+//! Deterministic CPU triangle rasterizer for ViewW's spatial scene IR.
+//!
+//! This is an independent software path, not a wrapper around a game engine or
+//! graphics framework. The resulting RGBA image is an ordinary ViewW image and
+//! can be handed to the existing 2D image/compositor path.
+
+use vieww_foundation::{Color, Image};
+
+use crate::{
+    Camera3, Light3, Material3, MeshInstance3, Scene3, ShadingModel, TextureAddressMode,
+    TextureFilter, Vec2, Vec3,
+};
+
+/// Conservative bound protecting callers from accidental multi-gigabyte targets.
+pub const DEFAULT_MAX_PIXELS: usize = 16 * 1024 * 1024;
+
+/// Rasterization controls. This currently caps allocation; quality is defined
+/// by the deterministic pixel-center triangle rule and no hidden runtime state.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct RasterConfig {
+    pub max_pixels: usize,
+}
+impl Default for RasterConfig {
+    fn default() -> Self {
+        Self {
+            max_pixels: DEFAULT_MAX_PIXELS,
+        }
+    }
+}
+
+/// Errors that can be diagnosed before or during a spatial render.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RasterError {
+    EmptyTarget,
+    TargetTooLarge {
+        pixels: usize,
+        limit: usize,
+    },
+    InvalidTargetBuffer,
+    InvalidCamera(crate::CameraError),
+    InvalidSceneGeometry {
+        object_index: usize,
+        message: String,
+    },
+    InvalidSceneTransform {
+        object_index: usize,
+    },
+    InvalidMaterial {
+        object_index: usize,
+    },
+    InvalidLight {
+        light_index: usize,
+    },
+}
+impl std::fmt::Display for RasterError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::EmptyTarget => f.write_str("spatial render target dimensions must be non-zero"),
+            Self::TargetTooLarge { pixels, limit } => write!(
+                f,
+                "spatial render target has {pixels} pixels; configured limit is {limit}"
+            ),
+            Self::InvalidTargetBuffer => {
+                f.write_str("spatial render target buffer has an invalid length")
+            }
+            Self::InvalidCamera(error) => write!(f, "spatial camera: {error}"),
+            Self::InvalidSceneGeometry {
+                object_index,
+                message,
+            } => write!(f, "scene object {object_index}: {message}"),
+            Self::InvalidSceneTransform { object_index } => write!(
+                f,
+                "scene object {object_index} has a non-finite or degenerate transform"
+            ),
+            Self::InvalidMaterial { object_index } => write!(
+                f,
+                "scene object {object_index} has invalid metallic/roughness values"
+            ),
+            Self::InvalidLight { light_index } => {
+                write!(f, "scene light {light_index} has invalid parameters")
+            }
+        }
+    }
+}
+impl std::error::Error for RasterError {}
+
+#[derive(Debug, Clone, Copy)]
+struct ClipVertex {
+    view: Vec3,
+    world: Vec3,
+    normal: Vec3,
+    uv: Vec2,
+}
+impl ClipVertex {
+    fn lerp(self, rhs: Self, t: f32) -> Self {
+        Self {
+            view: self.view.lerp(rhs.view, t),
+            world: self.world.lerp(rhs.world, t),
+            normal: self.normal.lerp(rhs.normal, t).normalized(),
+            uv: self.uv.lerp(rhs.uv, t),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct ScreenVertex {
+    x: f32,
+    y: f32,
+    z: f32,
+    inv_z: f32,
+    world: Vec3,
+    normal: Vec3,
+    uv: Vec2,
+}
+
+/// Render a scene to a newly allocated RGBA8 image using ViewW's CPU path.
+///
+/// Callers can then use `vieww_foundation::Image` with the existing 2D widget,
+/// paint command, asset or GPU compositor. No window or graphics context is
+/// needed, which also makes the renderer suitable for headless tests and film
+/// pipelines.
+pub fn render(
+    scene: &Scene3,
+    camera: Camera3,
+    width: u32,
+    height: u32,
+) -> Result<Image, RasterError> {
+    render_with_config(scene, camera, width, height, RasterConfig::default())
+}
+
+/// Render with an explicit target-allocation ceiling.
+pub fn render_with_config(
+    scene: &Scene3,
+    camera: Camera3,
+    width: u32,
+    height: u32,
+    config: RasterConfig,
+) -> Result<Image, RasterError> {
+    if width == 0 || height == 0 {
+        return Err(RasterError::EmptyTarget);
+    }
+    let pixels =
+        (width as usize)
+            .checked_mul(height as usize)
+            .ok_or(RasterError::TargetTooLarge {
+                pixels: usize::MAX,
+                limit: config.max_pixels,
+            })?;
+    if pixels > config.max_pixels {
+        return Err(RasterError::TargetTooLarge {
+            pixels,
+            limit: config.max_pixels,
+        });
+    }
+    let byte_len = pixels.checked_mul(4).ok_or(RasterError::TargetTooLarge {
+        pixels,
+        limit: config.max_pixels,
+    })?;
+    let (opaque, transparent) = prepare_draw_order(scene, camera)?;
+    let mut rgba = vec![0_u8; byte_len];
+    let mut depth = vec![f32::INFINITY; pixels];
+    let background = color_to_rgba8(scene.background);
+    for pixel in rgba.chunks_exact_mut(4) {
+        pixel.copy_from_slice(&background);
+    }
+
+    let aspect = width as f32 / height as f32;
+    for index in opaque.into_iter().chain(transparent) {
+        draw_object(
+            scene,
+            &scene.objects[index],
+            camera,
+            aspect,
+            width,
+            height,
+            &mut rgba,
+            &mut depth,
+        );
+    }
+    Ok(Image::from_rgba8(rgba, width, height))
+}
+
+/// Render into caller-owned buffers (RGBA8 plus one depth value per pixel).
+/// This retains the large target allocations across frames; it may still use
+/// temporary storage for object ordering and polygon clipping.
+pub fn render_into(
+    scene: &Scene3,
+    camera: Camera3,
+    width: u32,
+    height: u32,
+    rgba: &mut [u8],
+    depth: &mut [f32],
+) -> Result<(), RasterError> {
+    render_into_with_config(
+        scene,
+        camera,
+        width,
+        height,
+        rgba,
+        depth,
+        RasterConfig::default(),
+    )
+}
+
+/// Reuse caller-owned buffers with an explicit pixel ceiling, using the same
+/// bounds and scene validation as [`render_with_config`].
+pub fn render_into_with_config(
+    scene: &Scene3,
+    camera: Camera3,
+    width: u32,
+    height: u32,
+    rgba: &mut [u8],
+    depth: &mut [f32],
+    config: RasterConfig,
+) -> Result<(), RasterError> {
+    if width == 0 || height == 0 {
+        return Err(RasterError::EmptyTarget);
+    }
+    let pixels =
+        (width as usize)
+            .checked_mul(height as usize)
+            .ok_or(RasterError::TargetTooLarge {
+                pixels: usize::MAX,
+                limit: config.max_pixels,
+            })?;
+    if pixels > config.max_pixels {
+        return Err(RasterError::TargetTooLarge {
+            pixels,
+            limit: config.max_pixels,
+        });
+    }
+    let bytes = pixels.checked_mul(4).ok_or(RasterError::TargetTooLarge {
+        pixels,
+        limit: config.max_pixels,
+    })?;
+    if rgba.len() != bytes || depth.len() != pixels {
+        return Err(RasterError::InvalidTargetBuffer);
+    }
+    let (opaque, transparent) = prepare_draw_order(scene, camera)?;
+    let clear = color_to_rgba8(scene.background);
+    for pixel in rgba.chunks_exact_mut(4) {
+        pixel.copy_from_slice(&clear);
+    }
+    depth.fill(f32::INFINITY);
+    let aspect = width as f32 / height as f32;
+    for index in opaque.into_iter().chain(transparent) {
+        draw_object(
+            scene,
+            &scene.objects[index],
+            camera,
+            aspect,
+            width,
+            height,
+            rgba,
+            depth,
+        );
+    }
+    Ok(())
+}
+
+/// Validate before drawing and render alpha-bearing objects back-to-front after
+/// opaque geometry. This is a deterministic object-level sort; intersecting or
+/// concave translucent meshes still need finer sorting or an order-independent
+/// transparency technique.
+fn prepare_draw_order(
+    scene: &Scene3,
+    camera: Camera3,
+) -> Result<(Vec<usize>, Vec<usize>), RasterError> {
+    camera.validate().map_err(RasterError::InvalidCamera)?;
+    for (light_index, light) in scene.lights.iter().copied().enumerate() {
+        if !light.is_valid() {
+            return Err(RasterError::InvalidLight { light_index });
+        }
+    }
+    let mut opaque = Vec::with_capacity(scene.objects.len());
+    let mut transparent = Vec::new();
+    for (index, object) in scene.objects.iter().enumerate() {
+        object
+            .mesh
+            .validate()
+            .map_err(|error| RasterError::InvalidSceneGeometry {
+                object_index: index,
+                message: error.to_string(),
+            })?;
+        if !object.transform.is_valid()
+            || object.mesh.vertices.iter().any(|vertex| {
+                let world = object.transform.transform_point(vertex.position);
+                !world.is_finite() || !camera.camera_space(world).is_finite()
+            })
+        {
+            return Err(RasterError::InvalidSceneTransform {
+                object_index: index,
+            });
+        }
+        if !object.material.is_valid() {
+            return Err(RasterError::InvalidMaterial {
+                object_index: index,
+            });
+        }
+        if object.material.albedo.a < 255 || object.material.texture.is_some() {
+            transparent.push(index);
+        } else {
+            opaque.push(index);
+        }
+    }
+    // Sort by each mesh's transformed local-bounds center, not merely the
+    // instance origin; imported models often have a non-zero local origin.
+    let object_depth = |index: usize| {
+        let object = &scene.objects[index];
+        let mut minimum = Vec3::new(f32::INFINITY, f32::INFINITY, f32::INFINITY);
+        let mut maximum = Vec3::new(f32::NEG_INFINITY, f32::NEG_INFINITY, f32::NEG_INFINITY);
+        for vertex in &object.mesh.vertices {
+            minimum = minimum.min(vertex.position);
+            maximum = maximum.max(vertex.position);
+        }
+        let local_center = minimum * 0.5 + maximum * 0.5;
+        camera
+            .camera_space(object.transform.transform_point(local_center))
+            .z
+    };
+    transparent.sort_by(|a, b| {
+        let depth_a = object_depth(*a);
+        let depth_b = object_depth(*b);
+        depth_b.total_cmp(&depth_a).then_with(|| a.cmp(b))
+    });
+    Ok((opaque, transparent))
+}
+
+#[allow(clippy::too_many_arguments)] // Explicit inputs keep scene, camera and target ownership visible.
+fn draw_object(
+    scene: &Scene3,
+    object: &MeshInstance3,
+    camera: Camera3,
+    aspect: f32,
+    width: u32,
+    height: u32,
+    rgba: &mut [u8],
+    depth: &mut [f32],
+) {
+    let (near, far) = camera.projection.clip_planes();
+    for triangle in object.mesh.indices.chunks_exact(3) {
+        let source = [
+            object.mesh.vertices[triangle[0] as usize],
+            object.mesh.vertices[triangle[1] as usize],
+            object.mesh.vertices[triangle[2] as usize],
+        ];
+        let world = source.map(|vertex| object.transform.transform_point(vertex.position));
+        if !world.iter().all(|p| p.is_finite()) {
+            continue;
+        }
+        let face_normal = (world[1] - world[0])
+            .cross(world[2] - world[0])
+            .normalized();
+        if face_normal == Vec3::ZERO {
+            continue;
+        }
+        let center = (world[0] + world[1] + world[2]) / 3.0;
+        // ViewW uses a right-handed camera with positive camera-space Z forward.
+        if !object.material.double_sided && face_normal.dot(camera.eye - center) <= 0.0 {
+            continue;
+        }
+        let mut polygon = Vec::with_capacity(5);
+        for (index, vertex) in source.into_iter().enumerate() {
+            let normal = if vertex.normal == Vec3::ZERO {
+                face_normal
+            } else {
+                object.transform.transform_normal(vertex.normal)
+            };
+            polygon.push(ClipVertex {
+                view: camera.camera_space(world[index]),
+                world: world[index],
+                normal,
+                uv: vertex.uv,
+            });
+        }
+        polygon = clip_plane(&polygon, near, true);
+        if polygon.len() < 3 {
+            continue;
+        }
+        polygon = clip_plane(&polygon, far, false);
+        if polygon.len() < 3 {
+            continue;
+        }
+        for i in 1..polygon.len() - 1 {
+            let Some(a) = project(polygon[0], camera, aspect, width, height) else {
+                continue;
+            };
+            let Some(b) = project(polygon[i], camera, aspect, width, height) else {
+                continue;
+            };
+            let Some(c) = project(polygon[i + 1], camera, aspect, width, height) else {
+                continue;
+            };
+            raster_triangle(scene, object, camera, [a, b, c], width, height, rgba, depth);
+        }
+    }
+}
+
+fn clip_plane(poly: &[ClipVertex], plane: f32, keep_greater: bool) -> Vec<ClipVertex> {
+    if poly.is_empty() {
+        return Vec::new();
+    }
+    let inside = |z: f32| if keep_greater { z >= plane } else { z <= plane };
+    let mut result = Vec::with_capacity(poly.len() + 1);
+    let mut previous = *poly.last().expect("non-empty polygon checked");
+    let mut previous_inside = inside(previous.view.z);
+    for current in poly.iter().copied() {
+        let current_inside = inside(current.view.z);
+        if current_inside != previous_inside {
+            let denominator = current.view.z - previous.view.z;
+            if denominator.abs() > 1.0e-8 {
+                let t = ((plane - previous.view.z) / denominator).clamp(0.0, 1.0);
+                result.push(previous.lerp(current, t));
+            }
+        }
+        if current_inside {
+            result.push(current);
+        }
+        previous = current;
+        previous_inside = current_inside;
+    }
+    result
+}
+
+fn project(
+    vertex: ClipVertex,
+    camera: Camera3,
+    aspect: f32,
+    width: u32,
+    height: u32,
+) -> Option<ScreenVertex> {
+    let z = vertex.view.z;
+    if !z.is_finite() || z <= 0.0 {
+        return None;
+    }
+    let (nx, ny) = match camera.projection {
+        crate::Projection3::Perspective {
+            vertical_fov_radians,
+            ..
+        } => {
+            let f = 1.0 / (vertical_fov_radians * 0.5).tan();
+            (vertex.view.x * f / (z * aspect), vertex.view.y * f / z)
+        }
+        crate::Projection3::Orthographic { vertical_size, .. } => (
+            vertex.view.x * 2.0 / (vertical_size * aspect),
+            vertex.view.y * 2.0 / vertical_size,
+        ),
+    };
+    let sx = (nx * 0.5 + 0.5) * width as f32;
+    let sy = (0.5 - ny * 0.5) * height as f32;
+    (sx.is_finite() && sy.is_finite()).then_some(ScreenVertex {
+        x: sx,
+        y: sy,
+        z,
+        inv_z: 1.0 / z,
+        world: vertex.world,
+        normal: vertex.normal,
+        uv: vertex.uv,
+    })
+}
+
+fn edge(a: &ScreenVertex, b: &ScreenVertex, x: f32, y: f32) -> f32 {
+    (x - a.x) * (b.y - a.y) - (y - a.y) * (b.x - a.x)
+}
+
+#[allow(clippy::too_many_arguments)] // The raster kernel mutates two disjoint caller-owned target buffers.
+fn raster_triangle(
+    scene: &Scene3,
+    object: &MeshInstance3,
+    camera: Camera3,
+    vertices: [ScreenVertex; 3],
+    width: u32,
+    height: u32,
+    rgba: &mut [u8],
+    depth: &mut [f32],
+) {
+    let [a, b, c] = vertices;
+    let area = edge(&a, &b, c.x, c.y);
+    if !area.is_finite() || area.abs() < 1.0e-7 {
+        return;
+    }
+    let min_x = a.x.min(b.x).min(c.x).floor().max(0.0) as i32;
+    let max_x = a.x.max(b.x).max(c.x).ceil().min(width as f32 - 1.0) as i32;
+    let min_y = a.y.min(b.y).min(c.y).floor().max(0.0) as i32;
+    let max_y = a.y.max(b.y).max(c.y).ceil().min(height as f32 - 1.0) as i32;
+    if min_x > max_x || min_y > max_y {
+        return;
+    }
+    let perspective = matches!(camera.projection, crate::Projection3::Perspective { .. });
+    for y in min_y..=max_y {
+        for x in min_x..=max_x {
+            let px = x as f32 + 0.5;
+            let py = y as f32 + 0.5;
+            let w0 = edge(&b, &c, px, py) / area;
+            let w1 = edge(&c, &a, px, py) / area;
+            let w2 = edge(&a, &b, px, py) / area;
+            if w0 < -1.0e-6 || w1 < -1.0e-6 || w2 < -1.0e-6 {
+                continue;
+            }
+            let index = y as usize * width as usize + x as usize;
+            let reciprocal_depth = if perspective {
+                w0 * a.inv_z + w1 * b.inv_z + w2 * c.inv_z
+            } else {
+                0.0
+            };
+            let z = if perspective {
+                if reciprocal_depth <= 0.0 {
+                    continue;
+                }
+                1.0 / reciprocal_depth
+            } else {
+                w0 * a.z + w1 * b.z + w2 * c.z
+            };
+            if !z.is_finite() || z >= depth[index] {
+                continue;
+            }
+            let (p0, p1, p2) = if perspective {
+                (
+                    w0 * a.inv_z / reciprocal_depth,
+                    w1 * b.inv_z / reciprocal_depth,
+                    w2 * c.inv_z / reciprocal_depth,
+                )
+            } else {
+                (w0, w1, w2)
+            };
+            let world = a.world * p0 + b.world * p1 + c.world * p2;
+            let mut normal = (a.normal * p0 + b.normal * p1 + c.normal * p2).normalized();
+            if normal == Vec3::ZERO {
+                normal = (b.world - a.world).cross(c.world - a.world).normalized();
+            }
+            let uv = a.uv * p0 + b.uv * p1 + c.uv * p2;
+            let mut albedo = color_to_linear(object.material.albedo);
+            if let Some(texture) = &object.material.texture {
+                let texel = sample_texture(
+                    texture,
+                    uv,
+                    object.material.texture_filter,
+                    object.material.address_mode,
+                );
+                albedo.0 *= texel.0;
+                albedo.1 *= texel.1;
+                albedo.2 *= texel.2;
+                albedo.3 *= texel.3;
+            }
+            let shaded = shade(scene, object, camera, world, normal, albedo);
+            let destination = &mut rgba[index * 4..index * 4 + 4];
+            blend_pixel(destination, shaded);
+            // Opaque depth writes are exact. For translucent primitives this is
+            // deliberately the simple painter path; see parity notes for limits.
+            if shaded[3] >= 0.999 {
+                depth[index] = z;
+            }
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct LinearColor(f32, f32, f32, f32);
+fn channel_to_linear(channel: u8) -> f32 {
+    let c = f32::from(channel) / 255.0;
+    if c <= 0.04045 {
+        c / 12.92
+    } else {
+        ((c + 0.055) / 1.055).powf(2.4)
+    }
+}
+fn linear_to_channel(channel: f32) -> u8 {
+    let c = if channel.is_finite() {
+        channel.clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    let srgb = if c <= 0.0031308 {
+        c * 12.92
+    } else {
+        1.055 * c.powf(1.0 / 2.4) - 0.055
+    };
+    (srgb * 255.0 + 0.5).floor().clamp(0.0, 255.0) as u8
+}
+fn color_to_linear(color: Color) -> LinearColor {
+    let r = channel_to_linear(color.r);
+    let g = channel_to_linear(color.g);
+    let b = channel_to_linear(color.b);
+    let matrix = color.space.to_linear_srgb();
+    LinearColor(
+        matrix[0][0] * r + matrix[0][1] * g + matrix[0][2] * b,
+        matrix[1][0] * r + matrix[1][1] * g + matrix[1][2] * b,
+        matrix[2][0] * r + matrix[2][1] * g + matrix[2][2] * b,
+        f32::from(color.a) / 255.0,
+    )
+}
+fn color_to_rgba8(color: Color) -> [u8; 4] {
+    let linear = color_to_linear(color);
+    [
+        linear_to_channel(linear.0),
+        linear_to_channel(linear.1),
+        linear_to_channel(linear.2),
+        color.a,
+    ]
+}
+fn sample_texture(
+    image: &Image,
+    uv: Vec2,
+    filter: TextureFilter,
+    address: TextureAddressMode,
+) -> LinearColor {
+    let width = image.width() as usize;
+    let height = image.height() as usize;
+    if width == 0 || height == 0 {
+        return LinearColor(1.0, 1.0, 1.0, 1.0);
+    }
+    let bytes = image.pixels();
+    let coord = |value: f32| match address {
+        TextureAddressMode::Repeat => value.rem_euclid(1.0),
+        TextureAddressMode::Clamp => value.clamp(0.0, 1.0),
+    };
+    let read = |x: isize, y: isize| -> LinearColor {
+        let address_index = |index: isize, size: usize| -> usize {
+            match address {
+                TextureAddressMode::Repeat => index.rem_euclid(size as isize) as usize,
+                TextureAddressMode::Clamp => index.clamp(0, size as isize - 1) as usize,
+            }
+        };
+        let x = address_index(x, width);
+        let y = address_index(y, height);
+        let offset = (y * width + x) * 4;
+        if offset + 3 >= bytes.len() {
+            return LinearColor(1.0, 1.0, 1.0, 1.0);
+        }
+        LinearColor(
+            channel_to_linear(bytes[offset]),
+            channel_to_linear(bytes[offset + 1]),
+            channel_to_linear(bytes[offset + 2]),
+            f32::from(bytes[offset + 3]) / 255.0,
+        )
+    };
+    let u = coord(uv.x);
+    // Images store the first row at the top, whereas mesh V commonly grows up.
+    let v = coord(1.0 - uv.y);
+    match filter {
+        TextureFilter::Nearest => {
+            let x = (u * width as f32).floor() as isize;
+            let y = (v * height as f32).floor() as isize;
+            read(x, y)
+        }
+        TextureFilter::Bilinear => {
+            let (fx, fy) = match address {
+                TextureAddressMode::Repeat => (u * width as f32 - 0.5, v * height as f32 - 0.5),
+                TextureAddressMode::Clamp => (
+                    u * width.saturating_sub(1) as f32,
+                    v * height.saturating_sub(1) as f32,
+                ),
+            };
+            let x0 = fx.floor() as isize;
+            let y0 = fy.floor() as isize;
+            let tx = fx - fx.floor();
+            let ty = fy - fy.floor();
+            let top_left = read(x0, y0);
+            let top_right = read(x0 + 1, y0);
+            let bottom_left = read(x0, y0 + 1);
+            let bottom_right = read(x0 + 1, y0 + 1);
+            let mix = |a: f32, b: f32, t: f32| a + (b - a) * t;
+            let channel = |a: f32, b: f32, c: f32, d: f32| mix(mix(a, b, tx), mix(c, d, tx), ty);
+            LinearColor(
+                channel(top_left.0, top_right.0, bottom_left.0, bottom_right.0),
+                channel(top_left.1, top_right.1, bottom_left.1, bottom_right.1),
+                channel(top_left.2, top_right.2, bottom_left.2, bottom_right.2),
+                channel(top_left.3, top_right.3, bottom_left.3, bottom_right.3),
+            )
+        }
+    }
+}
+
+fn color_rgb(color: Color) -> Vec3 {
+    let linear = color_to_linear(color);
+    Vec3::new(linear.0, linear.1, linear.2)
+}
+fn shade(
+    scene: &Scene3,
+    object: &MeshInstance3,
+    camera: Camera3,
+    position: Vec3,
+    normal: Vec3,
+    albedo: LinearColor,
+) -> [f32; 4] {
+    let mut rgb = Vec3::new(albedo.0, albedo.1, albedo.2);
+    let alpha = albedo.3;
+    if object.material.model != ShadingModel::Unlit {
+        let view = (camera.eye - position).normalized();
+        let mut illumination = Vec3::ZERO;
+        let mut specular = Vec3::ZERO;
+        for light in &scene.lights {
+            match *light {
+                Light3::Ambient { color, intensity } => {
+                    illumination = illumination + color_rgb(color) * intensity.max(0.0);
+                }
+                Light3::Directional {
+                    direction,
+                    color,
+                    intensity,
+                } => {
+                    let to_light = (-direction).normalized();
+                    accumulate_light(
+                        &mut illumination,
+                        &mut specular,
+                        &object.material,
+                        albedo,
+                        normal,
+                        view,
+                        to_light,
+                        color_rgb(color),
+                        intensity.max(0.0),
+                        1.0,
+                    );
+                }
+                Light3::Point {
+                    position: light_position,
+                    color,
+                    intensity,
+                    range,
+                } => {
+                    let delta = light_position - position;
+                    let distance = delta.length();
+                    let attenuation = range_attenuation(distance, range);
+                    accumulate_light(
+                        &mut illumination,
+                        &mut specular,
+                        &object.material,
+                        albedo,
+                        normal,
+                        view,
+                        delta.normalized(),
+                        color_rgb(color),
+                        intensity.max(0.0),
+                        attenuation,
+                    );
+                }
+                Light3::Spot {
+                    position: light_position,
+                    direction,
+                    inner_angle,
+                    outer_angle,
+                    color,
+                    intensity,
+                    range,
+                } => {
+                    let delta = light_position - position;
+                    let distance = delta.length();
+                    let toward_surface = (-delta).normalized();
+                    let cosine = direction.normalized().dot(toward_surface);
+                    let inner = inner_angle.cos();
+                    let outer = outer_angle.cos();
+                    let cone = if (inner - outer).abs() < 1.0e-6 {
+                        if cosine >= inner {
+                            1.0
+                        } else {
+                            0.0
+                        }
+                    } else {
+                        ((cosine - outer) / (inner - outer)).clamp(0.0, 1.0)
+                    };
+                    let attenuation = range_attenuation(distance, range) * cone;
+                    accumulate_light(
+                        &mut illumination,
+                        &mut specular,
+                        &object.material,
+                        albedo,
+                        normal,
+                        view,
+                        delta.normalized(),
+                        color_rgb(color),
+                        intensity.max(0.0),
+                        attenuation,
+                    );
+                }
+            }
+        }
+        rgb = match object.material.model {
+            ShadingModel::Unlit => rgb,
+            ShadingModel::Lambert => rgb.component_mul(illumination),
+            ShadingModel::BlinnPhong => rgb.component_mul(illumination) + specular,
+            ShadingModel::Pbr => {
+                let metallic = object.material.metallic.clamp(0.0, 1.0);
+                let diffuse = rgb.component_mul(illumination) * (1.0 - metallic);
+                diffuse + specular
+            }
+        };
+    }
+    [rgb.x, rgb.y, rgb.z, alpha]
+}
+
+fn range_attenuation(distance: f32, range: f32) -> f32 {
+    if !range.is_finite() || range <= 0.0 {
+        return 0.0;
+    }
+    let normalized = (distance / range).clamp(0.0, 1.0);
+    let edge = (1.0 - normalized * normalized).max(0.0);
+    edge * edge / (1.0 + distance * distance * 0.05)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn accumulate_light(
+    diffuse_accumulator: &mut Vec3,
+    specular_accumulator: &mut Vec3,
+    material: &Material3,
+    albedo: LinearColor,
+    normal: Vec3,
+    view: Vec3,
+    to_light: Vec3,
+    light_color: Vec3,
+    intensity: f32,
+    attenuation: f32,
+) {
+    if attenuation <= 0.0 || intensity <= 0.0 {
+        return;
+    }
+    let ndotl = normal.dot(to_light).max(0.0);
+    if ndotl <= 0.0 {
+        return;
+    }
+    let radiance = light_color * (intensity * attenuation);
+    *diffuse_accumulator = *diffuse_accumulator + radiance * ndotl;
+    if matches!(material.model, ShadingModel::BlinnPhong | ShadingModel::Pbr) {
+        let half_vector = (to_light + view).normalized();
+        let exponent = if material.model == ShadingModel::BlinnPhong {
+            32.0
+        } else {
+            (2.0 / material.roughness.clamp(0.04, 1.0).powi(2) - 2.0).max(1.0)
+        };
+        let highlight = normal.dot(half_vector).max(0.0).powf(exponent) * ndotl;
+        let metallic = material.metallic.clamp(0.0, 1.0);
+        let base = Vec3::new(albedo.0, albedo.1, albedo.2);
+        let f0 = Vec3::new(0.04, 0.04, 0.04).lerp(base, metallic);
+        *specular_accumulator = *specular_accumulator + f0.component_mul(radiance) * highlight;
+    }
+}
+
+fn blend_pixel(destination: &mut [u8], source: [f32; 4]) {
+    let src_alpha = source[3].clamp(0.0, 1.0);
+    if src_alpha <= 0.0 {
+        return;
+    }
+    if src_alpha >= 0.999 {
+        destination[0] = linear_to_channel(source[0]);
+        destination[1] = linear_to_channel(source[1]);
+        destination[2] = linear_to_channel(source[2]);
+        destination[3] = 255;
+        return;
+    }
+    let dst_alpha = f32::from(destination[3]) / 255.0;
+    let out_alpha = src_alpha + dst_alpha * (1.0 - src_alpha);
+    if out_alpha <= 1.0e-6 {
+        destination.fill(0);
+        return;
+    }
+    let dst = [
+        channel_to_linear(destination[0]),
+        channel_to_linear(destination[1]),
+        channel_to_linear(destination[2]),
+    ];
+    for (channel, output) in destination.iter_mut().take(3).enumerate() {
+        let out = (source[channel] * src_alpha + dst[channel] * dst_alpha * (1.0 - src_alpha))
+            / out_alpha;
+        *output = linear_to_channel(out);
+    }
+    destination[3] = (out_alpha * 255.0 + 0.5).floor().clamp(0.0, 255.0) as u8;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{Material3, Mesh3, MeshInstance3, Projection3, Vec3};
+
+    #[test]
+    fn cube_produces_a_non_background_pixel() {
+        let camera = Camera3::look_at(
+            Vec3::new(0.0, 0.0, -3.0),
+            Vec3::ZERO,
+            Vec3::Y,
+            Projection3::perspective(1.0, 0.1, 100.0).unwrap(),
+        )
+        .unwrap();
+        let mut scene = Scene3::new();
+        scene.background = Color::rgba(0, 0, 0, 255);
+        scene.add(
+            MeshInstance3::new(
+                Mesh3::cube(),
+                Material3::new(Color::rgba(255, 0, 0, 255)).unlit(),
+            )
+            .with_transform(crate::Transform3::IDENTITY),
+        );
+        let image = render(&scene, camera, 64, 64).unwrap();
+        assert!(image
+            .pixels()
+            .chunks_exact(4)
+            .any(|p| p[0] > 200 && p[1] < 20));
+    }
+
+    #[test]
+    fn target_limits_and_invalid_dimensions_are_reported() {
+        let camera = Camera3::look_at(
+            Vec3::new(0.0, 0.0, -3.0),
+            Vec3::ZERO,
+            Vec3::Y,
