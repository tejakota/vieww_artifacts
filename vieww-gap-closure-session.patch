+++ b/vieww_base/ci/tools/stub-ar.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+# The archiver half of `stub-cc.sh`: makes whatever archive it is asked for,
+# empty, in either `ar` (`ar cq out.a ...`) or `lib.exe` (`-out:out.lib`)
+# style. Same purpose and the same limit — nothing built with it links.
+for a in "$@"; do
+	case "$a" in
+	-out:* | /OUT:* | /out:*) : >"${a#*:}"; exit 0 ;;
+	*.a | *.lib) : >"$a"; exit 0 ;;
+	esac
+done
+exit 0
diff --git a/vieww_base/ci/tools/stub-bin/xcrun b/vieww_base/ci/tools/stub-bin/xcrun
new file mode 100755
index 0000000..36cc318
--- /dev/null
+++ b/vieww_base/ci/tools/stub-bin/xcrun
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Stand-in `xcrun` for `ci/check/cross-check.sh` on a machine with no Xcode:
+# cc-rs asks it for an Apple SDK path before invoking the (stub) compiler.
+# Answers with an empty directory and a plausible version — enough for a
+# type-check, which never reads a header or links.
+for a in "$@"; do
+	case "$a" in
+	--show-sdk-path) echo /var/empty; exit 0 ;;
+	--show-sdk-version) echo 17.0; exit 0 ;;
+	--show-sdk-platform-path) echo /var/empty; exit 0 ;;
+	esac
+done
+exit 0
diff --git a/vieww_base/ci/tools/stub-cc.sh b/vieww_base/ci/tools/stub-cc.sh
new file mode 100755
index 0000000..a7e1c86
--- /dev/null
+++ b/vieww_base/ci/tools/stub-cc.sh
@@ -0,0 +1,23 @@
+#!/bin/sh
+# A C compiler that compiles nothing — for `ci/check/cross-check.sh` only.
+#
+# A cross type-check (`cargo check --target <foreign>`) never links, but a
+# build script that uses the `cc` crate still runs the target's C compiler,
+# and on a Linux machine there is no Apple or MSVC SDK for it to find. This
+# stands in: it writes an empty object wherever `-o` says and succeeds, so
+# the build script finishes and rustc gets to the Rust — which is the only
+# thing a type-check is about. Nothing built with it can link, by design.
+out=""
+while [ $# -gt 0 ]; do
+	case "$1" in
+	-o) out="$2"; shift ;;
+	-o*) out="${1#-o}" ;;
+	# cc-rs preprocesses a probe to learn the compiler family; answer clang.
+	-E) echo "clang"; exit 0 ;;
+	-Fo*) out="${1#-Fo}" ;;
+	--version | -v | -dumpversion) echo "stub-cc 1.0 (clang compatible)"; exit 0 ;;
+	esac
+	shift
+done
+[ -n "$out" ] && : >"$out"
+exit 0
