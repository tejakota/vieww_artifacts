+    #[test]
+    fn constant_tempo_round_trips() {
+        let m = TempoMap::constant(120.0);
+        assert!((m.seconds_at(8.0) - 4.0).abs() < 1e-12);
+        assert!((m.beat_at(4.0) - 8.0).abs() < 1e-12);
+    }
