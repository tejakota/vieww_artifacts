From bbf0b5cff0f4229138cf48d1c90bba475c6ddb47 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 17:21:48 +0530
Subject: [PATCH] winit: a window draws its first frame even if the compositor
 calls it hidden
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ci/check/checks.sh's wait_loop test hung (20 s deadline, SIGABRT) in its
idle and wake scenarios on a GNOME/Wayland hybrid-GPU laptop, on the
first run after a long build, and passed on every warm run. The failing
trace showed the idle scenario's window never drawing a single frame —
none before the wake, none after.

The loop declines to draw a window whose lifecycle is Hidden, which is
right, and it applied that to a window that had never presented. On
Wayland a toplevel is not on screen until its first buffer is
committed; GNOME's focus-stealing prevention can open a window without
an activation token (anything started from a terminal) below the
focused one and report it occluded first. With its first frame refused
the window had no buffer, so nothing could ever un-hide it.

Lifecycle::may_draw(presented) is should_draw() plus that one exception
(a window with a surface that has never presented may draw), used by
both draw decisions — about_to_wait's and RedrawRequested's — through
WindowState::may_draw; `presented` is set on the first successful
present. After it, hidden windows are left alone exactly as before.

The mechanism is inferred from the trace, not yet observed: the failure
did not recur in six traced runs on the affected machine. Unit test for
the rule; vieww-platform-winit 145/145 and wait_loop 5/5 three times
under Xvfb + lavapipe; clippy, fmt and docs clean.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Nd3Ehrf9ktGu82K38kGEjH
---
 .../crates/vieww-platform-winit/src/app.rs    | 30 +++++++++++++-
 .../vieww-platform-winit/src/lifecycle.rs     | 40 +++++++++++++++++++
 2 files changed, 68 insertions(+), 2 deletions(-)

diff --git a/vieww_base/crates/vieww-platform-winit/src/app.rs b/vieww_base/crates/vieww-platform-winit/src/app.rs
index 85a51a7..44703bc 100644
--- a/vieww_base/crates/vieww-platform-winit/src/app.rs
+++ b/vieww_base/crates/vieww-platform-winit/src/app.rs
@@ -1086,6 +1086,9 @@ struct WindowState {
     inset_watch: InsetWatch,
     log: FrameLog,
     lifecycle: Lifecycle,
+    /// Whether this window has put a frame on screen yet. See
+    /// [`WindowState::may_draw`].
+    presented: bool,
     /// What this window clears to.
     ///
     /// Per window rather than read from the config, because [`WindowSpec`](vieww_render::window::WindowSpec) lets a
@@ -1273,6 +1276,27 @@ impl WindowState {
         }
     }
 
+    /// Whether the loop may draw this window now: when it is visible, and —
+    /// whatever the compositor says about visibility — once, if it has never
+    /// put a frame on screen.
+    ///
+    /// # Why the first frame is drawn even when "hidden"
+    ///
+    /// On Wayland a toplevel does not exist on screen until its first buffer
+    /// is committed. GNOME's focus-stealing prevention can open a window that
+    /// has no activation token (anything started from a terminal, a test
+    /// harness included) *below* the focused one, and report it occluded
+    /// before it has drawn anything. Declining to draw a hidden window is
+    /// right; declining its *first* frame left it with no buffer, so nothing
+    /// could ever un-hide it: no `Occluded(false)`, no frame, for ever. That
+    /// is the shape of `tests/wait_loop.rs`' idle scenario hanging with zero
+    /// frames on a GNOME/Wayland laptop. One frame into a hidden surface is
+    /// harmless (presenting to it is legal — see [`Lifecycle::has_surface`]);
+    /// after it, hidden windows are left alone as before.
+    fn may_draw(&self) -> bool {
+        self.lifecycle.may_draw(self.presented)
+    }
+
     /// Produce a frame and put it on the screen.
     fn draw(&mut self, shared: &mut Shared) {
         // Before the hooks and before the build, for the same reason
@@ -1420,6 +1444,7 @@ impl WindowState {
                 };
                 self.log
                     .record(stats, elapsed, pixels, Instant::now(), drawn_on_gpu);
+                self.presented = true;
                 if presented_directly {
                     self.log.note_direct_present();
                 }
@@ -2045,6 +2070,7 @@ impl<F: FnOnce(&mut FrameDriver)> Runner<F> {
             inset_watch: InsetWatch::new(),
             log,
             lifecycle: Lifecycle::default(),
+            presented: false,
             background,
             display: None,
         };
@@ -2587,7 +2613,7 @@ impl<F: FnOnce(&mut FrameDriver)> ApplicationHandler<UserEvent> for Runner<F> {
             // `collapsible_match` is denied in this workspace. A window that may
             // not draw falls through to the catch-all below and does nothing,
             // which is what the `if` did.
-            WindowEvent::RedrawRequested if self.windows[index].lifecycle.should_draw() => {
+            WindowEvent::RedrawRequested if self.windows[index].may_draw() => {
                 let (windows, shared) = (&mut self.windows, &mut self.shared);
                 windows[index].draw(shared);
             }
@@ -2782,7 +2808,7 @@ impl<F: FnOnce(&mut FrameDriver)> ApplicationHandler<UserEvent> for Runner<F> {
             let window = &mut self.windows[index];
             let pending = window.driver.needs_frame();
             let requested = window.scheduler.is_frame_requested();
-            let can_draw = window.lifecycle.should_draw();
+            let can_draw = window.may_draw();
             let key = window.key;
 
             let now = self.shared.now();
diff --git a/vieww_base/crates/vieww-platform-winit/src/lifecycle.rs b/vieww_base/crates/vieww-platform-winit/src/lifecycle.rs
index ee78c9b..74d6f97 100644
--- a/vieww_base/crates/vieww-platform-winit/src/lifecycle.rs
+++ b/vieww_base/crates/vieww-platform-winit/src/lifecycle.rs
@@ -72,6 +72,20 @@ impl Lifecycle {
         self.is_visible()
     }
 
+    /// [`should_draw`](Self::should_draw), plus one exception: a window that
+    /// has a surface but has **never presented** may draw even while hidden.
+    ///
+    /// On Wayland a toplevel is not on screen until its first buffer is
+    /// committed, and a compositor can report a new window occluded before
+    /// that (GNOME opens a window without an activation token below the
+    /// focused one). Refusing that first frame leaves the window with no
+    /// buffer and nothing that could ever un-hide it. See
+    /// `WindowState::may_draw` in `app.rs` for the hang this caused.
+    #[must_use]
+    pub const fn may_draw(self, presented: bool) -> bool {
+        self.should_draw() || (!presented && self.has_surface())
+    }
+
     /// The state after the platform reports a resume.
     #[must_use]
     pub const fn resumed(self) -> Self {
@@ -174,6 +188,32 @@ impl fmt::Display for Lifecycle {
 mod tests {
     use super::*;
 
+    /// The first frame is drawn even when the window starts out hidden, and
+    /// only the first: after a present, hidden means hidden again. Without a
+    /// surface there is nothing to draw into, presented or not.
+    #[test]
+    fn a_hidden_window_still_draws_its_first_frame_and_only_that() {
+        let hidden = Lifecycle::Resumed.occluded(true);
+        assert_eq!(hidden, Lifecycle::Hidden);
+        assert!(!hidden.should_draw());
+        assert!(
+            hidden.may_draw(false),
+            "the first frame must not be refused"
+        );
+        assert!(
+            !hidden.may_draw(true),
+            "after it, a hidden window is left alone"
+        );
+
+        assert!(Lifecycle::Resumed.may_draw(true));
+        assert!(Lifecycle::Inactive.may_draw(true));
+
+        for no_surface in [Lifecycle::Detached, Lifecycle::Paused] {
+            assert!(!no_surface.may_draw(false));
+            assert!(!no_surface.may_draw(true));
+        }
+    }
+
     #[test]
     fn nothing_is_drawn_before_the_first_resume() {
         let state = Lifecycle::default();
-- 
2.43.0

