From d050caef840008365b70a8c7813ad13a1c0cdbd7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 19:10:41 +0530
Subject: [PATCH] wait_loop: a failing scenario prints its own trace
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The idle scenario still times out inside ci/check/checks.sh on a
GNOME/Wayland laptop — now with the first-frame fix in — and passes in
every run made by hand (eight so far, traced and untraced). A failure
that only happens unattended has to bring its own evidence.

- The harness runs every scenario child with VIEWW_TRACE_FRAMES and
  VIEWW_WAIT_LOOP_TRACE set and captures its stderr. On success it
  prints what it printed before (the child's own `wait_loop:` notes);
  on failure, the last 80 lines: each window event, each sleep
  decision with `should_draw`, the wake, the frames. Checked by forcing
  a hang: the failure output tells the whole story.
- The event-loop trace names Occluded with its value —
  `event Occluded(true)` — since that bit decides whether a window may
  draw at all.

Working theory, to be confirmed by the next failing trace: GNOME's
focus-stealing prevention opens the unattended test window below the
terminal and reports it hidden, so after its first frame (drawn since
5e534e8) the loop correctly declines to draw it, and the scenario's
post-wake frame never comes. If so, the trace will read
`Occluded(true)` and `should_draw=false`, and the fix belongs in the
test, not the framework.

vieww-platform-winit 145/145, wait_loop 5/5 three times under Xvfb;
clippy, fmt and docs clean.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Nd3Ehrf9ktGu82K38kGEjH
---
 .../crates/vieww-platform-winit/src/app.rs    |  8 +++-
 .../vieww-platform-winit/tests/wait_loop.rs   | 44 +++++++++++++++++--
 2 files changed, 47 insertions(+), 5 deletions(-)

diff --git a/vieww_base/crates/vieww-platform-winit/src/app.rs b/vieww_base/crates/vieww-platform-winit/src/app.rs
index 44703bc..e7772a6 100644
--- a/vieww_base/crates/vieww-platform-winit/src/app.rs
+++ b/vieww_base/crates/vieww-platform-winit/src/app.rs
@@ -2466,7 +2466,13 @@ impl<F: FnOnce(&mut FrameDriver)> ApplicationHandler<UserEvent> for Runner<F> {
     ) {
         let now = self.shared.now();
 
-        trace_line(now, format_args!("event {}", event_name(&event)));
+        // `Occluded` carries the one bit that decides whether this window may
+        // draw at all, so it is the event the trace names with its payload.
+        if let WindowEvent::Occluded(hidden) = event {
+            trace_line(now, format_args!("event Occluded({hidden})"));
+        } else {
+            trace_line(now, format_args!("event {}", event_name(&event)));
+        }
 
         let Some(index) = self.windows.iter().position(|w| w.id == window_id) else {
             // An event for a window that has already gone. Ordinary during a
diff --git a/vieww_base/crates/vieww-platform-winit/tests/wait_loop.rs b/vieww_base/crates/vieww-platform-winit/tests/wait_loop.rs
index 680f51f..591def7 100644
--- a/vieww_base/crates/vieww-platform-winit/tests/wait_loop.rs
+++ b/vieww_base/crates/vieww-platform-winit/tests/wait_loop.rs
@@ -694,6 +694,9 @@ fn a_gpu_planned_frame_presents_to_a_real_window() {
 // see that module's own doc comment. Re-add a scenario here once device
 // sharing exists to measure.
 
+/// How many lines of a failed scenario's trace to print.
+const TRACE_TAIL: usize = 80;
+
 /// The scenarios, by the name a child process is given.
 ///
 /// One table rather than three `if` arms so that the parent's list and the
@@ -742,14 +745,47 @@ fn main() {
     let mut failed = Vec::new();
     for (name, _) in SCENARIOS {
         eprintln!("wait_loop: {name}");
-        let status = std::process::Command::new(&binary)
+        // **Every child runs traced; the trace is printed only if it fails.**
+        //
+        // These scenarios have failed only where nobody was watching: the
+        // idle scenario timed out inside `ci/check/checks.sh` on a GNOME/
+        // Wayland laptop, several times, and passed in every run made by hand
+        // to investigate it — traced or not. A failure that cannot be
+        // reproduced on demand has to bring its own evidence, so both traces
+        // (this file's and the event loop's `VIEWW_TRACE_FRAMES`, which logs
+        // each window event — `Occluded`, `Resized`, `RedrawRequested` — and
+        // each sleep decision) are captured on every run and the last lines
+        // are shown when a scenario fails. A passing run prints what it
+        // always printed. The event-loop trace is deduplicated by design
+        // (see `trace_line` in `src/app.rs`), so it does not change timing.
+        let output = std::process::Command::new(&binary)
             .arg(name)
-            .status()
+            .env("VIEWW_TRACE_FRAMES", "1")
+            .env("VIEWW_WAIT_LOOP_TRACE", "1")
+            .stderr(std::process::Stdio::piped())
+            .output()
             .unwrap_or_else(|error| panic!("could not re-execute {binary:?}: {error}"));
-        if status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        if output.status.success() {
+            for line in stderr
+                .lines()
+                .filter(|l| l.starts_with("wait_loop: ") && !l.starts_with("wait_loop: pass"))
+            {
+                eprintln!("{line}");
+            }
             eprintln!("wait_loop: {name} ok");
         } else {
-            eprintln!("wait_loop: {name} FAILED ({status})");
+            let lines: Vec<&str> = stderr.lines().collect();
+            let tail = &lines[lines.len().saturating_sub(TRACE_TAIL)..];
+            eprintln!(
+                "wait_loop: {name} FAILED ({}) — last {} of {} trace lines:",
+                output.status,
+                tail.len(),
+                lines.len()
+            );
+            for line in tail {
+                eprintln!("    | {line}");
+            }
             failed.push(*name);
         }
     }
