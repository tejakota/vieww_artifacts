From 2494747ac26cc160e5b0c1fe2f1b8a55f45f6456 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 12:57:22 +0530
Subject: [PATCH] vieww-paint: declare lcd_subpixel's native requirement
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

tests/lcd_subpixel.rs imports vieww_paint::native but had no [[test]]
entry with required-features = ["native"], so a plain
`cargo test -p vieww-paint` failed to compile (E0432) — the exact failure
the Cargo.toml comment says the other four entries were added to prevent;
this file arrived after them. Now skipped without the feature, run with
it: 163/163 without native, 272/272 with.

Found by the session that applied the 2026-10-12 patch.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Nd3Ehrf9ktGu82K38kGEjH
---
 vieww_base/crates/vieww-paint/Cargo.toml | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/vieww_base/crates/vieww-paint/Cargo.toml b/vieww_base/crates/vieww-paint/Cargo.toml
index 98b6693..0c5919c 100644
--- a/vieww_base/crates/vieww-paint/Cargo.toml
+++ b/vieww_base/crates/vieww-paint/Cargo.toml
@@ -51,7 +51,7 @@ gif = "0.14"
 default = []
 native = ["dep:ttf-parser", "dep:png", "dep:skrifa"]
 
-# **The four test targets that need the renderer, and the examples that draw
+# **The five test targets that need the renderer, and the examples that draw
 # with it, declared as needing it.**
 #
 # Without these, `cargo test -p vieww-paint` — the command this crate's own
@@ -80,6 +80,10 @@ required-features = ["native"]
 name = "linear_light_pipeline"
 required-features = ["native"]
 
+[[test]]
+name = "lcd_subpixel"
+required-features = ["native"]
+
 [[example]]
 name = "native_showcase"
 required-features = ["native"]
-- 
2.43.0

