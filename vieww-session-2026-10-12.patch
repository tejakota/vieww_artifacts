+                cmd,
+                staging,
+                image,
+                vk::ImageLayout::TRANSFER_DST_OPTIMAL,
+                &regions,
+            );
+            transition(
+                &self.device,
+                cmd,
+                image,
+                vk::ImageLayout::TRANSFER_DST_OPTIMAL,
+                vk::ImageLayout::SHADER_READ_ONLY_OPTIMAL,
+            );
+        }
+        self.submit_and_wait(None)?;
+        self.texture_mut(Slot::Masks).version = version;
+        self.mask_upload_bytes = needed;
+        Ok(())
+    }
